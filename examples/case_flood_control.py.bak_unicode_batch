#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
工程案例2: 防洪调度优化

场景：水库泄洪对下游渠道的影响分析
目标：对比不同泄洪方案，选择最优策略

包含：
1. 方案A: 快速泄洪（大流量短时间）
2. 方案B: 缓慢泄洪（小流量长时间）
3. 方案C: 渐变泄洪（逐步增加）

分析：
- 下游最大水深
- 洪峰到达时间
- 风险评估
- 推荐方案

作者: HydroClaude Team
日期: 2025-10-27
"""

import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from solvers.godunov_fvm_solver import GodunvFVMSolver
from utils.canal_utils import compute_steady_uniform_flow
from utils.hydraulic_tools import HydraulicTools
import numpy as np
import matplotlib.pyplot as plt

print("=" * 80)
print("工程案例2: 防洪调度优化分析")
print("=" * 80)

# 渠道参数
B = 15.0  # 宽度15m
L = 5000.0  # 长度5km
n_cells = 200  # 网格数
n = 0.025  # 糙率
S0 = 0.0008  # 底坡

print(f"\n渠道参数:")
print(f"  宽度: {B} m")
print(f"  长度: {L/1000} km")
print(f"  底坡: {S0}")
print(f"  糙率: {n}")

# 初始流量（基流）
Q_base = 30.0
print(f"\n初始基流: {Q_base} m³/s")

# 三个泄洪方案
schemes = [
    {
        'name': '方案A: 快速泄洪',
        'description': '大流量短时间',
        'Q_peak': 120.0,
        't_duration': 1800.0,  # 30分钟
        'color': 'red'
    },
    {
        'name': '方案B: 缓慢泄洪',
        'description': '小流量长时间',
        'Q_peak': 80.0,
        't_duration': 3600.0,  # 60分钟
        'color': 'blue'
    },
    {
        'name': '方案C: 渐变泄洪',
        'description': '逐步增加流量',
        'Q_peak': 100.0,
        't_duration': 2700.0,  # 45分钟
        'color': 'green'
    }
]

print(f"\n泄洪方案对比:")
for i, scheme in enumerate(schemes, 1):
    print(f"\n{i}. {scheme['name']}")
    print(f"   {scheme['description']}")
    print(f"   峰值流量: {scheme['Q_peak']} m³/s")
    print(f"   持续时间: {scheme['t_duration']/60:.0f} 分钟")

# 运行每个方案
results = []

print(f"\n开始模拟各方案...")

for scheme in schemes:
    print(f"\n{'=' * 80}")
    print(f"模拟: {scheme['name']}")
    print(f"{'=' * 80}")
    
    # 创建求解器
    solver = GodunvFVMSolver(
        width=B, length=L, n_cells=n_cells,
        manning_n=n, slope=S0,
        cfl=0.5, order=1
    )
    
    # 初始化（基流）
    h_base = compute_steady_uniform_flow(Q_base, B, S0, n)
    h_init = np.ones(n_cells) * h_base
    Q_init = np.ones(n_cells) * Q_base
    
    bc_left = {'type': 'Q', 'value': Q_base}
    bc_right = {'type': 'h', 'value': h_base}
    
    solver.initialize(h_init, Q_init, bc_left, bc_right)
    
    # 模拟参数
    Q_peak = scheme['Q_peak']
    t_duration = scheme['t_duration']
    t_total = t_duration + 1800.0  # 再运行30分钟看恢复
    
    # 记录
    t_record = []
    Q_upstream = []
    h_max_record = []
    h_downstream = []
    mass_error_record = []
    
    t_sim = 0.0
    step_count = 0
    max_steps = 5000
    
    print(f"  总模拟时间: {t_total/60:.0f} 分钟")
    
    while t_sim < t_total and step_count < max_steps:
        # 确定当前流量（线性增长到峰值，然后线性降回基流）
        if t_sim < t_duration / 2:
            # 上升段
            Q_current = Q_base + (Q_peak - Q_base) * (t_sim / (t_duration / 2))
        elif t_sim < t_duration:
            # 下降段
            Q_current = Q_peak - (Q_peak - Q_base) * ((t_sim - t_duration / 2) / (t_duration / 2))
        else:
            # 恢复期
            Q_current = Q_base
        
        # 更新边界（保持兼容性）
        solver.bc_left = {'type': 'Q', 'value': Q_current}
        h_right = compute_steady_uniform_flow(Q_current, B, S0, n)
        solver.bc_right = {'type': 'h', 'value': h_right}
        
        # 推进
        solver.step()
        
        # 记录
        if step_count % 20 == 0:
            state = solver.get_state()
            t_record.append(state['t'])
            Q_upstream.append(Q_current)
            h_max_record.append(np.max(state['h']))
            h_downstream.append(state['h'][-1])
            mass_error_record.append(state['mass_error'])
        
        t_sim = solver.t
        step_count += 1
    
    # 分析结果
    print(f"\n  模拟完成:")
    print(f"    步数: {step_count}")
    print(f"    最大水深: {np.max(h_max_record):.3f} m")
    print(f"    洪峰到达时间: {t_record[np.argmax(h_max_record)]/60:.1f} 分钟")
    print(f"    质量误差: {mass_error_record[-1]:.2f}%")
    
    results.append({
        'scheme': scheme,
        't': np.array(t_record),
        'Q_up': np.array(Q_upstream),
        'h_max': np.array(h_max_record),
        'h_down': np.array(h_downstream),
        'mass_error': np.array(mass_error_record),
        'peak_h': np.max(h_max_record),
        'peak_time': t_record[np.argmax(h_max_record)]
    })

# 对比分析
print(f"\n" + "=" * 80)
print("方案对比分析")
print("=" * 80)

print(f"\n{'方案':<20} {'峰值水深(m)':<15} {'洪峰时间(min)':<18} {'质量误差(%)':<15}")
print("-" * 70)

for result in results:
    scheme_name = result['scheme']['name']
    peak_h = result['peak_h']
    peak_time = result['peak_time'] / 60
    final_error = result['mass_error'][-1]
    
    print(f"{scheme_name:<20} {peak_h:<15.3f} {peak_time:<18.1f} {final_error:<15.2f}")

# 风险评估
print(f"\n风险评估:")

h_safe = 4.0  # 假设安全水深4m
print(f"  安全水深阈值: {h_safe} m")

for result in results:
    scheme_name = result['scheme']['name']
    peak_h = result['peak_h']
    
    if peak_h > h_safe:
        risk = " 高风险"
        safety_margin = (peak_h - h_safe) / h_safe * 100
        print(f"  {scheme_name}: {risk} (超出{safety_margin:.1f}%)")
    elif peak_h > h_safe * 0.9:
        risk = "🟡 中等风险"
        safety_margin = (h_safe - peak_h) / h_safe * 100
        print(f"  {scheme_name}: {risk} (余量{safety_margin:.1f}%)")
    else:
        risk = " 低风险"
        safety_margin = (h_safe - peak_h) / h_safe * 100
        print(f"  {scheme_name}: {risk} (余量{safety_margin:.1f}%)")

# 推荐方案
print(f"\n推荐分析:")

# 找出最低峰值水深的方案
min_peak_idx = np.argmin([r['peak_h'] for r in results])
recommended = results[min_peak_idx]

print(f"\n推荐方案: {recommended['scheme']['name']}")
print(f"理由:")
print(f"  1. 峰值水深最低: {recommended['peak_h']:.3f} m")
print(f"  2. 风险最小")
print(f"  3. 数值稳定（质量误差{recommended['mass_error'][-1]:.2f}%）")

# 可视化
try:
    fig, axes = plt.subplots(2, 2, figsize=(15, 10))
    
    # 子图1: 上游流量过程
    ax1 = axes[0, 0]
    for result in results:
        ax1.plot(result['t']/60, result['Q_up'], 
                label=result['scheme']['name'],
                color=result['scheme']['color'], linewidth=2)
    ax1.set_xlabel('时间 (分钟)')
    ax1.set_ylabel('上游流量 (m³/s)')
    ax1.set_title('上游流量过程')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # 子图2: 最大水深变化
    ax2 = axes[0, 1]
    for result in results:
        ax2.plot(result['t']/60, result['h_max'], 
                label=result['scheme']['name'],
                color=result['scheme']['color'], linewidth=2)
    ax2.axhline(y=h_safe, color='red', linestyle='--', alpha=0.5, label='安全水深')
    ax2.set_xlabel('时间 (分钟)')
    ax2.set_ylabel('最大水深 (m)')
    ax2.set_title('下游最大水深变化')
    ax2.legend()
    ax2.grid(True, alpha=0.3)
    
    # 子图3: 下游水深变化
    ax3 = axes[1, 0]
    for result in results:
        ax3.plot(result['t']/60, result['h_down'], 
                label=result['scheme']['name'],
                color=result['scheme']['color'], linewidth=2)
    ax3.set_xlabel('时间 (分钟)')
    ax3.set_ylabel('下游水深 (m)')
    ax3.set_title('下游断面水深变化')
    ax3.legend()
    ax3.grid(True, alpha=0.3)
    
    # 子图4: 方案对比柱状图
    ax4 = axes[1, 1]
    scheme_names = [r['scheme']['name'].split(':')[0] for r in results]
    peak_hs = [r['peak_h'] for r in results]
    colors = [r['scheme']['color'] for r in results]
    
    bars = ax4.bar(range(len(scheme_names)), peak_hs, color=colors, alpha=0.7, edgecolor='black')
    ax4.axhline(y=h_safe, color='red', linestyle='--', linewidth=2, label='安全水深')
    ax4.set_xticks(range(len(scheme_names)))
    ax4.set_xticklabels(scheme_names)
    ax4.set_ylabel('峰值水深 (m)')
    ax4.set_title('方案峰值水深对比')
    ax4.legend()
    ax4.grid(True, alpha=0.3, axis='y')
    
    # 标注数值
    for i, (bar, val) in enumerate(zip(bars, peak_hs)):
        ax4.text(bar.get_x() + bar.get_width()/2, val + 0.1, 
                f'{val:.2f}m', ha='center', va='bottom', fontsize=10, fontweight='bold')
    
    plt.tight_layout()
    plt.savefig('/workspace/case_flood_control.png', dpi=150, bbox_inches='tight')
    print(f"\n 分析图表已保存: case_flood_control.png")
except Exception as e:
    print(f"\n️ 可视化失败: {str(e)}")

# 工程建议
print(f"\n" + "=" * 80)
print("工程建议")
print("=" * 80)

print(f"\n1. 调度策略:")
print(f"   • 优先采用{recommended['scheme']['name']}")
print(f"   • 峰值流量控制在{recommended['scheme']['Q_peak']} m³/s以内")
print(f"   • 持续时间约{recommended['scheme']['t_duration']/60:.0f}分钟")

print(f"\n2. 安全措施:")
print(f"   • 设置水深监测点（每500m一个）")
print(f"   • 水深超过{h_safe*0.8:.1f}m时预警")
print(f"   • 水深超过{h_safe:.1f}m时停止泄洪")

print(f"\n3. 应急预案:")
print(f"   • 准备备用泄洪通道")
print(f"   • 下游居民提前通知")
print(f"   • 24小时监测")

print(f"\n" + "=" * 80)
print(" 防洪调度分析完成！")
print("=" * 80)

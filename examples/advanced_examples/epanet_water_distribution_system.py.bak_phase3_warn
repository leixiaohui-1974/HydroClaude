def create_example_network():
    """创建示例供水管网"""
    print("=" * 60)
    print("创建示例供水管网")
    print("=" * 60)

    if not EPANET_AVAILABLE:
        print("\n警告: wntr未安装，使用模拟模式")
        return create_simulated_network()

    # 使用WNTR创建网络
    import wntr

    wn = wntr.network.WaterNetworkModel()

    # 添加水库
    wn.add_reservoir('R1', base_head=50, coordinates=(0, 100))

    # 添加节点
    nodes = [
        ('J1', 0.015, 45, (50, 100)),
        ('J2', 0.020, 40, (100, 100)),
        ('J3', 0.025, 35, (150, 100)),
        ('J4', 0.015, 42, (50, 50)),
        ('J5', 0.020, 37, (100, 50)),
        ('J6', 0.025, 32, (150, 50)),
    ]

    for name, demand, elev, coords in nodes:
        wn.add_junction(name, base_demand=demand, elevation=elev, coordinates=coords)

    # 添加水箱
    wn.add_tank('T1', elevation=55, init_level=5, min_level=3, max_level=10,
                diameter=15, coordinates=(200, 75))

    # 添加管道
    pipes = [
        ('P1', 'R1', 'J1', 1000, 0.4, 100),
        ('P2', 'J1', 'J2', 800, 0.35, 100),
        ('P3', 'J2', 'J3', 800, 0.3, 100),
        ('P4', 'J1', 'J4', 800, 0.35, 100),
        ('P5', 'J2', 'J5', 800, 0.3, 100),
        ('P6', 'J3', 'J6', 800, 0.25, 100),
        ('P7', 'J4', 'J5', 800, 0.3, 100),
        ('P8', 'J5', 'J6', 800, 0.25, 100),
        ('P9', 'J3', 'T1', 600, 0.3, 100),
    ]

    for name, start, end, length, diameter, roughness in pipes:
        wn.add_pipe(name, start, end, length=length, diameter=diameter, roughness=roughness)

    print(f"\n管网配置:")
    print(f"  水库: 1个")
    print(f"  节点: {len(nodes)}个")
    print(f"  水箱: 1个")
    print(f"  管道: {len(pipes)}条")
    print(f"  总管长: {sum(p[3] for p in pipes):.0f} m")

    return wn


def create_simulated_network():
    """创建模拟网络数据"""
    class SimulatedNetwork:
        def __init__(self):
            self.node_count = 6
            self.pipe_count = 9

    return SimulatedNetwork()


def example1_hydraulic_analysis():
    """示例1：水力分析"""
    print("\n" + "=" * 60)
    print("示例1：管网水力分析")
    print("=" * 60)

    if not EPANET_AVAILABLE:
        print("\n警告: wntr未安装，使用模拟数据")
        return simulate_hydraulic_analysis()

    adapter = EPANETAdapter()
    wn = create_example_network()
    adapter.wn = wn

    print("\n运行水力模拟...")

    # 运行模拟
    import wntr
    sim = wntr.sim.EpanetSimulator(wn)
    results = sim.run_sim()

    print("水力模拟完成！")

    # 分析结果
    print("\n" + "=" * 60)
    print("水力分析结果")
    print("=" * 60)

    # 节点压力统计
    pressure = results.node['pressure']
    print("\n节点压力统计:")
    for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']:
        if node in pressure.columns:
            p_mean = pressure[node].mean()
            p_min = pressure[node].min()
            p_max = pressure[node].max()
            print(f"  {node}: 平均{p_mean:.1f}m, 范围[{p_min:.1f}, {p_max:.1f}]m")

    # 管道流量统计
    flow = results.link['flowrate']
    print("\n管道流量统计:")
    for pipe in ['P1', 'P2', 'P3', 'P4', 'P5']:
        if pipe in flow.columns:
            f_mean = flow[pipe].mean() * 1000  # 转换为L/s
            print(f"  {pipe}: 平均流量 {f_mean:.1f} L/s")

    # 检查压力合格率
    min_pressure = 20  # m
    print(f"\n压力合格率分析（最小压力>={min_pressure}m）:")
    for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']:
        if node in pressure.columns:
            compliance = (pressure[node] >= min_pressure).mean() * 100
            print(f"  {node}: {compliance:.1f}%")

    return adapter, results


def example2_water_quality_simulation():
    """示例2：水质模拟"""
    print("\n" + "=" * 60)
    print("示例2：余氯水质模拟")
    print("=" * 60)

    if not EPANET_AVAILABLE:
        print("\n警告: wntr未安装，使用模拟数据")
        return simulate_water_quality()

    adapter = EPANETAdapter()
    wn = create_example_network()
    adapter.wn = wn

    # 设置水质参数
    wn.options.quality.parameter = 'CHEMICAL'

    # 设置初始水质（水库余氯浓度）
    reservoir = wn.get_node('R1')
    reservoir.initial_quality = 1.2  # mg/L

    # 设置衰减系数
    wn.options.quality.bulk_reaction_coefficient = -0.5  # 1/day
    wn.options.quality.wall_reaction_coefficient = -0.1  # m/day

    print("\n水质参数:")
    print("  源水余氯: 1.2 mg/L")
    print("  主体衰减: -0.5 /day")
    print("  管壁衰减: -0.1 m/day")

    print("\n运行水质模拟...")

    # 运行模拟
    import wntr
    sim = wntr.sim.EpanetSimulator(wn)
    results = sim.run_sim()

    print("水质模拟完成！")

    # 分析结果
    print("\n" + "=" * 60)
    print("水质分析结果")
    print("=" * 60)

    if 'quality' in results.node:
        quality = results.node['quality']

        print("\n节点余氯浓度（24小时平均）:")
        for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'T1']:
            if node in quality.columns:
                q_mean = quality[node].mean()
                q_min = quality[node].min()
                q_max = quality[node].max()
                status = "" if q_min >= 0.05 else ""
                print(f"  {node}: {q_mean:.3f} mg/L (范围[{q_min:.3f}, {q_max:.3f}]) {status}")

        # 检查水质合格率
        min_chlorine = 0.05  # mg/L
        max_chlorine = 4.0   # mg/L
        print(f"\n水质合格率分析（{min_chlorine}~{max_chlorine} mg/L）:")
        for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']:
            if node in quality.columns:
                compliance = ((quality[node] >= min_chlorine) &
                            (quality[node] <= max_chlorine)).mean() * 100
                print(f"  {node}: {compliance:.1f}%")

    return adapter, results


def example3_water_age_analysis():
    """示例3：水龄分析"""
    print("\n" + "=" * 60)
    print("示例3：管网水龄分析")
    print("=" * 60)

    if not EPANET_AVAILABLE:
        print("\n警告: wntr未安装，使用模拟数据")
        return simulate_water_age()

    adapter = EPANETAdapter()
    wn = create_example_network()
    adapter.wn = wn

    # 设置水龄追踪
    wn.options.quality.parameter = 'AGE'

    print("\n运行水龄模拟...")

    # 运行模拟
    import wntr
    sim = wntr.sim.EpanetSimulator(wn)
    results = sim.run_sim()

    print("水龄模拟完成！")

    # 分析结果
    print("\n" + "=" * 60)
    print("水龄分析结果")
    print("=" * 60)

    if 'quality' in results.node:
        age = results.node['quality'] / 3600  # 转换为小时

        print("\n节点水龄（小时）:")
        for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'T1']:
            if node in age.columns:
                age_mean = age[node].mean()
                age_max = age[node].max()
                print(f"  {node}: 平均 {age_mean:.2f}h, 最大 {age_max:.2f}h")

        # 识别水龄超标点
        max_age_limit = 48  # 小时
        print(f"\n水龄超标分析（>{max_age_limit}小时）:")
        for node in ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']:
            if node in age.columns:
                exceedance = (age[node] > max_age_limit).sum()
                if exceedance > 0:
                    print(f"  {node}: {exceedance}个时段超标")

    return adapter, results


def simulate_hydraulic_analysis():
    """模拟水力分析"""
    print("\n使用模拟数据...")

    # 模拟24小时，每小时一个数据点
    time = np.arange(0, 25)
    n_steps = len(time)

    # 模拟节点压力（考虑日变化）
    base_pressure = {'J1': 45, 'J2': 40, 'J3': 35, 'J4': 42, 'J5': 37, 'J6': 32}
    pressure_data = {}

    for node, base_p in base_pressure.items():
        # 添加日变化（+/-10%）
        variation = 0.1 * base_p * np.sin(2 * np.pi * time / 24)
        pressure_data[node] = base_p + variation

    # 模拟管道流量
    flow_data = {
        'P1': 60 + 10 * np.sin(2 * np.pi * time / 24),
        'P2': 45 + 8 * np.sin(2 * np.pi * time / 24),
        'P3': 30 + 6 * np.sin(2 * np.pi * time / 24),
        'P4': 40 + 7 * np.sin(2 * np.pi * time / 24),
        'P5': 35 + 6 * np.sin(2 * np.pi * time / 24),
    }

    print("模拟完成！")

    class SimulatedResults:
        def __init__(self):
            self.pressure_data = pressure_data
            self.flow_data = flow_data
            self.time = time

    return None, SimulatedResults()


def simulate_water_quality():
    """模拟水质分析"""
    print("\n使用模拟数据...")

    time = np.arange(0, 25)

    # 模拟余氯衰减
    nodes = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'T1']
    quality_data = {}

    for i, node in enumerate(nodes):
        # 不同节点有不同的衰减（取决于距离）
        distance_factor = i * 0.1
        decay_rate = 0.5 / 24  # per hour
        quality_data[node] = 1.2 * np.exp(-(decay_rate + distance_factor * 0.02) * time)

    print("模拟完成！")

    class SimulatedResults:
        def __init__(self):
            self.quality_data = quality_data
            self.time = time

    return None, SimulatedResults()


def simulate_water_age():
    """模拟水龄分析"""
    print("\n使用模拟数据...")

    time = np.arange(0, 25)
    nodes = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'T1']

    age_data = {}
    for i, node in enumerate(nodes):
        # 水龄逐渐增加，距离越远水龄越大
        base_age = i * 2  # 基础水龄
        age_data[node] = base_age + time * 0.5

    print("模拟完成！")

    class SimulatedResults:
        def __init__(self):
            self.age_data = age_data
            self.time = time

    return None, SimulatedResults()


def visualize_results():
    """可视化所有结果"""
    print("\n" + "=" * 60)
    print("生成可视化结果")
    print("=" * 60)

    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    # 示例数据（使用模拟）
    time = np.arange(0, 25)

    # 1. 节点压力
    ax1 = axes[0, 0]
    nodes = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6']
    colors = ['b', 'g', 'r', 'c', 'm', 'y']

    for node, color in zip(nodes, colors):
        base_p = {'J1': 45, 'J2': 40, 'J3': 35, 'J4': 42, 'J5': 37, 'J6': 32}[node]
        pressure = base_p + 0.1 * base_p * np.sin(2 * np.pi * time / 24)
        ax1.plot(time, pressure, f'{color}-', linewidth=2, label=node, alpha=0.8)

    ax1.axhline(y=20, color='r', linestyle='--', linewidth=1, label='Min Pressure')
    ax1.set_xlabel('Time (hours)', fontsize=11)
    ax1.set_ylabel('Pressure (m)', fontsize=11)
    ax1.set_title('Node Pressure Over Time', fontsize=12, fontweight='bold')
    ax1.legend(loc='upper right', fontsize=9)
    ax1.grid(True, alpha=0.3)

    # 2. 余氯浓度
    ax2 = axes[0, 1]
    for i, (node, color) in enumerate(zip(nodes, colors)):
        distance_factor = i * 0.1
        decay_rate = 0.5 / 24
        chlorine = 1.2 * np.exp(-(decay_rate + distance_factor * 0.02) * time)
        ax2.plot(time, chlorine, f'{color}-', linewidth=2, label=node, alpha=0.8)

    ax2.axhline(y=0.05, color='r', linestyle='--', linewidth=1, label='Min Standard')
    ax2.set_xlabel('Time (hours)', fontsize=11)
    ax2.set_ylabel('Chlorine (mg/L)', fontsize=11)
    ax2.set_title('Chlorine Concentration Over Time', fontsize=12, fontweight='bold')
    ax2.legend(loc='upper right', fontsize=9)
    ax2.grid(True, alpha=0.3)

    # 3. 水龄分布
    ax3 = axes[1, 0]
    for i, (node, color) in enumerate(zip(nodes, colors)):
        base_age = i * 2
        age = base_age + time * 0.5
        ax3.plot(time, age, f'{color}-', linewidth=2, label=node, alpha=0.8)

    ax3.set_xlabel('Time (hours)', fontsize=11)
    ax3.set_ylabel('Water Age (hours)', fontsize=11)
    ax3.set_title('Water Age Over Time', fontsize=12, fontweight='bold')
    ax3.legend(loc='upper left', fontsize=9)
    ax3.grid(True, alpha=0.3)

    # 4. 管道流量
    ax4 = axes[1, 1]
    pipes = ['P1', 'P2', 'P3', 'P4', 'P5']
    colors4 = ['b', 'g', 'r', 'c', 'm']
    base_flows = [60, 45, 30, 40, 35]

    for pipe, color, base_f in zip(pipes, colors4, base_flows):
        flow = base_f + 10 * np.sin(2 * np.pi * time / 24)
        ax4.plot(time, flow, f'{color}-', linewidth=2, label=pipe, alpha=0.8)

    ax4.set_xlabel('Time (hours)', fontsize=11)
    ax4.set_ylabel('Flow (L/s)', fontsize=11)
    ax4.set_title('Pipe Flow Over Time', fontsize=12, fontweight='bold')
    ax4.legend(loc='upper right', fontsize=9)
    ax4.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig('epanet_water_distribution_results.png', dpi=300, bbox_inches='tight')
    print("\n可视化结果已保存: epanet_water_distribution_results.png")



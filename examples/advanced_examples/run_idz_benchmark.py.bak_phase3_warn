from modeling.universal_modeler import UniversalModeler


def main():
    """运行IDZ基准测试"""

    config_file = Path(__file__).parent / "idz_benchmark_config.yaml"

    print("=" * 80)
    print("IDZ自适应控制基准测试")
    print("=" * 80)
    print()
    print("系统配置:")
    print("  - 渠道长度: 1 km (快响应系统)")
    print("  - 下游闸门位置: 950 m")
    print("  - 控制方式: PID控制")
    print()
    print("测试工况:")
    print("  - t=0-500s:     Q=18 m^3/s, 目标h=1.8 m")
    print("  - t=500-1000s:  Q=25 m^3/s, 目标h=1.8 m")
    print("  - t=1000-1500s: Q=32 m^3/s, 目标h=2.3 m")
    print("  - t=1500-1800s: Q=25 m^3/s, 目标h=2.8 m")
    print("  - t=1800-2100s: Q=18 m^3/s, 目标h=2.3 m -> 1.8 m")
    print()
    print("控制目标:")
    print("  - 跟踪时变目标水位")
    print("  - 应对流量扰动")
    print("  - 保持控制平滑")
    print()
    print("-" * 80)
    print()

    # 创建建模器
    modeler = UniversalModeler(str(config_file))

    # 运行仿真
    print("开始仿真...")
    print()
    result = modeler.run()

    print()
    print("=" * 80)
    print("仿真完成")
    print("=" * 80)
    print()

    # 显示控制性能
    if hasattr(modeler, 'control_result') and modeler.control_result is not None:
        ctrl_result = modeler.control_result
        metrics = ctrl_result.get('performance_metrics', {})

        print("控制性能指标:")
        print("-" * 80)

        if 'mae' in metrics:
            print(f"  平均绝对误差 (MAE):     {metrics['mae']:.4f} m")
        if 'rmse' in metrics:
            print(f"  均方根误差 (RMSE):      {metrics['rmse']:.4f} m")
        if 'max_error' in metrics:
            print(f"  最大误差:               {metrics['max_error']:.4f} m")
        if 'steady_state_error' in metrics:
            print(f"  稳态误差:               {metrics['steady_state_error']:.4f} m")

        print()

        # 控制平滑度
        if 'control_smoothness' in metrics:
            print(f"  控制平滑度:             {metrics['control_smoothness']:.4f} m/步")

        print()
        print("-" * 80)
        print()

        # 闸门控制范围
        control_history = ctrl_result.get('control_history', [])
        if len(control_history) > 0:
            import numpy as np
            controls = np.array(control_history)
            print(f"闸门开度范围: {controls.min():.3f} - {controls.max():.3f} m "
                  f"(平均: {controls.mean():.3f} m)")
            print()

    # 输出文件位置
    output_dir = modeler.config.get_output_config()['directory']
    print(f"结果已保存到: {output_dir}/")
    print()

    return result


if __name__ == "__main__":
    main()

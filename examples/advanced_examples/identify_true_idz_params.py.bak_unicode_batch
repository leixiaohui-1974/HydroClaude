dt = 2.0
simulator = SimplifiedCanalSimulator(dt=dt)
simulator.reset()

# 创建在线辨识器
identifier = IDZIdentifier(dt=dt, method=IdentificationMethod.FORGETTING_RLS, use_scipy=True)

# 工作点（目标）
h_target = 2.2
u_nominal = 2.0

# 记录数据
time_history = []
h_history = []
u_history = []
K_history = []

print("\n开始辨识实验...")
print("方案：阶跃响应测试")
print(f"  初始：h={simulator.h:.2f}m, u={u_nominal:.2f}m")
print(f"  目标：h={h_target:.2f}m")

# 阶段1：稳定在初始状态 (0-100s)
print("\n阶段1：初始稳态 (0-100s)")
u = 2.0  # 固定控制量
for step in range(50):  # 100s
    t = step * dt
    h = simulator.step(u)
    identifier.update(u, h)

    time_history.append(t)
    h_history.append(h)
    u_history.append(u)

    idz_params = identifier.get_idz_parameters()
    if idz_params:
        K_history.append(idz_params.K)
    else:
        K_history.append(np.nan)

    if step % 10 == 0:
        print(f"  t={t:.0f}s: h={h:.3f}m, u={u:.2f}m")

# 阶段2：阶跃扰动 (100-400s)
print("\n阶段2：闸门开度阶跃 (100-400s)")
print("  u: 2.0m → 3.0m (增大开度 → 水位下降)")
u = 3.0  # 阶跃增大
for step in range(50, 200):  # 100-400s
    t = step * dt
    h = simulator.step(u)
    identifier.update(u, h)

    time_history.append(t)
    h_history.append(h)
    u_history.append(u)

    idz_params = identifier.get_idz_parameters()
    if idz_params:
        K_history.append(idz_params.K)
    else:
        K_history.append(np.nan)

    if step % 20 == 0:
        print(f"  t={t:.0f}s: h={h:.3f}m, u={u:.2f}m, K={K_history[-1]:.1f}")

# 阶段3：反向阶跃 (400-700s)
print("\n阶段3：反向阶跃 (400-700s)")
print("  u: 3.0m → 1.5m (减小开度 → 水位上升)")
u = 1.5
for step in range(200, 350):  # 400-700s
    t = step * dt
    h = simulator.step(u)
    identifier.update(u, h)

    time_history.append(t)
    h_history.append(h)
    u_history.append(u)

    idz_params = identifier.get_idz_parameters()
    if idz_params:
        K_history.append(idz_params.K)
    else:
        K_history.append(np.nan)

    if step % 20 == 0:
        print(f"  t={t:.0f}s: h={h:.3f}m, u={u:.2f}m, K={K_history[-1]:.1f}")

# 获取最终辨识参数
final_params = identifier.get_idz_parameters()

print("\n" + "=" * 80)
print("辨识结果")
print("=" * 80)

if final_params:

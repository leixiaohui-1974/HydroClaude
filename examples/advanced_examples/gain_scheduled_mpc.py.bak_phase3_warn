        'u': np.array(u_hist),
        'Q_in': np.array(Q_in_hist),
        'error': error_array,
        'working_point': ['Single-Point'] * len(time_hist),  # 保持一致的格式
        'setpoint_schedule': setpoint_schedule,
        'mae': mae,
        'rmse': rmse,
        'max_error': max_error,
        'switching_history': []  # 单工作点没有切换
    }

    return result


def visualize_gain_scheduled_results(result_gs: Dict, result_single: Dict,
                                     working_points: List[WorkingPoint]):
    """
    可视化增益调度MPC vs 单工作点MPC的对比结果

    Args:
        result_gs: 增益调度MPC结果
        result_single: 单工作点MPC结果
        working_points: 工作点列表
    """
    fig = plt.figure(figsize=(18, 12))

    # 子图1：水位对比
    ax1 = plt.subplot(3, 3, 1)
    ax1.plot(result_gs['time'], result_gs['h'], 'b-', linewidth=2, label='Gain-Scheduled MPC')
    ax1.plot(result_single['time'], result_single['h'], 'r--', linewidth=2, label='Single-Point MPC', alpha=0.7)

    # 绘制设定点阶跃
    for t_switch, sp in result_gs['setpoint_schedule']:
        t_end = result_gs['setpoint_schedule'][result_gs['setpoint_schedule'].index((t_switch, sp)) + 1][0] \
                if result_gs['setpoint_schedule'].index((t_switch, sp)) < len(result_gs['setpoint_schedule']) - 1 \
                else result_gs['time'][-1]
        ax1.hlines(sp, t_switch, t_end, colors='gray', linestyles=':', linewidth=2, label='Setpoint' if t_switch == 0 else '')

    # 标记工作点水位
    for wp in working_points:
        ax1.axhline(wp.h, color='green', linestyle=':', alpha=0.3, linewidth=1)
        ax1.text(10, wp.h, f'{wp.name}', fontsize=8, color='green', alpha=0.7)

    ax1.set_xlabel('Time (s)', fontsize=11)
    ax1.set_ylabel('Water Level (m)', fontsize=11)
    ax1.set_title('Water Level Tracking', fontsize=12, fontweight='bold')
    ax1.legend(loc='best')
    ax1.grid(True, alpha=0.3)

    # 子图2：控制量对比
    ax2 = plt.subplot(3, 3, 2)
    ax2.plot(result_gs['time'], result_gs['u'], 'b-', linewidth=2, label='Gain-Scheduled MPC')
    ax2.plot(result_single['time'], result_single['u'], 'r--', linewidth=2, label='Single-Point MPC', alpha=0.7)
    ax2.set_xlabel('Time (s)', fontsize=11)
    ax2.set_ylabel('Gate Opening (m)', fontsize=11)
    ax2.set_title('Control Input', fontsize=12, fontweight='bold')
    ax2.legend()
    ax2.grid(True, alpha=0.3)

    # 子图3：误差对比
    ax3 = plt.subplot(3, 3, 3)
    ax3.plot(result_gs['time'], result_gs['error'] * 100, 'b-', linewidth=2, label='Gain-Scheduled MPC')
    ax3.plot(result_single['time'], result_single['error'] * 100, 'r--', linewidth=2, label='Single-Point MPC', alpha=0.7)
    ax3.set_xlabel('Time (s)', fontsize=11)
    ax3.set_ylabel('Absolute Error (cm)', fontsize=11)
    ax3.set_title('Tracking Error', fontsize=12, fontweight='bold')
    ax3.legend()
    ax3.grid(True, alpha=0.3)

    # 子图4：工作点切换历史
    ax4 = plt.subplot(3, 3, 4)

    # 将工作点名称转换为数字编码
    wp_names = [wp.name for wp in working_points]
    wp_to_idx = {name: i for i, name in enumerate(wp_names)}
    wp_indices = [wp_to_idx[wp] for wp in result_gs['working_point']]

    ax4.step(result_gs['time'], wp_indices, 'b-', linewidth=2, where='post')
    ax4.set_yticks(range(len(wp_names)))
    ax4.set_yticklabels(wp_names, fontsize=9)
    ax4.set_xlabel('Time (s)', fontsize=11)
    ax4.set_ylabel('Active Working Point', fontsize=11)
    ax4.set_title('Working Point Switching', fontsize=12, fontweight='bold')
    ax4.grid(True, alpha=0.3)

    # 子图5：扰动
    ax5 = plt.subplot(3, 3, 5)
    ax5.step(result_gs['time'], result_gs['Q_in'], 'g-', linewidth=2, where='post')
    ax5.set_xlabel('Time (s)', fontsize=11)
    ax5.set_ylabel('Inflow (m^3/s)', fontsize=11)
    ax5.set_title('Disturbance', fontsize=12, fontweight='bold')
    ax5.grid(True, alpha=0.3)

    # 子图6：性能指标对比
    ax6 = plt.subplot(3, 3, 6)
    metrics = ['MAE\n(cm)', 'RMSE\n(cm)', 'Max Error\n(cm)']
    gs_values = [result_gs['mae']*100, result_gs['rmse']*100, result_gs['max_error']*100]
    single_values = [result_single['mae']*100, result_single['rmse']*100, result_single['max_error']*100]

    x = np.arange(len(metrics))
    width = 0.35

    ax6.bar(x - width/2, gs_values, width, label='Gain-Scheduled', color='blue', alpha=0.7)
    ax6.bar(x + width/2, single_values, width, label='Single-Point', color='red', alpha=0.7)
    ax6.set_xticks(x)
    ax6.set_xticklabels(metrics, fontsize=9)
    ax6.set_ylabel('Value', fontsize=11)
    ax6.set_title('Performance Metrics', fontsize=12, fontweight='bold')
    ax6.legend()
    ax6.grid(True, alpha=0.3, axis='y')

    # 子图7：切换事件分析
    ax7 = plt.subplot(3, 3, 7)
    switching_times = []
    switching_wp_from = []
    switching_wp_to = []

    for switch in result_gs['switching_history']:
        if switch['from'] is not None:
            switching_times.append(switch['y'])  # 使用水位作为x轴
            switching_wp_from.append(wp_to_idx[switch['from']])
            switching_wp_to.append(wp_to_idx[switch['to']])

    if len(switching_times) > 0:
        ax7.scatter(switching_times, switching_wp_from, c='red', marker='o', s=100, label='From', alpha=0.6)
        ax7.scatter(switching_times, switching_wp_to, c='blue', marker='s', s=100, label='To', alpha=0.6)

        # 连线
        for i in range(len(switching_times)):
            ax7.plot([switching_times[i], switching_times[i]],
                    [switching_wp_from[i], switching_wp_to[i]],
                    'k-', alpha=0.3)

    ax7.set_yticks(range(len(wp_names)))
    ax7.set_yticklabels(wp_names, fontsize=9)
    ax7.set_xlabel('Water Level at Switching (m)', fontsize=11)
    ax7.set_ylabel('Working Point', fontsize=11)
    ax7.set_title(f'Switching Events (n={len(switching_times)})', fontsize=12, fontweight='bold')
    ax7.legend()
    ax7.grid(True, alpha=0.3)

    # 子图8：误差直方图对比
    ax8 = plt.subplot(3, 3, 8)
    ax8.hist(result_gs['error'] * 100, bins=30, alpha=0.5, label='Gain-Scheduled', color='blue', edgecolor='black')
    ax8.hist(result_single['error'] * 100, bins=30, alpha=0.5, label='Single-Point', color='red', edgecolor='black')
    ax8.set_xlabel('Error (cm)', fontsize=11)
    ax8.set_ylabel('Frequency', fontsize=11)
    ax8.set_title('Error Distribution', fontsize=12, fontweight='bold')
    ax8.legend()
    ax8.grid(True, alpha=0.3, axis='y')

    # 子图9：性能改善百分比
    ax9 = plt.subplot(3, 3, 9)
    improvement_mae = (result_single['mae'] - result_gs['mae']) / result_single['mae'] * 100
    improvement_rmse = (result_single['rmse'] - result_gs['rmse']) / result_single['rmse'] * 100
    improvement_max = (result_single['max_error'] - result_gs['max_error']) / result_single['max_error'] * 100

    improvements = [improvement_mae, improvement_rmse, improvement_max]
    colors = ['green' if imp > 0 else 'red' for imp in improvements]

    ax9.bar(range(3), improvements, color=colors, alpha=0.7, edgecolor='black')
    ax9.set_xticks(range(3))
    ax9.set_xticklabels(['MAE', 'RMSE', 'Max Error'], fontsize=9)
    ax9.set_ylabel('Improvement (%)', fontsize=11)
    ax9.set_title('Performance Improvement', fontsize=12, fontweight='bold')
    ax9.axhline(0, color='black', linestyle='-', linewidth=1)
    ax9.grid(True, alpha=0.3, axis='y')

    # 在柱状图上标注数值
    for i, imp in enumerate(improvements):
        ax9.text(i, imp + 2 if imp > 0 else imp - 2, f'{imp:.1f}%',
                ha='center', va='bottom' if imp > 0 else 'top', fontweight='bold')

    plt.tight_layout()
    plt.savefig('gain_scheduled_mpc_comparison.png', dpi=150, bbox_inches='tight')
    print(f" 图片已保存: gain_scheduled_mpc_comparison.png")


def print_summary(result_gs: Dict, result_single: Dict, working_points: List[WorkingPoint]):
    """打印性能对比总结"""
    print("\n" + "="*80)
    print("增益调度MPC vs 单工作点MPC性能对比")
    print("="*80)

    print(f"\n【工作点配置】")
    print("-" * 80)
    for wp in working_points:
        print(f"  {wp.name}: h={wp.h}m, K={wp.K:.4f}, tau={wp.tau:.1f}s")

    print(f"\n【测试1】增益调度MPC（{len(working_points)}个工作点）")
    print("-" * 80)
    print(f"  MAE           = {result_gs['mae']*100:.2f} cm")
    print(f"  RMSE          = {result_gs['rmse']*100:.2f} cm")
    print(f"  最大误差      = {result_gs['max_error']*100:.2f} cm")

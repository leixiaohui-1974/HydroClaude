        (300, 2.3),  # 低水位
        (600, 2.6)   # 中水位
    ]

    # 仿真步数
    n_steps = int(total_time / dt)

    # 记录数组
    time_hist = []
    h_hist = []
    u_hist = []
    Q_in_hist = []
    error_hist = []

    current_Q_in = disturbance_schedule[0][1]
    current_setpoint = setpoint_schedule[0][1]

    for k in range(n_steps):
        t = k * dt

        # 更新扰动
        for t_switch, Q_new in disturbance_schedule:
            if abs(t - t_switch) < dt / 2:
                current_Q_in = Q_new
                simulator.set_disturbance(Q_new)
                break

        # 更新设定点
        for t_switch, sp_new in setpoint_schedule:
            if abs(t - t_switch) < dt / 2:
                current_setpoint = sp_new
                break

        # 获取当前水位
        y = simulator.h

        # 单工作点MPC计算控制量
        u, diag = mpc.compute_control(y, current_setpoint)

        # 执行控制
        y_next = simulator.step(u)

        # 记录
        time_hist.append(t)

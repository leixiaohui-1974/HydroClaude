            best_mae = min(scenario_results, key=lambda r: r.mae)
            print(f"\n   最佳控制器（MAE）: {best_mae.controller_name} (MAE={best_mae.mae*100:.2f}cm)")

    def visualize_results(self):
        """可视化所有结果"""
        # 找出所有场景
        scenarios = list(set([r.scenario_name for r in self.results]))
        n_scenarios = len(scenarios)

        # 为每个场景创建对比图
        for scenario in scenarios:
            scenario_results = [r for r in self.results if r.scenario_name == scenario]

            fig = plt.figure(figsize=(18, 10))

            # 子图1：水位对比
            ax1 = plt.subplot(2, 3, 1)
            for result in scenario_results:
                ax1.plot(result.time, result.h, linewidth=2, label=result.controller_name, alpha=0.8)
            ax1.plot(scenario_results[0].time, scenario_results[0].setpoint, 'k--',
                    linewidth=2, label='Setpoint', alpha=0.5)
            ax1.set_xlabel('Time (s)', fontsize=11)
            ax1.set_ylabel('Water Level (m)', fontsize=11)
            ax1.set_title(f'Water Level Tracking - {scenario}', fontsize=12, fontweight='bold')
            ax1.legend(loc='best', fontsize=9)
            ax1.grid(True, alpha=0.3)

            # 子图2：控制量对比
            ax2 = plt.subplot(2, 3, 2)
            for result in scenario_results:
                ax2.plot(result.time, result.u, linewidth=2, label=result.controller_name, alpha=0.8)
            ax2.set_xlabel('Time (s)', fontsize=11)
            ax2.set_ylabel('Gate Opening (m)', fontsize=11)
            ax2.set_title('Control Input', fontsize=12, fontweight='bold')
            ax2.legend(loc='best', fontsize=9)
            ax2.grid(True, alpha=0.3)

            # 子图3：误差对比
            ax3 = plt.subplot(2, 3, 3)
            for result in scenario_results:
                ax3.plot(result.time, result.error * 100, linewidth=2,
                        label=result.controller_name, alpha=0.8)
            ax3.set_xlabel('Time (s)', fontsize=11)
            ax3.set_ylabel('Absolute Error (cm)', fontsize=11)
            ax3.set_title('Tracking Error', fontsize=12, fontweight='bold')
            ax3.legend(loc='best', fontsize=9)
            ax3.grid(True, alpha=0.3)

            # 子图4：性能指标柱状图
            ax4 = plt.subplot(2, 3, 4)
            metrics = ['MAE', 'RMSE', 'Max Error']
            x = np.arange(len(metrics))
            width = 0.25

            for i, result in enumerate(scenario_results):
                values = [result.mae*100, result.rmse*100, result.max_error*100]
                ax4.bar(x + i*width, values, width, label=result.controller_name, alpha=0.8)

            ax4.set_xticks(x + width)
            ax4.set_xticklabels(metrics, fontsize=10)
            ax4.set_ylabel('Error (cm)', fontsize=11)
            ax4.set_title('Performance Metrics', fontsize=12, fontweight='bold')
            ax4.legend(fontsize=9)
            ax4.grid(True, alpha=0.3, axis='y')

            # 子图5：计算时间对比
            ax5 = plt.subplot(2, 3, 5)
            controllers = [r.controller_name for r in scenario_results]
            compute_times = [r.avg_compute_time for r in scenario_results]
            colors = plt.cm.viridis(np.linspace(0, 1, len(controllers)))

            ax5.bar(range(len(controllers)), compute_times, color=colors, alpha=0.8, edgecolor='black')
            ax5.set_xticks(range(len(controllers)))
            ax5.set_xticklabels(controllers, rotation=15, ha='right', fontsize=9)
            ax5.set_ylabel('Avg Compute Time (ms)', fontsize=11)
            ax5.set_title('Computational Cost', fontsize=12, fontweight='bold')
            ax5.grid(True, alpha=0.3, axis='y')

            # 子图6：性能雷达图
            ax6 = plt.subplot(2, 3, 6, projection='polar')

            # 归一化指标（越小越好 → 越大越好）
            categories = ['MAE', 'RMSE', 'Max Err', 'Speed']
            N = len(categories)

            angles = np.linspace(0, 2 * np.pi, N, endpoint=False).tolist()
            angles += angles[:1]

            for result in scenario_results:
                # 归一化：100 - (value / max_value * 100)，使得越好的指标数值越大
                max_mae = max([r.mae for r in scenario_results])
                max_rmse = max([r.rmse for r in scenario_results])
                max_error = max([r.max_error for r in scenario_results])
                max_time = max([r.avg_compute_time for r in scenario_results])

                values = [
                    100 - (result.mae / max_mae * 100),
                    100 - (result.rmse / max_rmse * 100),
                    100 - (result.max_error / max_error * 100),
                    100 - (result.avg_compute_time / max_time * 100)
                ]
                values += values[:1]

                ax6.plot(angles, values, 'o-', linewidth=2, label=result.controller_name)
                ax6.fill(angles, values, alpha=0.15)

            ax6.set_xticks(angles[:-1])
            ax6.set_xticklabels(categories, fontsize=10)
            ax6.set_ylim(0, 100)
            ax6.set_title('Performance Radar', fontsize=12, fontweight='bold', pad=20)
            ax6.legend(loc='upper right', bbox_to_anchor=(1.3, 1.0), fontsize=9)
            ax6.grid(True)

            plt.tight_layout()
            filename = f'benchmark_{scenario.lower()}.png'
            plt.savefig(filename, dpi=150, bbox_inches='tight')
            print(f" 图片已保存: {filename}")

        # 创建总结对比图
        self._create_summary_figure()

    def _create_summary_figure(self):
        """创建总结对比图"""
        scenarios = list(set([r.scenario_name for r in self.results]))
        controllers = list(set([r.controller_name for r in self.results]))

        fig, axes = plt.subplots(2, 2, figsize=(16, 12))

        # 各场景下的MAE对比
        ax1 = axes[0, 0]
        for ctrl in controllers:
            maes = []
            for scenario in scenarios:
                results = [r for r in self.results
                          if r.controller_name == ctrl and r.scenario_name == scenario]
                if results:
                    maes.append(results[0].mae * 100)
                else:
                    maes.append(0)

            ax1.plot(scenarios, maes, 'o-', linewidth=2, markersize=8, label=ctrl)

        ax1.set_xlabel('Scenario', fontsize=11)
        ax1.set_ylabel('MAE (cm)', fontsize=11)
        ax1.set_title('MAE Across Scenarios', fontsize=12, fontweight='bold')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        ax1.tick_params(axis='x', rotation=15)

        # 性能排名矩阵
        ax2 = axes[0, 1]
        ranking_matrix = np.zeros((len(controllers), len(scenarios)))

        for i, ctrl in enumerate(controllers):
            for j, scenario in enumerate(scenarios):
                scenario_results = [r for r in self.results if r.scenario_name == scenario]
                ctrl_result = [r for r in scenario_results if r.controller_name == ctrl]

                if ctrl_result:
                    # 按MAE排名（1=最好）
                    sorted_results = sorted(scenario_results, key=lambda r: r.mae)
                    rank = sorted_results.index(ctrl_result[0]) + 1
                    ranking_matrix[i, j] = rank

        im = ax2.imshow(ranking_matrix, cmap='RdYlGn_r', aspect='auto', vmin=1, vmax=len(controllers))
        ax2.set_xticks(range(len(scenarios)))
        ax2.set_yticks(range(len(controllers)))
        ax2.set_xticklabels(scenarios, rotation=15, ha='right', fontsize=9)
        ax2.set_yticklabels(controllers, fontsize=9)
        ax2.set_title('Performance Ranking (1=Best)', fontsize=12, fontweight='bold')

        # 在每个格子中标注排名
        for i in range(len(controllers)):
            for j in range(len(scenarios)):
                text = ax2.text(j, i, f'{int(ranking_matrix[i, j])}',
                              ha="center", va="center", color="black", fontweight='bold', fontsize=12)

        plt.colorbar(im, ax=ax2)

        # 总体性能得分
        ax3 = axes[1, 0]
        overall_scores = []

        for ctrl in controllers:
            ctrl_results = [r for r in self.results if r.controller_name == ctrl]
            avg_mae = np.mean([r.mae for r in ctrl_results])
            avg_rmse = np.mean([r.rmse for r in ctrl_results])
            avg_compute_time = np.mean([r.avg_compute_time for r in ctrl_results])

            # 综合得分（越小越好，归一化后反转）
            score = 100 - (avg_mae * 100 / 2)  # 简化计分
            overall_scores.append(score)

        colors = plt.cm.viridis(np.linspace(0, 1, len(controllers)))
        bars = ax3.barh(controllers, overall_scores, color=colors, alpha=0.8, edgecolor='black')
        ax3.set_xlabel('Overall Score', fontsize=11)
        ax3.set_title('Overall Performance Score', fontsize=12, fontweight='bold')
        ax3.grid(True, alpha=0.3, axis='x')

        # 标注数值
        for bar, score in zip(bars, overall_scores):
            ax3.text(bar.get_width() + 1, bar.get_y() + bar.get_height()/2,
                    f'{score:.1f}', va='center', fontweight='bold')

        # 推荐场景
        ax4 = axes[1, 1]
        ax4.axis('off')

        recommendation_text = " 控制器选择建议\n\n"

        # 分析每个场景的最佳控制器
        for scenario in scenarios:
            scenario_results = [r for r in self.results if r.scenario_name == scenario]
            best = min(scenario_results, key=lambda r: r.mae)
            recommendation_text += f" {scenario}场景:\n  → {best.controller_name}\n  (MAE={best.mae*100:.2f}cm)\n\n"

        # 总体推荐
        all_results_by_ctrl = {}
        for ctrl in controllers:
            ctrl_results = [r for r in self.results if r.controller_name == ctrl]
            all_results_by_ctrl[ctrl] = np.mean([r.mae for r in ctrl_results])

        best_overall = min(all_results_by_ctrl, key=all_results_by_ctrl.get)

        recommendation_text += f"\n 总体推荐:\n  {best_overall}\n"
        recommendation_text += f"  (平均MAE={all_results_by_ctrl[best_overall]*100:.2f}cm)"

        ax4.text(0.1, 0.9, recommendation_text, transform=ax4.transAxes,
                fontsize=11, verticalalignment='top', family='monospace',
                bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))

        plt.tight_layout()
        plt.savefig('benchmark_summary.png', dpi=150, bbox_inches='tight')
        print(f" 总结图已保存: benchmark_summary.png")



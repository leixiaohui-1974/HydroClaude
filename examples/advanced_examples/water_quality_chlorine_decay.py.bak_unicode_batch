供水管网余氯衰减模拟案例

本案例展示如何使用HydroClaude的水质模拟功能分析管网中的余氯衰减

模拟场景：
- 城市供水管网
- 源水余氯浓度：1.0 mg/L
- 管道长度：5000m
- 模拟24小时余氯衰减过程

作者：HydroClaude Team
日期：2025-10-24
"""

import numpy as np
import matplotlib.pyplot as plt
import sys
import os

# 添加项目根目录
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../..')))

from simulation.water_quality import (
    WaterQualitySimulator,
    NetworkWaterQuality,
    NetworkNode,
    NetworkPipe,
    ReactionConfig,
    ReactionType
)


def example1_single_pipe_chlorine():
    """示例1：单管道余氯衰减"""
    print("=" * 60)
    print("示例1：单管道余氯衰减模拟")
    print("=" * 60)

    # 创建水质模拟器
    simulator = WaterQualitySimulator(
        nx=50,  # 50个网格点
        length=5000.0,  # 5km管道
        diameter=0.6  # 600mm管径
    )

    # 设置初始浓度和流速
    simulator.set_initial_concentration(1.0)  # 1.0 mg/L
    simulator.set_velocity(0.5)  # 0.5 m/s

    # 添加余氯衰减反应
    # 主体衰减系数: -0.5 /day (一级反应)
    # 管壁衰减系数: -0.1 m/day
    chlorine_reaction = ReactionConfig(
        reaction_type=ReactionType.FIRST_ORDER,
        bulk_coefficient=-0.5,  # 1/day
        wall_coefficient=-0.1  # m/day
    )
    simulator.add_reaction("chlorine", chlorine_reaction)

    print("\n模拟参数:")
    print(f"  管道长度: {simulator.length:.0f} m")
    print(f"  管道直径: {simulator.diameter:.3f} m")
    print(f"  流速: 0.5 m/s")
    print(f"  初始余氯: 1.0 mg/L")
    print(f"  主体衰减系数: -0.5 /day")
    print(f"  管壁衰减系数: -0.1 m/day")

    # 模拟24小时
    duration = 24 * 3600  # 24小时（秒）
    dt = 300  # 5分钟时间步长
    n_steps = int(duration / dt)

    print(f"\n开始模拟...")
    print(f"  模拟时长: 24 hours")
    print(f"  时间步长: {dt/60:.0f} min")

    # 记录历史
    time_history = []
    concentration_inlet = []
    concentration_outlet = []
    concentration_mid = []

    for step in range(n_steps):
        # 推进时间步，保持入口浓度为1.0 mg/L
        simulator.step(dt, inflow_concentration=1.0)

        # 记录数据
        current_time = step * dt / 3600.0  # 转换为小时
        time_history.append(current_time)
        concentration_inlet.append(simulator.concentration[0])
        concentration_outlet.append(simulator.concentration[-1])
        mid_idx = len(simulator.concentration) // 2
        concentration_mid.append(simulator.concentration[mid_idx])

        if (step + 1) % 20 == 0:
            print(f"  步数 {step+1}/{n_steps}, 时间 {current_time:.1f}h, "
                  f"出口余氯 {concentration_outlet[-1]:.3f} mg/L")

    print("\n模拟完成！")

    # 分析结果
    print("\n" + "=" * 60)
    print("模拟结果分析")
    print("=" * 60)

    final_outlet = concentration_outlet[-1]
    chlorine_loss = (1.0 - final_outlet) / 1.0 * 100

    print(f"\n24小时后余氯浓度:")
    print(f"  入口: {concentration_inlet[-1]:.3f} mg/L")
    print(f"  中点: {concentration_mid[-1]:.3f} mg/L")
    print(f"  出口: {final_outlet:.3f} mg/L")
    print(f"  衰减率: {chlorine_loss:.1f}%")

    # 检查是否满足标准
    if final_outlet >= 0.05:
        print(f"\n 管网末端余氯 {final_outlet:.3f} mg/L ≥ 0.05 mg/L (符合标准)")
    else:
        print(f"\n 管网末端余氯 {final_outlet:.3f} mg/L < 0.05 mg/L (不符合标准)")

    # 可视化
    visualize_single_pipe_results(
        time_history,
        concentration_inlet,
        concentration_mid,
        concentration_outlet,
        simulator
    )

    return simulator, time_history, concentration_outlet


def example2_network_chlorine():
    """示例2：管网余氯分布"""
    print("\n" + "=" * 60)
    print("示例2：管网余氯分布模拟")
    print("=" * 60)

    # 创建管网水质模拟
    network = NetworkWaterQuality()

    # 添加节点
    nodes = [
        NetworkNode('SOURCE', elevation=120, concentration=1.2),  # 水厂，余氯1.2 mg/L
        NetworkNode('N1', elevation=115, demand=0.01),
        NetworkNode('N2', elevation=110, demand=0.015),
        NetworkNode('N3', elevation=105, demand=0.02),
        NetworkNode('N4', elevation=100, demand=0.015),
    ]

    for node in nodes:
        network.add_node(node)

    # 添加管道
    pipes = [
        NetworkPipe('P1', 'SOURCE', 'N1', length=1000, diameter=0.4, flow=0.06),
        NetworkPipe('P2', 'N1', 'N2', length=1500, diameter=0.35, flow=0.05),
        NetworkPipe('P3', 'N2', 'N3', length=2000, diameter=0.3, flow=0.035),
        NetworkPipe('P4', 'N3', 'N4', length=1500, diameter=0.25, flow=0.015),
    ]

    for pipe in pipes:
        network.add_pipe(pipe)

    # 设置余氯衰减
    reaction = ReactionConfig(
        reaction_type=ReactionType.FIRST_ORDER,
        bulk_coefficient=-0.5,
        wall_coefficient=-0.1
    )
    network.set_reaction(reaction)

    print(f"\n管网配置:")
    print(f"  节点数: {len(network.nodes)}")
    print(f"  管道数: {len(network.pipes)}")
    print(f"  总管长: {sum(p.length for p in network.pipes.values()):.0f} m")

    # 运行模拟
    duration = 12 * 3600  # 12小时
    dt = 600  # 10分钟
    network.simulate(duration, dt)

    # 获取结果
    results = network.get_results()

    print("\n" + "=" * 60)
    print("管网余氯分布结果")
    print("=" * 60)

    print("\n节点余氯浓度:")
    for node_id, data in results['nodes'].items():
        print(f"  {node_id}: {data['concentration']:.3f} mg/L")

    print("\n管道平均余氯:")
    for pipe_id, data in results['pipes'].items():
        print(f"  {pipe_id}: {data['average_concentration']:.3f} mg/L, "
              f"出口: {data['outlet_concentration']:.3f} mg/L")

    return network, results


def example3_water_age():
    """示例3：水龄追踪"""
    print("\n" + "=" * 60)
    print("示例3：管网水龄追踪")
    print("=" * 60)

    # 创建模拟器
    simulator = WaterQualitySimulator(
        nx=40,
        length=3000.0,
        diameter=0.5
    )

    # 设置流速（较慢，便于观察水龄增长）
    simulator.set_velocity(0.3)  # 0.3 m/s

    print("\n模拟参数:")
    print(f"  管道长度: {simulator.length:.0f} m")
    print(f"  流速: 0.3 m/s")
    print(f"  理论停留时间: {simulator.length / 0.3 / 3600:.2f} hours")

    # 模拟12小时
    duration = 12 * 3600
    dt = 300
    n_steps = int(duration / dt)

    print(f"\n开始水龄追踪...")

    age_history = []

    for step in range(n_steps):
        simulator.step(dt, inflow_concentration=0.0)  # 水龄追踪不需要入口浓度

        current_time = step * dt / 3600.0
        avg_age = np.mean(simulator.age)
        age_history.append(avg_age)

        if (step + 1) % 24 == 0:
            print(f"  时间 {current_time:.1f}h, 平均水龄 {avg_age:.2f}h")

    print("\n水龄分析:")
    print(f"  入口水龄: {simulator.age[0]:.2f} hours")
    print(f"  出口水龄: {simulator.age[-1]:.2f} hours")
    print(f"  平均水龄: {np.mean(simulator.age):.2f} hours")
    print(f"  最大水龄: {np.max(simulator.age):.2f} hours")

    return simulator, age_history


def visualize_single_pipe_results(time_history, conc_inlet, conc_mid, conc_outlet, simulator):
    """可视化单管道结果"""

    fig, axes = plt.subplots(2, 2, figsize=(14, 10))

    # 1. 余氯时间序列
    ax1 = axes[0, 0]
    ax1.plot(time_history, conc_inlet, 'b-', linewidth=2, label='Inlet')
    ax1.plot(time_history, conc_mid, 'g-', linewidth=2, label='Middle')
    ax1.plot(time_history, conc_outlet, 'r-', linewidth=2, label='Outlet')
    ax1.axhline(y=0.05, color='k', linestyle='--', linewidth=1, label='Min Standard')
    ax1.set_xlabel('Time (hours)', fontsize=11)
    ax1.set_ylabel('Chlorine (mg/L)', fontsize=11)
    ax1.set_title('Chlorine Concentration vs Time', fontsize=12, fontweight='bold')
    ax1.legend()
    ax1.grid(True, alpha=0.3)

    # 2. 空间分布（最终时刻）
    ax2 = axes[0, 1]
    ax2.plot(simulator.x / 1000, simulator.concentration, 'b-', linewidth=2.5)
    ax2.axhline(y=0.05, color='r', linestyle='--', linewidth=1, label='Min Standard')
    ax2.fill_between(simulator.x / 1000, 0, simulator.concentration, alpha=0.3)
    ax2.set_xlabel('Distance (km)', fontsize=11)
    ax2.set_ylabel('Chlorine (mg/L)', fontsize=11)
    ax2.set_title('Final Chlorine Distribution', fontsize=12, fontweight='bold')
    ax2.legend()
    ax2.grid(True, alpha=0.3)

    # 3. 衰减曲线拟合
    ax3 = axes[1, 0]
    # 理论衰减曲线（一级反应）
    k_total = 0.5 / 86400  # 转换为1/s
    theoretical_outlet = []
    for t in time_history:
        t_seconds = t * 3600
        # 考虑停留时间
        residence_time = simulator.length / 0.5  # 秒
        c = 1.0 * np.exp(-k_total * (t_seconds + residence_time))
        theoretical_outlet.append(c)

    ax3.plot(time_history, conc_outlet, 'ro', markersize=4, label='Simulated', alpha=0.6)
    ax3.plot(time_history, theoretical_outlet, 'b-', linewidth=2, label='Theoretical')
    ax3.set_xlabel('Time (hours)', fontsize=11)
    ax3.set_ylabel('Outlet Chlorine (mg/L)', fontsize=11)
    ax3.set_title('Decay Curve Comparison', fontsize=12, fontweight='bold')
    ax3.legend()
    ax3.grid(True, alpha=0.3)

    # 4. 统计信息
    ax4 = axes[1, 1]
    ax4.axis('off')

    stats_text = f"""
    Simulation Statistics
    {'=' * 40}

    Pipe Configuration:
      Length:        {simulator.length:.0f} m
      Diameter:      {simulator.diameter*1000:.0f} mm
      Velocity:      0.5 m/s

    Chlorine Decay:
      Initial:       1.000 mg/L
      Final (outlet):{conc_outlet[-1]:.3f} mg/L
      Loss:          {(1-conc_outlet[-1])*100:.1f}%

    Reaction Coefficients:
      Bulk:          -0.5 /day
      Wall:          -0.1 m/day

    Water Quality Standard:
      Minimum:       0.05 mg/L
      Status:        {' PASS' if conc_outlet[-1] >= 0.05 else ' FAIL'}

    Residence Time:
      Pipe:          {simulator.length/0.5/3600:.2f} hours
    """

    ax4.text(0.1, 0.5, stats_text, fontsize=10, family='monospace',
            verticalalignment='center', transform=ax4.transAxes)

    plt.tight_layout()
    plt.savefig('water_quality_chlorine_results.png', dpi=300, bbox_inches='tight')
    print("\n可视化结果已保存: water_quality_chlorine_results.png")



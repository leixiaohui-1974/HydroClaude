def joukowsky_analysis():
    """Joukowsky公式理论分析"""
    print("="*80)
    print("Joukowsky公式理论分析")
    print("="*80)
    print()

    # 泵站参数
    Q0 = 1.0          # 初始流量 (m³/s)
    D = 0.8           # 管径 (m)
    L = 5000          # 管道长度 (m)
    a = 1000          # 波速 (m/s)
    f = 0.018         # 摩阻系数

    # 计算流速
    A = np.pi * (D/2)**2
    V0 = Q0 / A

    # Joukowsky压升
    delta_H_jouk = a * V0 / 9.81

    # 临界关闭时间
    T_critical = 2 * L / a

    print(f"【系统参数】")
    print(f"  流量: Q = {Q0*1000:.1f} L/s")
    print(f"  管径: D = {D*1000:.0f} mm")
    print(f"  长度: L = {L:.0f} m")
    print(f"  波速: a = {a:.0f} m/s")
    print(f"  流速: V = {V0:.2f} m/s")
    print()

    print(f"【Joukowsky理论】")
    print(f"  压力升高: ΔH = a*V/g = {delta_H_jouk:.2f} m")
    print(f"  临界时间: T_c = 2L/a = {T_critical:.2f} s")
    print()

    print(f"【工程判断】")
    if delta_H_jouk > 50:
        print(f"  ️ 压力升高 {delta_H_jouk:.0f}m 过大！")
        print(f"     必须采取水锤防护措施：")
        print(f"     1. 安装空气罐/调压塔")
        print(f"     2. 增加飞轮惯量")
        print(f"     3. 分段关阀控制")
    elif delta_H_jouk > 30:
        print(f"  ️ 压力升高 {delta_H_jouk:.0f}m 较大")
        print(f"     建议采取适当防护措施")
    else:
        print(f"   压力升高 {delta_H_jouk:.0f}m 在可接受范围内")

    print()

    return Q0, D, L, a, f, V0, delta_H_jouk, T_critical


def simulate_power_failure(Q0, D, L, a, f, duration=20.0, verbose=True):
    """模拟停电工况"""
    if verbose:
        print("="*80)
        print("停电工况水锤数值模拟")
        print("="*80)
        print()

    # 创建水锤求解器
    solver = WaterHammerMOCSolver(
        L=L,
        D=D,
        f=f,
        wave_speed=a
    )

    # 设置网格
    nx = 51  # 空间节点数
    cfl = 1.0  # CFL数
    solver.set_grid(nx=nx, cfl=cfl)

    if verbose:
        print(f"【数值设置】")
        print(f"  空间节点: nx = {nx}")
        print(f"  时间步长: dt = {solver.dt:.4f} s")
        print(f"  CFL数: {cfl}")
        print()

    # 边界条件
    # 上游：固定水头（水库）
    H0_up = 100.0  # 上游水库水位
    bc_upstream = WaterHammerBoundary('reservoir', value=H0_up)

    # 下游：阀门瞬间关闭（模拟停电）
    def valve_closure(t):
        """阀门开度函数（停电时瞬间关闭）"""
        if t < 0.1:  # 0.1秒前正常运行
            return 1.0
        else:  # 停电后瞬间关闭
            return 0.0

    bc_downstream = WaterHammerBoundary('valve', closure_function=valve_closure)

    if verbose:
        print(f"【边界条件】")
        print(f"  上游: 固定水头 H = {H0_up:.1f} m")
        print(f"  下游: 阀门瞬间关闭 (t = 0.1s)")
        print()

        # 求解
        print(f"【开始数值模拟】")

    result = solver.solve_transient(
        Q0=Q0,
        H0_up=H0_up,
        bc_upstream=bc_upstream,
        bc_downstream=bc_downstream,
        duration=duration
    )

    if verbose:
        print(f"   模拟完成，时长 {duration:.1f}s")
        print()

    return solver, result, H0_up


def analyze_results(solver, result, H0_up, delta_H_jouk):
    """分析模拟结果"""
    print("="*80)
    print("水锤分析结果")
    print("="*80)
    print()

    H = result['H']
    Q = result['Q']
    t = result['t']
    x = result['x']

    # 找到最大和最小压力
    H_max = np.max(H)
    H_min = np.min(H)

    # 找到最大压力发生的时间和位置
    idx_max = np.unravel_index(np.argmax(H), H.shape)
    t_max, x_max = t[idx_max[0]], x[idx_max[1]]

    # 找到最小压力发生的时间和位置
    idx_min = np.unravel_index(np.argmin(H), H.shape)
    t_min, x_min = t[idx_min[0]], x[idx_min[1]]

    print(f"【压力统计】")
    print(f"  初始水头: H0 = {H0_up:.2f} m")
    print(f"  最大水头: H_max = {H_max:.2f} m (t={t_max:.2f}s, x={x_max:.0f}m)")
    print(f"  最小水头: H_min = {H_min:.2f} m (t={t_min:.2f}s, x={x_min:.0f}m)")
    print(f"  压力升高: ΔH_max = {H_max - H0_up:.2f} m")
    print(f"  压力下降: ΔH_min = {H0_up - H_min:.2f} m")
    print()

    print(f"【理论对比】")
    print(f"  Joukowsky理论: ΔH = {delta_H_jouk:.2f} m")
    print(f"  数值模拟结果: ΔH = {H_max - H0_up:.2f} m")
    error = abs((H_max - H0_up) - delta_H_jouk) / delta_H_jouk * 100
    print(f"  相对误差: {error:.1f}%")

    if error < 10:
        print(f"   数值结果与理论吻合良好")
    else:
        print(f"  ️ 数值结果与理论存在偏差（可能受摩阻影响）")
    print()

    print(f"【安全评估】")
    # 假设管道设计压力为150m
    P_design = 150.0
    if H_max > P_design:
        print(f"   最大水头 {H_max:.0f}m 超过设计压力 {P_design:.0f}m")
        print(f"     超压: {H_max - P_design:.0f}m ({(H_max-P_design)/P_design*100:.1f}%)")
        print(f"     必须采取防护措施！")
    elif H_max > 0.9 * P_design:
        print(f"  ️ 最大水头 {H_max:.0f}m 接近设计压力 {P_design:.0f}m")
        print(f"     安全裕度较小，建议采取防护措施")
    else:
        print(f"   最大水头 {H_max:.0f}m < 设计压力 {P_design:.0f}m")
        print(f"     安全裕度: {P_design - H_max:.0f}m")

    # 检查负压
    if H_min < 0:
        print(f"   出现负压 {H_min:.0f}m！")
        print(f"     可能产生气穴和水柱分离")
        print(f"     必须安装空气阀或其他防护设备")
    elif H_min < 20:
        print(f"  ️ 最小水头 {H_min:.0f}m 过低")
        print(f"     建议安装空气阀")
    else:
        print(f"   最小水头 {H_min:.0f}m > 0，无负压风险")

    print()

    return H_max, H_min


def plot_results(solver, result, Q0, H0_up, delta_H_jouk):
    """绘制结果图表"""
    H = result['H']
    Q = result['Q']
    t = result['t']
    x = result['x']

    fig = plt.figure(figsize=(16, 10))
    gs = fig.add_gridspec(3, 2, hspace=0.3, wspace=0.3)

    # 子图1: 管道末端水头时程
    ax1 = fig.add_subplot(gs[0, 0])
    ax1.plot(t, H[:, -1], 'b-', linewidth=2, label='Numerical')
    ax1.axhline(y=H0_up, color='g', linestyle='--', label='Initial Head')
    ax1.axhline(y=H0_up + delta_H_jouk, color='r', linestyle='--',
               label=f'Joukowsky (+{delta_H_jouk:.1f}m)')
    ax1.set_xlabel('Time (s)', fontsize=11)
    ax1.set_ylabel('Head (m)', fontsize=11)
    ax1.set_title('Head at Downstream End', fontsize=13, fontweight='bold')
    ax1.legend()
    ax1.grid(alpha=0.3)

    # 子图2: 管道末端流量时程
    ax2 = fig.add_subplot(gs[0, 1])
    ax2.plot(t, Q[:, -1]*1000, 'r-', linewidth=2)
    ax2.axhline(y=Q0*1000, color='g', linestyle='--', label='Initial Flow')
    ax2.set_xlabel('Time (s)', fontsize=11)
    ax2.set_ylabel('Flow Rate (L/s)', fontsize=11)
    ax2.set_title('Flow at Downstream End', fontsize=13, fontweight='bold')
    ax2.legend()
    ax2.grid(alpha=0.3)

    # 子图3: 水头时空分布（前5秒）
    ax3 = fig.add_subplot(gs[1, :])
    t_indices = t <= 5.0
    X, T = np.meshgrid(x, t[t_indices])
    contour = ax3.contourf(X, T, H[t_indices, :], levels=20, cmap='RdYlBu_r')
    cbar = plt.colorbar(contour, ax=ax3)
    cbar.set_label('Head (m)', fontsize=11)
    ax3.set_xlabel('Distance (m)', fontsize=11)
    ax3.set_ylabel('Time (s)', fontsize=11)
    ax3.set_title('Head Distribution (First 5s)', fontsize=13, fontweight='bold')

    # 子图4: 最大/最小压力包络线
    ax4 = fig.add_subplot(gs[2, 0])
    H_max_envelope = np.max(H, axis=0)
    H_min_envelope = np.min(H, axis=0)
    ax4.fill_between(x, H_min_envelope, H_max_envelope, alpha=0.3, color='blue', label='Pressure Envelope')
    ax4.plot(x, H_max_envelope, 'r-', linewidth=2, label='Max Head')
    ax4.plot(x, H_min_envelope, 'b-', linewidth=2, label='Min Head')
    ax4.axhline(y=H0_up, color='g', linestyle='--', label='Initial Head')
    ax4.set_xlabel('Distance (m)', fontsize=11)
    ax4.set_ylabel('Head (m)', fontsize=11)
    ax4.set_title('Pressure Envelope', fontsize=13, fontweight='bold')
    ax4.legend()
    ax4.grid(alpha=0.3)

    # 子图5: 特定位置水头变化（多个位置）
    ax5 = fig.add_subplot(gs[2, 1])
    positions = [0, len(x)//4, len(x)//2, 3*len(x)//4, -1]
    labels = ['x=0', 'x=L/4', 'x=L/2', 'x=3L/4', 'x=L']
    colors = ['blue', 'green', 'orange', 'red', 'purple']

    for pos, label, color in zip(positions, labels, colors):
        ax5.plot(t, H[:, pos], color=color, label=label, linewidth=1.5)

    ax5.set_xlabel('Time (s)', fontsize=11)
    ax5.set_ylabel('Head (m)', fontsize=11)
    ax5.set_title('Head at Different Locations', fontsize=13, fontweight='bold')
    ax5.legend()
    ax5.grid(alpha=0.3)

    plt.savefig('examples/pump_water_hammer_results.png', dpi=150, bbox_inches='tight')
    print(" 结果图表已保存: examples/pump_water_hammer_results.png")
    plt.close()



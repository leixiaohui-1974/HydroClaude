from solvers.gate import Spillway, Transition, Drop, BroadCrestedWeir


def demo_spillway():
    """Demonstrate spillway hydraulics"""

    print("\n" + "=" * 80)
    print("DEMONSTRATION 1: SPILLWAY HYDRAULICS")
    print("=" * 80)

    # Create three types of spillways
    spillways = {
        'WES Standard': Spillway(
            position=0.0,
            width=50.0,
            crest_elevation=100.0,
            spillway_type='wes',
            Cd=2.1
        ),
        'Ogee': Spillway(
            position=100.0,
            width=50.0,
            crest_elevation=100.0,
            spillway_type='ogee',
            Cd=2.1
        ),
        'Broad-Crested': Spillway(
            position=200.0,
            width=50.0,
            crest_elevation=100.0,
            spillway_type='broad_crested',
            Cd=0.848
        )
    }

    # Test different heads
    heads = [1.0, 2.0, 3.0, 5.0, 10.0, 15.0]  # Head above crest (m)

    print("\n1.1 Free Flow Discharge (No Submergence)")
    print("-" * 80)
    print(f"{'Head (m)':>10} {'WES Q (m³/s)':>15} {'Ogee Q (m³/s)':>15} {'Broad Q (m³/s)':>15} {'Specific q':>15}")
    print("-" * 80)

    results = {name: [] for name in spillways.keys()}

    for H in heads:
        h_upstream = 100.0 + H  # Water level
        h_downstream = 95.0  # Below crest (free flow)

        row_data = [H]
        for name, spillway in spillways.items():
            Q, flow_type = spillway.calculate_discharge(h_upstream, h_downstream)
            results[name].append(Q)
            row_data.append(Q)

        q = row_data[1] / 50.0  # Specific discharge (m³/s per m)
        print(f"{row_data[0]:>10.1f} {row_data[1]:>15.2f} {row_data[2]:>15.2f} {row_data[3]:>15.2f} {q:>15.2f}")

    # Plot rating curves
    plt.figure(figsize=(12, 5))

    plt.subplot(1, 2, 1)
    for name, Q_values in results.items():
        plt.plot(Q_values, heads, 'o-', linewidth=2, label=name, markersize=6)
    plt.xlabel('Discharge (m³/s)', fontsize=11)
    plt.ylabel('Head above crest (m)', fontsize=11)
    plt.title('Spillway Rating Curves (Free Flow)', fontsize=12, fontweight='bold')
    plt.grid(True, alpha=0.3)
    plt.legend()

    # Test submergence for WES spillway
    print("\n1.2 Submergence Effect (WES Spillway)")
    print("-" * 80)
    print(f"{'H_up (m)':>10} {'H_down (m)':>12} {'Submergence':>12} {'Q_free (m³/s)':>15} {'Q_sub (m³/s)':>15} {'Reduction':>12}")
    print("-" * 80)

    wes = spillways['WES Standard']
    H = 5.0  # Fixed upstream head
    h_upstream = 100.0 + H

    Q_free, _ = wes.calculate_discharge(h_upstream, 95.0)

    submergence_ratios = []
    Q_submerged = []

    downstream_levels = [98.0, 99.0, 100.0, 101.0, 102.0, 103.0, 104.0]

    for h_down in downstream_levels:
        Q, flow_type = wes.calculate_discharge(h_upstream, h_down)
        sub_ratio = max(0, (h_down - 100.0) / H)
        reduction = (1.0 - Q / Q_free) * 100

        submergence_ratios.append(sub_ratio)
        Q_submerged.append(Q)

        print(f"{H:>10.1f} {h_down-100:>12.1f} {sub_ratio:>12.2f} {Q_free:>15.2f} {Q:>15.2f} {reduction:>11.1f}%")

    plt.subplot(1, 2, 2)
    plt.plot(submergence_ratios, [q/Q_free for q in Q_submerged], 'ro-', linewidth=2, markersize=6)
    plt.xlabel('Submergence Ratio (H_down/H_up)', fontsize=11)
    plt.ylabel('Discharge Ratio (Q/Q_free)', fontsize=11)
    plt.title('Submergence Effect on Discharge', fontsize=12, fontweight='bold')
    plt.grid(True, alpha=0.3)
    plt.axhline(y=1.0, color='k', linestyle='--', alpha=0.3)
    plt.axvline(x=0.67, color='r', linestyle='--', alpha=0.3, label='Threshold (0.67)')
    plt.legend()

    plt.tight_layout()
    plt.savefig('/home/user/HydroClaude/examples/example_02_spillway_cascade/spillway_demo.png', dpi=150)
    print(f"\nSpillway rating curves saved to: spillway_demo.png")


def demo_transition():
    """Demonstrate channel transitions"""

    print("\n" + "=" * 80)
    print("DEMONSTRATION 2: CHANNEL TRANSITIONS")
    print("=" * 80)

    # Expansion transition
    expansion = Transition(
        position=0.0,
        width_upstream=10.0,
        width_downstream=20.0,  # 2:1 expansion
        K_loss=0.3
    )

    # Contraction transition
    contraction = Transition(
        position=100.0,
        width_upstream=20.0,
        width_downstream=10.0,  # 2:1 contraction
        K_loss=0.1
    )

    print("\n2.1 Expansion (10m → 20m, K_loss=0.3)")
    print("-" * 80)
    print(f"{'h_up (m)':>10} {'h_down (m)':>12} {'Δh (m)':>10} {'Q (m³/s)':>12} {'V_up (m/s)':>12} {'V_down (m/s)':>12}")
    print("-" * 80)

    h_upstream_values = [5.0, 5.0, 5.0, 5.0, 5.0]
    h_downstream_values = [4.9, 4.8, 4.7, 4.5, 4.0]

    for h_up, h_down in zip(h_upstream_values, h_downstream_values):
        Q, flow_type = expansion.calculate_discharge(h_up, h_down)
        V_up = Q / (expansion.width_upstream * h_up) if Q > 0 else 0
        V_down = Q / (expansion.width_downstream * h_down) if Q > 0 else 0
        delta_h = h_up - h_down

        print(f"{h_up:>10.1f} {h_down:>12.1f} {delta_h:>10.2f} {Q:>12.2f} {V_up:>12.2f} {V_down:>12.2f}")

    print("\n2.2 Contraction (20m → 10m, K_loss=0.1)")
    print("-" * 80)
    print(f"{'h_up (m)':>10} {'h_down (m)':>12} {'Δh (m)':>10} {'Q (m³/s)':>12} {'V_up (m/s)':>12} {'V_down (m/s)':>12}")
    print("-" * 80)

    h_upstream_values = [5.0, 5.0, 5.0, 5.0, 5.0]
    h_downstream_values = [5.1, 5.2, 5.3, 5.5, 6.0]

    for h_up, h_down in zip(h_upstream_values, h_downstream_values):
        Q, flow_type = contraction.calculate_discharge(h_up, h_down)
        V_up = Q / (contraction.width_upstream * h_up) if Q > 0 else 0
        V_down = Q / (contraction.width_downstream * h_down) if Q > 0 else 0
        delta_h = h_down - h_up

        print(f"{h_up:>10.1f} {h_down:>12.1f} {delta_h:>10.2f} {Q:>12.2f} {V_up:>12.2f} {V_down:>12.2f}")


def demo_drop():
    """Demonstrate hydraulic drop"""

    print("\n" + "=" * 80)
    print("DEMONSTRATION 3: HYDRAULIC DROP")
    print("=" * 80)

    # Hydraulic drop
    drop = Drop(
        position=0.0,
        width=10.0,
        drop_height=3.0,
        Cd=0.6
    )

    print(f"\nDrop Configuration: Width = {drop.width}m, Height = {drop.drop_height}m, Cd = {drop.Cd}")
    print("\n3.1 Flow vs Upstream Depth")
    print("-" * 80)
    print(f"{'h_up (m)':>10} {'Total Head (m)':>15} {'Q (m³/s)':>12} {'V (m/s)':>12} {'Fr':>10}")
    print("-" * 80)

    depths = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0]
    Q_values = []

    for h_up in depths:
        Q, flow_type = drop.calculate_discharge(h_up, None)
        V = Q / (drop.width * h_up) if h_up > 0 else 0
        Fr = V / np.sqrt(9.81 * h_up) if h_up > 0 else 0
        total_head = h_up + drop.drop_height

        Q_values.append(Q)
        print(f"{h_up:>10.1f} {total_head:>15.1f} {Q:>12.2f} {V:>12.2f} {Fr:>10.2f}")

    # Test derivative accuracy
    print("\n3.2 Analytical Derivative Verification")
    print("-" * 80)
    print(f"{'h_up (m)':>10} {'dQ/dh_analytical':>18} {'dQ/dh_numerical':>18} {'Error (%)':>12}")
    print("-" * 80)

    for h_up in [1.0, 2.0, 3.0, 5.0]:
        dQ_dh_up, _ = drop.calculate_discharge_derivatives(h_up, None)

        # Numerical derivative
        eps = 1e-5
        Q0, _ = drop.calculate_discharge(h_up, None)
        Q1, _ = drop.calculate_discharge(h_up + eps, None)
        dQ_dh_num = (Q1 - Q0) / eps

        error = abs(dQ_dh_up - dQ_dh_num) / abs(dQ_dh_num) * 100

        print(f"{h_up:>10.1f} {dQ_dh_up:>18.4f} {dQ_dh_num:>18.4f} {error:>11.2f}%")

    # Plot
    plt.figure(figsize=(10, 5))

    plt.subplot(1, 2, 1)
    plt.plot(depths, Q_values, 'bo-', linewidth=2, markersize=8)
    plt.xlabel('Upstream Depth (m)', fontsize=11)
    plt.ylabel('Discharge (m³/s)', fontsize=11)
    plt.title(f'Drop Discharge vs Depth (Δz={drop.drop_height}m)', fontsize=12, fontweight='bold')
    plt.grid(True, alpha=0.3)

    plt.subplot(1, 2, 2)
    specific_q = [Q / drop.width for Q in Q_values]
    plt.plot(depths, specific_q, 'ro-', linewidth=2, markersize=8)
    plt.xlabel('Upstream Depth (m)', fontsize=11)
    plt.ylabel('Specific Discharge (m³/s/m)', fontsize=11)
    plt.title('Specific Discharge per Unit Width', fontsize=12, fontweight='bold')
    plt.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig('/home/user/HydroClaude/examples/example_02_spillway_cascade/drop_demo.png', dpi=150)
    print(f"\nDrop characteristics saved to: drop_demo.png")



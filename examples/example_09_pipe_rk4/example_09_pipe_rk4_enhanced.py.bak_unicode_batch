        ax.set_ylabel('Pressure Head (m)', fontsize=11)
        ax.set_title(f'Pressure Wave Propagation (Time = {frame*dt:.2f} s)',
                    fontsize=12, fontweight='bold')
        ax.grid(True, alpha=0.3)
        ax.set_xlim([x[0], x[-1]])

        # 动态Y轴
        all_pressures = np.array(spatial_pressure)
        y_min, y_max = all_pressures.min(), all_pressures.max()
        y_margin = (y_max - y_min) * 0.1 if y_max > y_min else 1
        ax.set_ylim([y_min - y_margin, y_max + y_margin])

        # 阀门关闭标记
        if frame * dt >= valve_close_time:
            ax.text(0.02, 0.95, 'Valve Closed', transform=ax.transAxes,
                   fontsize=10, verticalalignment='top', color='red',
                   bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))

        # 流量分布
        ax = axes[1]
        ax.plot(x, spatial_flow[frame], 's-', linewidth=2.5, markersize=5,
                color='#2ECC71', markeredgecolor='black', markeredgewidth=0.5)
        ax.set_xlabel('Distance (m)', fontsize=11)
        ax.set_ylabel('Flow Rate (m³/s)', fontsize=11)
        ax.set_title(f'Flow Distribution', fontsize=12)
        ax.grid(True, alpha=0.3)
        ax.set_xlim([x[0], x[-1]])

        # 动态Y轴

        y_min, y_max = all_flows.min(), all_flows.max()
        y_margin = (y_max - y_min) * 0.1 if y_max > y_min else 0.1
        ax.set_ylim([y_min - y_margin, y_max + y_margin])

        plt.tight_layout()

    # 每2步一个关键帧
    keyframes = list(range(0, n_steps, 2))

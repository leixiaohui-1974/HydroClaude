#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
动画预览工具

生成美观的HTML页面，预览所有GIF动画

使用方法:
    python preview_animations.py                    # 生成preview.html
    python preview_animations.py --output my.html   # 自定义输出文件名
    python preview_animations.py --open            # 生成后自动打开

作者: Claude
日期: 2025-10-22
"""

import sys
import os
from pathlib import Path
import argparse
from datetime import datetime


def get_animation_info(gif_path):
    """
    获取GIF动画信息

    Parameters
    ----------
    gif_path : Path
        GIF文件路径

    Returns
    -------
    dict
        包含文件名、大小、尺寸等信息的字典
    """
    info = {
        'name': gif_path.name,
        'path': str(gif_path.relative_to(gif_path.parents[3])),  # 相对于examples目录
        'size_kb': gif_path.stat().st_size / 1024,
        'size_mb': gif_path.stat().st_size / (1024 * 1024),
    }

    # 尝试获取GIF尺寸和帧数
    try:
        from PIL import Image
        with Image.open(gif_path) as img:
            info['width'] = img.width
            info['height'] = img.height
            info['frames'] = getattr(img, 'n_frames', 1)
            info['mode'] = img.mode
    except:
        info['width'] = '?'
        info['height'] = '?'
        info['frames'] = '?'
        info['mode'] = '?'

    return info


def generate_preview_html(examples_dir='.', output_file='preview.html'):
    """
    生成动画预览HTML页面

    Parameters
    ----------
    examples_dir : str
        examples目录路径
    output_file : str
        输出HTML文件名
    """
    examples_dir = Path(examples_dir)

    # 查找所有GIF文件
    gif_files = sorted(examples_dir.glob('example_*/outputs/animations/*.gif'))

    if not gif_files:
        print("未找到GIF文件")
        return None

    print(f"找到 {len(gif_files)} 个GIF动画")

    # 收集信息
    animations = []
    total_size = 0

    for gif_file in gif_files:
        info = get_animation_info(gif_file)
        animations.append(info)
        total_size += info['size_kb']

        # 提取示例名称
        example_name = gif_file.parts[-4]  # example_XX_name
        info['example'] = example_name

    # 生成HTML
    html = f"""<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HydroClaude 动画预览</title>
    <style>
        * {{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }}

        body {{
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            padding: 20px;
            min-height: 100vh;
        }}

        .container {{
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
        }}

        header {{
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 30px;
            border-bottom: 3px solid #667eea;
        }}

        h1 {{
            color: #667eea;
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }}

        .subtitle {{
            color: #666;
            font-size: 1.1em;
            margin-top: 10px;
        }}

        .stats {{
            display: flex;
            justify-content: center;
            gap: 40px;
            margin: 30px 0;
            flex-wrap: wrap;
        }}

        .stat-item {{
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px 30px;
            border-radius: 15px;
            text-align: center;
            min-width: 150px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }}

        .stat-value {{
            font-size: 2em;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }}

        .stat-label {{
            font-size: 0.9em;
            opacity: 0.9;
        }}

        .search-bar {{
            margin: 30px 0;
            text-align: center;
        }}

        .search-input {{
            width: 60%;
            max-width: 500px;
            padding: 15px 20px;
            font-size: 1em;
            border: 2px solid #ddd;
            border-radius: 50px;
            outline: none;
            transition: all 0.3s;
        }}

        .search-input:focus {{
            border-color: #667eea;
            box-shadow: 0 0 20px rgba(102, 126, 234, 0.2);
        }}

        .animations-grid {{
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }}

        .animation-card {{
            background: #f8f9fa;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
            cursor: pointer;
        }}

        .animation-card:hover {{
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.2);
        }}

        .animation-preview {{
            width: 100%;
            height: 300px;
            object-fit: contain;
            background: #fff;
            padding: 10px;
        }}

        .animation-info {{
            padding: 20px;
        }}

        .animation-name {{
            font-size: 1.1em;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
            word-break: break-word;
        }}

        .animation-example {{
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-bottom: 10px;
        }}

        .animation-details {{
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            font-size: 0.9em;
            color: #666;
            margin-top: 15px;
        }}

        .detail-item {{
            display: flex;
            justify-content: space-between;
            padding: 8px;
            background: white;
            border-radius: 8px;
        }}

        .detail-label {{
            font-weight: 600;
        }}

        .detail-value {{
            color: #667eea;
        }}

        .size-badge {{
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.85em;
            font-weight: 600;
        }}

        .size-small {{
            background: #d4edda;
            color: #155724;
        }}

        .size-medium {{
            background: #fff3cd;
            color: #856404;
        }}

        .size-large {{
            background: #f8d7da;
            color: #721c24;
        }}

        footer {{
            text-align: center;
            margin-top: 50px;
            padding-top: 30px;
            border-top: 2px solid #eee;
            color: #999;
        }}

        .modal {{
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.9);
            align-items: center;
            justify-content: center;
        }}

        .modal-content {{
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }}

        .close {{
            position: absolute;
            top: 20px;
            right: 40px;
            color: #f1f1f1;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
        }}

        .close:hover {{
            color: #bbb;
        }}

        @media (max-width: 768px) {{
            .animations-grid {{
                grid-template-columns: 1fr;
            }}

            .search-input {{
                width: 90%;
            }}

            .stats {{
                gap: 15px;
            }}

            .stat-item {{
                min-width: 120px;
                padding: 15px 20px;
            }}
        }}
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1> HydroClaude 动画预览</h1>
            <p class="subtitle">水力学仿真动画可视化展示</p>

            <div class="stats">
                <div class="stat-item">
                    <span class="stat-value">{len(animations)}</span>
                    <span class="stat-label">动画总数</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">{total_size/1024:.1f}</span>
                    <span class="stat-label">总大小 (MB)</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">{len(set(a['example'] for a in animations))}</span>
                    <span class="stat-label">示例数量</span>
                </div>
            </div>
        </header>

        <div class="search-bar">
            <input type="text" class="search-input" id="searchInput" placeholder="搜索动画名称或示例...">
        </div>

        <div class="animations-grid" id="animationsGrid">
"""

    # 添加每个动画卡片
    for anim in animations:
        size_class = 'size-small' if anim['size_kb'] < 800 else ('size-medium' if anim['size_kb'] < 1500 else 'size-large')

        html += f"""
            <div class="animation-card" data-name="{anim['name'].lower()}" data-example="{anim['example'].lower()}">
                <img src="{anim['path']}" alt="{anim['name']}" class="animation-preview" onclick="openModal(this.src)">
                <div class="animation-info">
                    <div class="animation-example">{anim['example']}</div>
                    <div class="animation-name">{anim['name']}</div>
                    <div class="animation-details">
                        <div class="detail-item">
                            <span class="detail-label">尺寸</span>
                            <span class="detail-value">{anim['width']}x{anim['height']}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">帧数</span>
                            <span class="detail-value">{anim['frames']}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">大小</span>
                            <span class="detail-value size-badge {size_class}">{anim['size_kb']:.0f} KB</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">模式</span>
                            <span class="detail-value">{anim['mode']}</span>
                        </div>
                    </div>
                </div>
            </div>
"""

    # 添加模态框和脚本
    html += f"""
        </div>

        <footer>
            <p>生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}</p>
            <p>HydroClaude Examples - Animation Preview</p>
        </footer>
    </div>

    <!-- 模态框 -->
    <div id="myModal" class="modal" onclick="closeModal()">
        <span class="close">&times;</span>
        <img class="modal-content" id="modalImg">
    </div>

    <script>
        // 搜索功能
        document.getElementById('searchInput').addEventListener('input', function(e) {{
            const searchTerm = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.animation-card');

            cards.forEach(card => {{
                const name = card.getAttribute('data-name');
                const example = card.getAttribute('data-example');

                if (name.includes(searchTerm) || example.includes(searchTerm)) {{
                    card.style.display = 'block';
                }} else {{
                    card.style.display = 'none';
                }}
            }});
        }});

        // 模态框功能
        function openModal(src) {{
            const modal = document.getElementById('myModal');
            const modalImg = document.getElementById('modalImg');
            modal.style.display = 'flex';
            modalImg.src = src;
        }}

        function closeModal() {{
            document.getElementById('myModal').style.display = 'none';
        }}

        // ESC键关闭模态框
        document.addEventListener('keydown', function(e) {{
            if (e.key === 'Escape') {{
                closeModal();
            }}
        }});
    </script>
</body>
</html>
"""

    # 保存HTML
    output_path = examples_dir / output_file
    output_path.write_text(html, encoding='utf-8')

    print(f"\n 预览页面已生成: {output_path}")
    print(f"  总计 {len(animations)} 个动画")
    print(f"  总大小 {total_size/1024:.2f} MB")

    return str(output_path)


def main():
    """主函数"""
    parser = argparse.ArgumentParser(
        description='动画预览工具 - 生成HTML预览页面'
    )

    parser.add_argument(
        '--output',
        type=str,
        default='animations_preview.html',
        help='输出HTML文件名（默认：animations_preview.html）'
    )

    parser.add_argument(
        '--examples-dir',
        type=str,
        default='.',
        help='examples目录路径'
    )

    parser.add_argument(
        '--open',
        action='store_true',
        help='生成后自动在浏览器中打开'
    )

    args = parser.parse_args()

    print("\n" + "="*80)
    print("动画预览工具")
    print("="*80)

    output_path = generate_preview_html(
        examples_dir=args.examples_dir,
        output_file=args.output
    )

    if output_path and args.open:
        import webbrowser
        print(f"\n正在打开浏览器...")
        webbrowser.open('file://' + str(Path(output_path).absolute()))

    print("="*80)


if __name__ == '__main__':
    main()

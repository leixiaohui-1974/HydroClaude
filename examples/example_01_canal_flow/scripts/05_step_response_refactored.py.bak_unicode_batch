"""

import numpy as np
import sys
from pathlib import Path

# 使用ScriptHelper进行路径管理
script_path = Path(__file__).resolve()
project_root = script_path.parents[3]
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

from utils.script_helper import ScriptHelper

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from scipy.signal import savgol_filter
import time
from datetime import datetime
import pandas as pd

# 初始化ScriptHelper
helper = ScriptHelper(__file__)

# 配置matplotlib
plt.rcParams['font.size'] = 11
plt.rcParams['axes.titlesize'] = 13
plt.rcParams['axes.labelsize'] = 12
plt.rcParams['xtick.labelsize'] = 10
plt.rcParams['ytick.labelsize'] = 10
plt.rcParams['legend.fontsize'] = 10

# ============================================================================
# Manning公式求解
# ============================================================================

def compute_steady_uniform_flow(Q, B, S0, n, g=9.81):
    """计算恒定均匀流水深"""
    def manning_equation(h):
        if h <= 0:
            return 1e10
        A = B * h
        P = B + 2 * h
        R = A / P
        Q_calc = (1.0 / n) * A * (R ** (2./3.)) * (S0 ** 0.5)
        return Q_calc - Q

    h_min, h_max = 0.01, 20.0
    if manning_equation(h_min) * manning_equation(h_max) > 0:
        h_est = (Q * n / (B * S0**0.5)) ** (3./5.)
        return max(0.5, min(10.0, h_est))

    while h_max - h_min > 1e-6:
        h_mid = (h_min + h_max) / 2
        if manning_equation(h_mid) * manning_equation(h_min) < 0:
            h_max = h_mid
        else:
            h_min = h_mid

    return (h_min + h_max) / 2


# ============================================================================
# 明渠求解器
# ============================================================================

class CanalSolver:
    """明渠非恒定流求解器"""

    def __init__(self, length=1000.0, nx=201, B=10.0, S0=0.001, n=0.025,
                 g=9.81, method='preissmann'):
        self.length = length
        self.nx = nx
        self.B = B
        self.S0 = S0
        self.n = n
        self.g = g
        self.method = method.lower()

        self.dx = length / (nx - 1)
        self.x = np.linspace(0, length, nx)
        self.h = np.ones(nx) * 1.0
        self.Q = np.ones(nx) * 5.0

        self.filter_window = 11
        self.filter_order = 3
        self.theta = 0.6
        self.omega = 0.95

    def reset_with_steady_state(self, Q0):
        """使用恒定均匀流初值"""
        h_uniform = compute_steady_uniform_flow(Q0, self.B, self.S0, self.n, self.g)
        self.h[:] = h_uniform
        self.Q[:] = Q0
        return h_uniform

    def apply_spatial_filter(self, field):
        """空间滤波"""
        filtered = savgol_filter(field, self.filter_window, self.filter_order, mode='nearest')
        filtered[0] = field[0]
        filtered[-1] = field[-1]
        return filtered

    def compute_friction_slope(self, h, Q):
        """计算摩阻坡度"""
        Sf = np.zeros_like(h)
        for i in range(len(h)):
            if h[i] > 1e-6:
                A = self.B * h[i]
                P = self.B + 2 * h[i]
                R = A / P
                V = Q[i] / A if A > 1e-6 else 0.0
                Sf[i] = (self.n * abs(V)) ** 2 / (R ** (4./3.))
        return Sf

    def step_explicit(self, dt, Q_upstream, h_downstream):
        """显式有限差分"""
        h_old = self.h.copy()
        Q_old = self.Q.copy()
        h_new = h_old.copy()
        Q_new = Q_old.copy()

        Sf = self.compute_friction_slope(h_old, Q_old)
        upwind_ratio = 0.3

        for i in range(1, self.nx - 1):
            if h_old[i] > 1e-6:
                A = self.B * h_old[i]
                V = Q_old[i] / A

                dQ_dx_central = (Q_old[i+1] - Q_old[i-1]) / (2 * self.dx)
                if Q_old[i] >= 0:
                    dQ_dx_upwind = (Q_old[i] - Q_old[i-1]) / self.dx
                else:
                    dQ_dx_upwind = (Q_old[i+1] - Q_old[i]) / self.dx
                dQ_dx = upwind_ratio * dQ_dx_upwind + (1 - upwind_ratio) * dQ_dx_central
                dh_dt = -dQ_dx / self.B
                h_new[i] = h_old[i] + dt * dh_dt

                dh_dx_central = (h_old[i+1] - h_old[i-1]) / (2 * self.dx)
                if Q_old[i] >= 0:
                    dh_dx_upwind = (h_old[i] - h_old[i-1]) / self.dx
                else:
                    dh_dx_upwind = (h_old[i+1] - h_old[i]) / self.dx
                dh_dx = upwind_ratio * dh_dx_upwind + (1 - upwind_ratio) * dh_dx_central

                if Q_old[i] >= 0:
                    dQ_dx_mom = (Q_old[i] - Q_old[i-1]) / self.dx
                else:
                    dQ_dx_mom = (Q_old[i+1] - Q_old[i]) / self.dx

                dQ_dt = -V * dQ_dx_mom - self.g * A * dh_dx + self.g * A * (self.S0 - Sf[i])
                Q_new[i] = Q_old[i] + dt * dQ_dt

        h_new[0] = h_new[1]
        Q_new[0] = Q_upstream
        h_new[-1] = h_downstream
        Q_new[-1] = Q_new[-2]

        h_new = self.apply_spatial_filter(h_new)
        Q_new = self.apply_spatial_filter(Q_new)

        self.h = h_new
        self.Q = Q_new
        return h_new, Q_new

    def step_preissmann(self, dt, Q_upstream, h_downstream):
        """Preissmann四点隐式"""
        h_old = self.h.copy()
        Q_old = self.Q.copy()

        h_pred, Q_pred = self.step_explicit(dt, Q_upstream, h_downstream)

        self.h = self.omega * ((1 - self.theta) * h_old + self.theta * h_pred) + (1 - self.omega) * h_old
        self.Q = self.omega * ((1 - self.theta) * Q_old + self.theta * Q_pred) + (1 - self.omega) * Q_old

        self.h = self.apply_spatial_filter(self.h)
        self.Q = self.apply_spatial_filter(self.Q)

        return self.h, self.Q

    def step_hll(self, dt, Q_upstream, h_downstream):
        """HLL有限体积"""
        h_old = self.h.copy()
        Q_old = self.Q.copy()
        h_new = h_old.copy()
        Q_new = Q_old.copy()

        Sf = self.compute_friction_slope(h_old, Q_old)

        for i in range(1, self.nx - 1):
            h_L = h_old[i]
            h_R = h_old[i+1]
            Q_L = Q_old[i]
            Q_R = Q_old[i+1]

            if h_L > 1e-6 and h_R > 1e-6:
                A_L = self.B * h_L
                A_R = self.B * h_R
                V_L = Q_L / A_L
                V_R = Q_R / A_R
                c_L = np.sqrt(self.g * h_L)
                c_R = np.sqrt(self.g * h_R)

                S_L = min(V_L - c_L, V_R - c_R)
                S_R = max(V_L + c_L, V_R + c_R)

                F1_L = Q_L
                F1_R = Q_R
                F2_L = Q_L * V_L + 0.5 * self.g * self.B * h_L**2
                F2_R = Q_R * V_R + 0.5 * self.g * self.B * h_R**2

                if S_L >= 0:
                    F1 = F1_L
                    F2 = F2_L
                elif S_R <= 0:
                    F1 = F1_R
                    F2 = F2_R
                else:
                    F1 = (S_R * F1_L - S_L * F1_R + S_L * S_R * (A_R - A_L)) / (S_R - S_L)
                    F2 = (S_R * F2_L - S_L * F2_R + S_L * S_R * (Q_R - Q_L)) / (S_R - S_L)

                dh_dt = -(F1 - Q_old[i-1]) / self.dx / self.B
                dQ_dt = -(F2 - (Q_old[i-1]**2/A_L + 0.5*self.g*self.B*h_old[i-1]**2)) / self.dx
                dQ_dt += self.g * A_L * (self.S0 - Sf[i])

                h_new[i] = h_old[i] + dt * dh_dt
                Q_new[i] = Q_old[i] + dt * dQ_dt

        h_new[0] = h_new[1]
        Q_new[0] = Q_upstream
        h_new[-1] = h_downstream
        Q_new[-1] = Q_new[-2]

        h_new = self.apply_spatial_filter(h_new)
        Q_new = self.apply_spatial_filter(Q_new)

        self.h = h_new
        self.Q = Q_new
        return h_new, Q_new

    def step(self, dt, Q_upstream, h_downstream):
        """执行一个时间步"""
        if self.method == 'explicit':
            return self.step_explicit(dt, Q_upstream, h_downstream)
        elif self.method == 'preissmann':
            return self.step_preissmann(dt, Q_upstream, h_downstream)
        elif self.method == 'hll':
            return self.step_hll(dt, Q_upstream, h_downstream)


# ============================================================================
# 阶跃响应对比测试
# ============================================================================

def run_step_response_comparison():
    """运行阶跃响应对比测试"""

    print("="*80)
    print("Step Response Comparison Test - 3 Numerical Methods (ScriptHelper)")
    print("="*80)
    print(f"Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("="*80)

    # 物理参数
    length = 1000.0
    B = 10.0
    S0 = 0.001
    n = 0.025
    g = 9.81

    # 数值参数
    nx = 201
    dt = 0.5
    T_total = 800.0
    n_steps = int(T_total / dt)

    # 边界条件设置
    Q_initial = 8.0      # 初始上游流量 (m³/s)
    Q_step = 10.0        # 阶跃后流量 (m³/s)
    t_step = 100.0       # 阶跃时刻 (s)

    # 下游水位（初始时根据初始流量计算）
    h_downstream_initial = compute_steady_uniform_flow(Q_initial, B, S0, n, g)

    print(f"\nPhysical Parameters:")
    print(f"  Channel Length = {length} m")
    print(f"  Channel Width  = {B} m")
    print(f"  Bed Slope      = {S0}")
    print(f"  Manning's n    = {n}")

    print(f"\nBoundary Conditions:")
    print(f"  Upstream Flow (initial)  = {Q_initial} m³/s")
    print(f"  Upstream Flow (step)     = {Q_step} m³/s  (at t = {t_step} s)")
    print(f"  Downstream Depth (init)  = {h_downstream_initial:.4f} m")

    print(f"\nNumerical Parameters:")
    print(f"  Grid Points nx = {nx}")
    print(f"  Grid Spacing   = {length/(nx-1):.2f} m")
    print(f"  Time Step      = {dt} s")
    print(f"  Total Time     = {T_total} s")

    # 运行三种方法
    methods = ['EXPLICIT', 'PREISSMANN', 'HLL']
    results = {}
    colors = {'EXPLICIT': '#1f77b4', 'PREISSMANN': '#ff7f0e', 'HLL': '#2ca02c'}

    for method_name in methods:
        print(f"\n{'='*80}")
        print(f"Running: {method_name}")
        print(f"{'='*80}")

        solver = CanalSolver(length=length, nx=nx, B=B, S0=S0, n=n, g=g,
                            method=method_name.lower())
        solver.reset_with_steady_state(Q_initial)

        # 记录数据
        time_history = []
        h_history = []
        Q_history = []
        h_upstream_history = []
        h_downstream_history = []
        Q_upstream_history = []

        idx_upstream = 5
        idx_downstream = nx - 6

        # 时间积分
        t_start = time.time()

        for step in range(n_steps):
            t = step * dt

            # 阶跃边界条件
            if t < t_step:
                Q_bc = Q_initial
                h_bc = h_downstream_initial
            else:
                Q_bc = Q_step
                # 下游水位保持为阶跃后对应的稳态值
                h_bc = compute_steady_uniform_flow(Q_step, B, S0, n, g)

            solver.step(dt, Q_bc, h_bc)

            # 每5步记录一次
            if step % 5 == 0:
                time_history.append(t)
                h_history.append(solver.h.copy())
                Q_history.append(solver.Q.copy())
                h_upstream_history.append(solver.h[idx_upstream])
                h_downstream_history.append(solver.h[idx_downstream])
                Q_upstream_history.append(solver.Q[idx_upstream])

            if (step + 1) % 400 == 0:
                print(f"  Step {step+1}/{n_steps}: t={t:.1f}s, "
                      f"h_up={solver.h[idx_upstream]:.4f}m, "
                      f"h_down={solver.h[idx_downstream]:.4f}m, "
                      f"Q_up={solver.Q[idx_upstream]:.4f}m³/s")

        t_end = time.time()
        comp_time = t_end - t_start

        print(f"\nComputation completed:")
        print(f"  Time  = {comp_time:.2f} s")
        print(f"  Speed = {n_steps/comp_time:.1f} steps/s")

        # 保存结果
        results[method_name] = {
            'time': np.array(time_history),
            'h_history': h_history,
            'Q_history': Q_history,
            'h_upstream': np.array(h_upstream_history),
            'h_downstream': np.array(h_downstream_history),
            'Q_upstream': np.array(Q_upstream_history),
            'x': solver.x,
            'comp_time': comp_time
        }

    # 生成对比图
    print(f"\n{'='*80}")
    print("Generating Comparison Plots...")
    print(f"{'='*80}")



    # 创建综合对比图
    fig = plt.figure(figsize=(18, 12))
    gs = fig.add_gridspec(3, 3, hspace=0.3, wspace=0.3)

    # 第一行：时间演化对比
    ax1 = fig.add_subplot(gs[0, :])
    ax1.set_title('Upstream Discharge Time History (Step Response)', fontsize=14, fontweight='bold')
    for method in methods:
        r = results[method]
        ax1.plot(r['time'], r['Q_upstream'], color=colors[method], linewidth=2.5,
                label=method, alpha=0.8)
    ax1.axvline(t_step, color='red', linestyle='--', linewidth=1.5, alpha=0.7,
               label=f'Step Time = {t_step}s')
    ax1.axhline(Q_initial, color='gray', linestyle=':', linewidth=1, alpha=0.5)
    ax1.axhline(Q_step, color='gray', linestyle=':', linewidth=1, alpha=0.5)
    ax1.set_xlabel('Time (s)', fontsize=12)
    ax1.set_ylabel('Discharge (m³/s)', fontsize=12)
    ax1.grid(True, alpha=0.3)
    ax1.legend(fontsize=11, loc='best')
    ax1.set_ylim([Q_initial - 0.5, Q_step + 0.5])

    # 第二行：下游水深时间演化
    ax2 = fig.add_subplot(gs[1, :])
    ax2.set_title('Downstream Water Depth Time History', fontsize=14, fontweight='bold')
    for method in methods:
        r = results[method]
        ax2.plot(r['time'], r['h_downstream'], color=colors[method], linewidth=2.5,
                label=method, alpha=0.8)
    ax2.axvline(t_step, color='red', linestyle='--', linewidth=1.5, alpha=0.7,
               label=f'Step Time = {t_step}s')
    ax2.set_xlabel('Time (s)', fontsize=12)
    ax2.set_ylabel('Water Depth (m)', fontsize=12)
    ax2.grid(True, alpha=0.3)
    ax2.legend(fontsize=11, loc='best')

    # 第三行：空间分布对比（选3个时刻）
    times_to_plot = [t_step - 10, t_step + 100, T_total - 10]
    time_labels = ['Before Step', 'After Step', 'Final']

    for i, (t_plot, label) in enumerate(zip(times_to_plot, time_labels)):
        ax = fig.add_subplot(gs[2, i])

        # 找到最接近的时间索引
        for method in methods:
            r = results[method]
            idx_time = np.argmin(np.abs(r['time'] - t_plot))
            h_spatial = r['h_history'][idx_time]

            ax.plot(r['x'], h_spatial, color=colors[method], linewidth=2.5,
                   label=method, alpha=0.8)

        ax.set_xlabel('Distance (m)', fontsize=11)
        ax.set_ylabel('Water Depth (m)', fontsize=11)
        ax.set_title(f'{label} (t = {t_plot:.0f}s)', fontsize=12, fontweight='bold')
        ax.grid(True, alpha=0.3)
        if i == 2:
            ax.legend(fontsize=10, loc='best')

    fig.suptitle('Step Response Comparison: 3 Numerical Methods\n' +
                f'(Q: {Q_initial} → {Q_step} m³/s at t = {t_step}s)',
                fontsize=16, fontweight='bold', y=0.995)

    fig_path = helper.get_output_path('05_step_response_methods_comparison_refactored.png', subdir='figures')
    plt.savefig(fig_path, dpi=150, bbox_inches='tight')
    print(f"   Saved figure: {fig_path.name}")
    plt.close()

    # 创建详细对比图（叠加显示）
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))

    # 上游流量
    ax = axes[0, 0]
    for method in methods:
        r = results[method]
        ax.plot(r['time'], r['Q_upstream'], color=colors[method], linewidth=2,
               label=method, alpha=0.7)
    ax.axvline(t_step, color='red', linestyle='--', linewidth=1.5, alpha=0.6)
    ax.set_xlabel('Time (s)', fontsize=11)
    ax.set_ylabel('Upstream Discharge (m³/s)', fontsize=11)
    ax.set_title('Upstream Discharge Response', fontsize=12, fontweight='bold')
    ax.grid(True, alpha=0.3)
    ax.legend(fontsize=10)
    ax.set_ylim([Q_initial - 0.5, Q_step + 0.5])

    # 上游水深
    ax = axes[0, 1]
    for method in methods:
        r = results[method]
        ax.plot(r['time'], r['h_upstream'], color=colors[method], linewidth=2,
               label=method, alpha=0.7)
    ax.axvline(t_step, color='red', linestyle='--', linewidth=1.5, alpha=0.6)
    ax.set_xlabel('Time (s)', fontsize=11)
    ax.set_ylabel('Upstream Water Depth (m)', fontsize=11)
    ax.set_title('Upstream Water Depth Response', fontsize=12, fontweight='bold')
    ax.grid(True, alpha=0.3)
    ax.legend(fontsize=10)

    # 下游水深
    ax = axes[1, 0]
    for method in methods:
        r = results[method]
        ax.plot(r['time'], r['h_downstream'], color=colors[method], linewidth=2,
               label=method, alpha=0.7)
    ax.axvline(t_step, color='red', linestyle='--', linewidth=1.5, alpha=0.6)
    ax.set_xlabel('Time (s)', fontsize=11)
    ax.set_ylabel('Downstream Water Depth (m)', fontsize=11)
    ax.set_title('Downstream Water Depth Response', fontsize=12, fontweight='bold')
    ax.grid(True, alpha=0.3)
    ax.legend(fontsize=10)

    # 计算性能对比
    ax = axes[1, 1]
    method_names = list(methods)
    comp_times = [results[m]['comp_time'] for m in methods]
    speeds = [n_steps / results[m]['comp_time'] for m in methods]

    x_pos = np.arange(len(methods))
    bars = ax.bar(x_pos, speeds, color=[colors[m] for m in methods], alpha=0.7, width=0.6)
    ax.set_ylabel('Computation Speed (steps/s)', fontsize=11)
    ax.set_title('Computational Performance', fontsize=12, fontweight='bold')
    ax.set_xticks(x_pos)
    ax.set_xticklabels(methods)
    ax.grid(True, alpha=0.3, axis='y')

    for i, bar in enumerate(bars):
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2., height,
               f'{height:.1f}\n({comp_times[i]:.2f}s)',
               ha='center', va='bottom', fontsize=9)

    plt.tight_layout()
    fig_path2 = helper.get_output_path('05_step_response_detailed_refactored.png', subdir='figures')
    plt.savefig(fig_path2, dpi=150, bbox_inches='tight')
    print(f"   Saved figure: {fig_path2.name}")
    plt.close()

    print(f"\n{'='*80}")
    print("Step Response Comparison Test Completed!")
    print(f"{'='*80}")
    print("\nGenerated Files:")
    print(f"  1. {fig_path.name}")
    print(f"  2. {fig_path2.name}")
    print(f"{'='*80}")
    print(f"\nAll outputs saved to: {helper.output_dir}/")

    return results


if __name__ == '__main__':
    results = run_step_response_comparison()

#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
示例3: 水轮机暂态响应 - 增强版（嵌入式动画）

演示Francis水轮机的负荷变化暂态响应

使用方法:
    python example_03_turbine_with_anim.py              # 不生成动画
    python example_03_turbine_with_anim.py --animate    # 生成动画

作者: Claude
日期: 2025-10-22
"""

import sys
import os
import numpy as np
import argparse
import matplotlib.pyplot as plt

# 添加项目根目录
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))))

from physics.turbine import FrancisTurbine

# 导入动画工具
EXAMPLES_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, EXAMPLES_DIR)
from animation_utils import AnimationGenerator


def parse_args():
    """解析命令行参数"""
    parser = argparse.ArgumentParser(
        description='水轮机暂态响应仿真 - 嵌入式动画版本'
    )
    parser.add_argument('--animate', action='store_true',
                       help='生成动画（默认：不生成）')
    parser.add_argument('--animation-fps', type=int, default=10,
                       help='动画帧率 (默认: 10)')
    parser.add_argument('--animation-dpi', type=int, default=100,
                       help='动画DPI (默认: 100)')
    return parser.parse_args()


def run_example(args):
    """运行水轮机暂态仿真"""
    print("\n" + "="*80)
    print("示例3: Francis水轮机暂态响应 - 增强版（嵌入式动画）")
    print("="*80)
    if args.animate:
        print(f"动画生成：已启用 (FPS={args.animation_fps}, DPI={args.animation_dpi})")
    else:
        print("动画生成：未启用（使用 --animate 参数启用）")

    # ========================================================================
    # 1. 创建水轮机
    # ========================================================================
    print("\n1. 创建Francis水轮机")
    print("-" * 80)

    turbine = FrancisTurbine(
        position=0.0,
        rated_power=100.0,   # 100 MW
        rated_head=150.0,    # 150 m
        rated_flow=80.0,     # 80 m³/s
        rated_speed=250.0,   # 250 rpm
        runner_diameter=2.5, # 2.5 m
        max_efficiency=0.93
    )

    print(f"额定功率: {turbine.rated_power:.1f} MW")
    print(f"额定水头: {turbine.rated_head:.1f} m")
    print(f"额定流量: {turbine.rated_flow:.1f} m³/s")
    print(f"额定转速: {turbine.rated_speed:.1f} rpm")
    print(f"最大效率: {turbine.max_efficiency:.3f}")

    # ========================================================================
    # 2. 模拟负荷阶跃响应
    # ========================================================================
    print("\n2. 模拟负荷阶跃响应（从50%到80%）")
    print("-" * 80)

    dt = 0.1       # 时间步长 (s)
    t_end = 60.0   # 总时间 (s)
    n_steps = int(t_end / dt)

    print(f"时间步长: {dt} s")
    print(f"总时间: {t_end} s")
    print(f"总步数: {n_steps}\n")

    # 数据存储
    time_history = np.zeros(n_steps)
    power_setpoint = np.zeros(n_steps)
    power_output = np.zeros(n_steps)
    guide_vane = np.zeros(n_steps)
    flow_rate = np.zeros(n_steps)
    efficiency = np.zeros(n_steps)
    speed = np.ones(n_steps) * turbine.rated_speed

    # 初始状态：50%负荷
    P0 = 0.5 * turbine.rated_power
    y0 = 0.5  # 导叶开度
    power_output[0] = P0
    guide_vane[0] = y0

    # 在t=10s时，负荷从50%跃变到80%
    t_step = 10.0

    for i in range(n_steps):
        t = i * dt
        time_history[i] = t

        # 设定值
        if t < t_step:
            P_setpoint = 0.5 * turbine.rated_power
            y_setpoint = 0.5
        else:
            P_setpoint = 0.8 * turbine.rated_power
            y_setpoint = 0.8

        power_setpoint[i] = P_setpoint

        # 导叶响应（一阶滞后，时间常数2秒）
        if i > 0:
            tau = 2.0
            guide_vane[i] = guide_vane[i-1] + (y_setpoint - guide_vane[i-1]) * dt / tau

        # 功率响应（机械惯性，时间常数5秒）
        if i > 0:
            tau_p = 5.0
            P_target = guide_vane[i] * turbine.rated_power
            power_output[i] = power_output[i-1] + (P_target - power_output[i-1]) * dt / tau_p

        # 流量（与导叶开度成正比）
        flow_rate[i] = guide_vane[i] * turbine.rated_flow

        # 效率（简化模型，在75%负荷附近效率最高）
        load_factor = power_output[i] / turbine.rated_power
        eta_max = turbine.max_efficiency
        efficiency[i] = eta_max * (1 - 0.5 * (load_factor - 0.75)**2)

        # 打印进度
        if i % 100 == 0 and i > 0:
            print(f"t={t:.1f}s: Power={power_output[i]:.2f}MW, "
                  f"GV={guide_vane[i]:.3f}, Flow={flow_rate[i]:.2f}m³/s")

    print("\n 仿真完成")

    # ========================================================================
    # 3. 生成静态图表
    # ========================================================================
    print("\n3. 生成静态图表")
    print("-" * 80)

    output_dir = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "..", "outputs", "figures"
    )
    os.makedirs(output_dir, exist_ok=True)

    fig, axes = plt.subplots(4, 1, figsize=(12, 12))

    # 功率
    axes[0].plot(time_history, power_setpoint, 'r--', linewidth=1.5, label='Setpoint', alpha=0.7)
    axes[0].plot(time_history, power_output, 'b-', linewidth=2, label='Output')
    axes[0].set_ylabel('Power (MW)', fontsize=11)
    axes[0].set_title('Francis Turbine - Load Step Response', fontsize=12, fontweight='bold')
    axes[0].grid(True, alpha=0.3)
    axes[0].legend()

    # 导叶开度
    axes[1].plot(time_history, guide_vane, 'g-', linewidth=2)
    axes[1].set_ylabel('Guide Vane Opening', fontsize=11)
    axes[1].set_title('Guide Vane Position', fontsize=12, fontweight='bold')
    axes[1].grid(True, alpha=0.3)

    # 流量
    axes[2].plot(time_history, flow_rate, 'm-', linewidth=2)
    axes[2].set_ylabel('Flow Rate (m³/s)', fontsize=11)
    axes[2].set_title('Water Flow Rate', fontsize=12, fontweight='bold')
    axes[2].grid(True, alpha=0.3)

    # 效率
    axes[3].plot(time_history, efficiency * 100, 'orange', linewidth=2)
    axes[3].set_ylabel('Efficiency (%)', fontsize=11)
    axes[3].set_xlabel('Time (s)', fontsize=11)
    axes[3].set_title('Operating Efficiency', fontsize=12, fontweight='bold')
    axes[3].grid(True, alpha=0.3)

    plt.tight_layout()

    fig_path = os.path.join(output_dir, 'turbine_load_step.png')
    plt.savefig(fig_path, dpi=150, bbox_inches='tight')
    plt.close()

    print(f" 静态图表已保存: {fig_path}")

    # ========================================================================
    # 4. 生成动画（如果启用）
    # ========================================================================
    if args.animate:
        print("\n4. 生成动画")
        print("-" * 80)

        animation_dir = os.path.join(
            os.path.dirname(os.path.abspath(__file__)),
            "..", "outputs", "animations"
        )

        anim_gen = AnimationGenerator(
            output_dir=animation_dir,
            fps=args.animation_fps,
            dpi=args.animation_dpi
        )

        try:
            gif_path = anim_gen.create_timeseries_animation(
                t=time_history,
                data={
                    'Power Output': power_output,
                    'Guide Vane': guide_vane,
                    'Flow Rate': flow_rate,
                    'Efficiency': efficiency * 100,
                },
                filename='turbine_load_step_embedded.gif',
                title='Francis Turbine Load Step Response',
                xlabel='Time (s)',
                ylabels={
                    'Power Output': 'Power (MW)',
                    'Guide Vane': 'Opening (p.u.)',
                    'Flow Rate': 'Flow (m³/s)',
                    'Efficiency': 'Efficiency (%)',
                },
                reference_lines={
                    'Power Output': 0.8 * turbine.rated_power,
                },
                layout=(2, 2)
            )
            print(f" 动画已保存: {os.path.basename(gif_path)}")
        except Exception as e:
            print(f" 动画生成失败: {e}")

    # ========================================================================
    # 完成
    # ========================================================================
    print("\n" + "="*80)
    print("水轮机暂态仿真完成！")
    print("="*80)
    print(f"\n图表已保存到: {output_dir}")
    if args.animate:
        print(f"动画已保存到: {animation_dir}")
    print("\n 示例3（增强版）运行成功")


if __name__ == "__main__":
    args = parse_args()
    run_example(args)

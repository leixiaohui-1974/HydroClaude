    # 河道参数
    z_crest = 108.0  # 堰顶高程（20年一遇设计水位）

    weir = SideWeir(
        weir_id="SW_FLOOD",
        length=80.0,      # 溢流堰长 80m
        crest_elevation=z_crest,
        channel_width=30.0,  # 河道宽 30m
        channel_slope=0.0005,

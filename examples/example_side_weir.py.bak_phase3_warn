    print(f"  河道宽度: {weir.B:.1f} m")

    # 不同重现期洪水
    floods = [
        ("20年", 800, 108.0),   # 设计水位，不溢流
        ("50年", 1200, 109.5),  # 溢流
        ("100年", 1500, 110.5), # 大量溢流
        ("200年", 1800, 111.2), # 大量溢流

{
  "project": {
    "name": "标准溃坝测试 (配置驱动)",
    "description": "使用Godunov-FVM求解器，对比Ritter解析解",
    "author": "HydroClaude Team",
    "created": "2025-10-28"
  },

  "geometry": {
    "type": "uniform",
    "channel_width": 10.0,
    "channel_length": 2000.0,
    "bottom_slope": 0.0,
    "manning_n": 0.0
  },

  "mesh": {
    "n_cells": 400,
    "cell_distribution": "uniform"
  },

  "solver": {
    "type": "godunov_fvm",
    "spatial_order": 2,
    "time_integration": "tvd_rk2",
    "riemann_solver": "hll",
    "use_numba": true,
    "well_balanced": false,
    "cfl": 0.5,
    "eps_dry": 1e-6
  },

  "initial_conditions": {
    "type": "dam_break",
    "h_left": 10.0,
    "h_right": 1.0,
    "Q_initial": 0.0,
    "dam_position": 1000.0
  },

  "boundary_conditions": {
    "left": {
      "type": "h",
      "value": 10.0
    },
    "right": {
      "type": "h",
      "value": 1.0
    }
  },

  "simulation": {
    "start_time": 0.0,
    "end_time": 30.0,
    "max_steps": 1000000,
    "output_interval": 5.0
  },

  "output": {
    "directory": "./examples/config_driven/results/dam_break",
    "formats": ["csv", "hdf5"],
    "variables": ["h", "Q", "u"],
    "statistics": true,
    "plots": {
      "enabled": true,
      "format": "png",
      "dpi": 300
    }
  },

  "validation": {
    "enabled": true,
    "analytical_solution": "ritter",
    "tolerance": {
      "h_rmse": 0.5,
      "Q_rmse": 10.0,
      "mass_error": 0.1
    }
  },

  "logging": {
    "level": "INFO",
    "console": true
  }
}

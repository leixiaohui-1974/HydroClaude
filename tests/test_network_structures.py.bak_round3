class TestStructureCoupler:
    """测试建筑物耦合器"""

    def test_structure_coupler_with_weir(self):
        """测试建筑物耦合器（堰）"""
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0)

        solver1 = create_test_solver(h_init=3.0)
        solver2 = create_test_solver(h_init=2.5)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_weir = InternalWeir(weir, reach1, reach2, node)
        coupler = StructureCoupler(internal_weir)

        Q = coupler.couple()

        assert Q > 0
        assert coupler.upstream == reach1
        assert coupler.downstream == reach2

    def test_structure_coupler_mass_balance(self):
        """测试建筑物耦合器质量守恒"""
        gate = SluiceGate(sill_elevation=0.0, width=8.0, opening=0.6)

        solver1 = create_test_solver(h_init=3.0, Q_init=30.0)
        solver2 = create_test_solver(h_init=2.5, Q_init=30.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_gate = InternalGate(gate, reach1, reach2, node)
        coupler = StructureCoupler(internal_gate)

        coupler.couple()

        is_balanced, error = coupler.check_mass_balance(tol=1.0)
        assert is_balanced
        assert error < 1.0

    def test_convenience_function_structure_coupler(self):
        """测试便捷函数 create_structure_coupler"""
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0)

        solver1 = create_test_solver()
        solver2 = create_test_solver()
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_weir = InternalWeir(weir, reach1, reach2, node)
        coupler = create_structure_coupler(internal_weir)

        assert isinstance(coupler, StructureCoupler)


class TestNetworkIntegration:
    """测试网络集成"""

    def test_add_internal_structure_to_network(self):
        """测试向网络添加内部建筑物"""
        network = RiverNetwork("测试网络")

        # 添加节点
        n1 = create_inflow_boundary("上游", Q=30.0, elevation=110.0)
        n2 = Node("中间", "junction", elevation=105.0)
        n3 = create_outflow_boundary("下游", h=2.0, elevation=100.0)

        network.add_node(n1)
        network.add_node(n2)
        network.add_node(n3)

        # 添加河段
        s1 = create_test_solver(length=500.0, Q_init=30.0)
        s2 = create_test_solver(length=500.0, Q_init=30.0)

        r1 = Reach("R1", "上游", "中间", s1)
        r2 = Reach("R2", "中间", "下游", s2)

        network.add_reach(r1)
        network.add_reach(r2)

        # 创建并添加内部堰
        weir = BroadCrestedWeir(crest_elevation=105.0, width=10.0)
        internal_weir = InternalWeir(weir, r1, r2, n2)

        network.add_internal_structure("中间", internal_weir)

        assert network.nodes["中间"].internal_structure == internal_weir

    def test_network_solver_with_internal_structure(self):
        """测试网络求解器处理内部建筑物"""
        network = RiverNetwork("串联闸门系统")

        # 创建节点
        n1 = create_inflow_boundary("IN", Q=30.0, elevation=110.0)
        n2 = Node("GATE", "junction", elevation=105.0)
        n3 = create_outflow_boundary("OUT", h=2.0, elevation=100.0)

        network.add_node(n1)
        network.add_node(n2)
        network.add_node(n3)

        # 创建河段
        s1 = create_test_solver(length=500.0, width=15.0, h_init=3.0, Q_init=30.0)
        s2 = create_test_solver(length=500.0, width=15.0, h_init=2.5, Q_init=30.0)

        r1 = Reach("R1", "IN", "GATE", s1)
        r2 = Reach("R2", "GATE", "OUT", s2)

        network.add_reach(r1)
        network.add_reach(r2)

        # 添加闸门
        gate = SluiceGate(sill_elevation=105.0, width=10.0, opening=0.5)
        internal_gate = InternalGate(gate, r1, r2, n2)

        network.add_internal_structure("GATE", internal_gate)

        # 创建求解器
        solver = NetworkSolver(network)

        # 验证StructureCoupler已创建
        assert "GATE" in solver.couplers
        assert isinstance(solver.couplers["GATE"], StructureCoupler)

    def test_network_simulation_with_internal_weir(self):
        """测试带内部堰的网络模拟"""
        network = RiverNetwork("堰控河道")

        # 节点
        n1 = create_inflow_boundary("上游", Q=40.0, elevation=110.0)
        n2 = Node("堰", "junction", elevation=105.0)
        n3 = create_outflow_boundary("下游", h=2.0, elevation=100.0)

        network.add_node(n1)
        network.add_node(n2)
        network.add_node(n3)

        # 河段
        s1 = create_test_solver(length=800.0, width=15.0, h_init=3.0, Q_init=40.0)
        s2 = create_test_solver(length=800.0, width=15.0, h_init=2.5, Q_init=40.0)

        r1 = Reach("上游段", "上游", "堰", s1)
        r2 = Reach("下游段", "堰", "下游", s2)

        network.add_reach(r1)
        network.add_reach(r2)

        # 添加宽顶堰
        weir = BroadCrestedWeir(crest_elevation=105.0, width=12.0, discharge_coeff=1.7)
        internal_weir = InternalWeir(weir, r1, r2, n2)

        network.add_internal_structure("堰", internal_weir)

        # 运行模拟
        solver = NetworkSolver(network, solve_method='sequential')

        # 运行短时间模拟
        results = solver.run(t_end=100.0, dt=1.0, verbose=False)

        assert results['n_steps'] > 0
        assert len(results['mass_error_history']) > 0

        # 质量守恒
        max_error = max(results['mass_error_history'])
        assert max_error < 10.0  # 10%以内


if __name__ == "__main__":
    pytest.main([__file__, "-v", "--tb=short"])

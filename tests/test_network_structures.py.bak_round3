import pytest
import numpy as np
import sys
import os

# 添加项目根目录到路径
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))

from network.topology import RiverNetwork, Node, Reach
from network.nodes import create_inflow_boundary, create_outflow_boundary
from network.structures import InternalWeir, InternalGate, InternalOrifice
from network.structures import create_internal_weir, create_internal_gate, create_internal_orifice
from network.coupling import StructureCoupler, create_structure_coupler
from network.solver import NetworkSolver
from physics.hydraulic_structures import BroadCrestedWeir, SluiceGate, Orifice
try:
    from solvers.godunov_fvm_solver import GodunvFVMSolver
except ImportError as e:
    print(f"Import error: {e}")
    print("Make sure project root is in sys.path")
    sys.exit(1)



def create_test_solver(length=100.0, width=10.0, h_init=2.0, Q_init=20.0, slope=0.001):
    """创建测试求解器"""
    n_cells = max(10, int(length / 10))
    solver = GodunvFVMSolver(
        width=width,
        length=length,
        n_cells=n_cells,
        manning_n=0.025,
        slope=slope
    )

    h = np.ones(n_cells) * h_init
    Q = np.ones(n_cells) * Q_init

    solver.initialize(
        h, Q,
        {'type': 'Q', 'value': Q_init},
        {'type': 'h', 'value': h_init}
    )

    return solver


class TestInternalWeir:
    """测试内部堰"""

    def test_internal_weir_creation(self):
        """测试创建内部堰"""
        # 创建堰
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0)

        # 创建河段和节点
        solver1 = create_test_solver(Q_init=30.0)
        solver2 = create_test_solver(Q_init=30.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        # 创建内部堰
        internal_weir = InternalWeir(weir, reach1, reach2, node)

        assert internal_weir.structure == weir
        assert internal_weir.upstream == reach1
        assert internal_weir.downstream == reach2
        assert internal_weir.node == node
        assert "Weir" in internal_weir.name

    def test_internal_weir_discharge_calculation(self):
        """测试内部堰流量计算"""
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0, discharge_coeff=1.7)

        solver1 = create_test_solver(h_init=3.0, Q_init=30.0)
        solver2 = create_test_solver(h_init=2.2, Q_init=30.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_weir = InternalWeir(weir, reach1, reach2, node)

        # 求解流量
        Q = internal_weir.solve()

        # 验证流量为正
        assert Q > 0

        # 验证BC已设置
        assert solver1.bc_right['type'] == 'Q'
        assert solver2.bc_left['type'] == 'Q'
        assert solver1.bc_right['value'] == pytest.approx(Q, rel=1e-6)
        assert solver2.bc_left['value'] == pytest.approx(Q, rel=1e-6)

    def test_internal_weir_mass_balance(self):
        """测试内部堰质量守恒"""
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0)

        solver1 = create_test_solver(h_init=3.0, Q_init=30.0)
        solver2 = create_test_solver(h_init=2.5, Q_init=30.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_weir = InternalWeir(weir, reach1, reach2, node)
        internal_weir.solve()

        # 检查质量守恒
        is_balanced, error = internal_weir.check_mass_balance(tol=1.0)
        assert is_balanced
        assert error < 1.0

    def test_convenience_function(self):
        """测试便捷函数 create_internal_weir"""
        weir = BroadCrestedWeir(crest_elevation=2.0, width=10.0)

        solver1 = create_test_solver()
        solver2 = create_test_solver()
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_weir = create_internal_weir(weir, reach1, reach2, node)

        assert isinstance(internal_weir, InternalWeir)
        assert internal_weir.structure == weir


class TestInternalGate:
    """测试内部闸门"""

    def test_internal_gate_creation(self):
        """测试创建内部闸门"""
        gate = SluiceGate(sill_elevation=0.0, width=8.0, opening=0.5)

        solver1 = create_test_solver()
        solver2 = create_test_solver()
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_gate = InternalGate(gate, reach1, reach2, node)

        assert internal_gate.structure == gate
        assert "Gate" in internal_gate.name

    def test_internal_gate_discharge(self):
        """测试内部闸门流量计算"""
        gate = SluiceGate(sill_elevation=0.0, width=8.0, opening=0.5)

        solver1 = create_test_solver(h_init=3.0, Q_init=25.0)
        solver2 = create_test_solver(h_init=2.0, Q_init=25.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_gate = InternalGate(gate, reach1, reach2, node)

        Q = internal_gate.solve()

        assert Q > 0
        assert solver1.bc_right['type'] == 'Q'
        assert solver2.bc_left['type'] == 'Q'

    def test_gate_opening_control(self):
        """测试闸门开度控制"""
        gate = SluiceGate(sill_elevation=0.0, width=8.0, opening=0.3)

        solver1 = create_test_solver(h_init=3.0)
        solver2 = create_test_solver(h_init=2.0)
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_gate = InternalGate(gate, reach1, reach2, node)

        # 初始开度
        Q1 = internal_gate.solve()
        assert internal_gate.get_opening() == 0.3

        # 增大开度
        internal_gate.set_opening(0.8)
        Q2 = internal_gate.solve()
        assert internal_gate.get_opening() == 0.8
        assert Q2 > Q1  # 流量应增大

    def test_convenience_function_gate(self):
        """测试便捷函数 create_internal_gate"""
        gate = SluiceGate(sill_elevation=0.0, width=8.0, opening=0.5)

        solver1 = create_test_solver()
        solver2 = create_test_solver()
        reach1 = Reach("R1", "N1", "N2", solver1)
        reach2 = Reach("R2", "N2", "N3", solver2)
        node = Node("N2", "junction", elevation=100.0)

        internal_gate = create_internal_gate(gate, reach1, reach2, node)

        assert isinstance(internal_gate, InternalGate)



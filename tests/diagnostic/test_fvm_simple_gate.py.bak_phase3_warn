import sys
import os
import numpy as np
import matplotlib.pyplot as plt

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

try:
    from solvers.fvm_solver import FVMSolver
except ImportError as e:
    print(f"Import error: {e}")
    print("Make sure project root is in sys.path")
    sys.exit(1)



def test_simple_gate():
    """
    简单闸门问题测试

    配置：
    - 长度: 1000m
    - 单个闸门在中点(500m)
    - 上游流量: Q0 = 10 m^3/s
    - 闸门开度: a = 3.0m
    """
    print("=" * 70)
    print("简单闸门测试 - FVM求解器")
    print("=" * 70)
    print()

    # 系统参数
    L = 1000.0
    B = 10.0
    S0 = 0.001
    n = 0.025
    g = 9.81

    Q0 = 10.0  # 上游流量
    gate_pos = 500.0  # 闸门位置
    gate_opening = 3.0  # 闸门开度
    Cd = 0.6  # 流量系数

    # 创建网格
    nx = 201
    x = np.linspace(0, L, nx)

    print("配置:")
    print(f"  渠道长度: {L}m")
    print(f"  渠道宽度: {B}m")
    print(f"  底坡: {S0}")
    print(f"  Manning糙率: {n}")
    print(f"  上游流量: {Q0} m^3/s")
    print(f"  闸门位置: {gate_pos}m")
    print(f"  闸门开度: {gate_opening}m")
    print(f"  网格点数: {nx}")
    print()

    # 创建求解器
    solver = FVMSolver(
        x_grid=x,
        B=B, S0=S0, n=n, g=g,
        reconstruction='muscl',
        limiter='minmod',
        riemann='hll',
        time_integrator='ssp_rk2'
    )

    # 初始条件：均匀流
    # 使用Manning公式估计初始水深
    # Q = (1/n) * A * R^(2/3) * S0^(1/2)
    # 对于宽矩形渠道 R ~= h
    # Q = (1/n) * B * h * h^(2/3) * S0^(1/2)
    # 求解 h
    def manning_depth(Q, B, n, S0):
        # Q = (1/n) * B * h^(5/3) * S0^(1/2)
        # h = (Q * n / (B * S0^(1/2)))^(3/5)
        return (Q * n / (B * np.sqrt(S0)))**(3.0/5.0)

    h_uniform = manning_depth(Q0, B, n, S0)
    print(f"初始均匀流水深: {h_uniform:.3f}m")

    A0 = B * h_uniform * np.ones(solver.ncells)
    Q0_arr = Q0 * np.ones(solver.ncells)

    solver.initialize(A0, Q0_arr)

    # 简化的闸门处理：在闸门位置设置跳跃
    # 找到闸门位置的网格索引
    gate_idx = np.argmin(np.abs(solver.x_cell - gate_pos))

    print(f"闸门位置网格索引: {gate_idx} (x={solver.x_cell[gate_idx]:.1f}m)")
    print()

    # 闸门上游：增加水深
    # 闸门下游：减小水深
    # 使用闸门方程: Q = Cd * a * B * sqrt(2*g*Δh)
    # 估计 Δh
    delta_h = (Q0 / (Cd * gate_opening * B))**2 / (2 * g)

    print(f"估计闸门水头差: {delta_h:.3f}m")

    # 设置初始跳跃
    solver.U[:gate_idx, 0] = B * (h_uniform + 0.5 * delta_h)  # 上游稍高
    solver.U[gate_idx:, 0] = B * (h_uniform - 0.5 * delta_h)  # 下游稍低

    print("开始求解...")
    print()

    # 求解到稳态
    t_end = 50.0
    history = solver.solve(t_end, cfl=0.5, verbose=True)

    print()
    print("求解完成")
    print(f"  总时间: {history['t'][-1]:.2f}s")
    print(f"  时间步数: {len(history['t'])}")
    print()

    # 获取最终结果
    h_final, u_final = solver.get_primitive_variables()
    Q_final = solver.U[:, 1]

    # 分析结果
    print("最终状态:")
    print(f"  水深范围: [{h_final.min():.3f}, {h_final.max():.3f}]m")
    print(f"  流速范围: [{u_final.min():.3f}, {u_final.max():.3f}]m/s")
    print(f"  流量范围: [{Q_final.min():.3f}, {Q_final.max():.3f}]m^3/s")
    print()

    # 流量守恒分析
    Q_mean = np.mean(Q_final)
    Q_std = np.std(Q_final)
    Q_error = np.abs(Q_final - Q0) / Q0 * 100
    Q_max_error = np.max(Q_error)
    Q_mean_error = np.mean(Q_error)

    print("流量守恒:")
    print(f"  目标流量: {Q0:.3f} m^3/s")
    print(f"  平均流量: {Q_mean:.3f} m^3/s")
    print(f"  流量标准差: {Q_std:.3f} m^3/s")
    print(f"  最大误差: {Q_max_error:.4f}%")
    print(f"  平均误差: {Q_mean_error:.4f}%")
    print()

    # 闸门处分析
    # 上游：gate_idx - 5 到 gate_idx
    # 下游：gate_idx 到 gate_idx + 5
    upstream_idx = max(0, gate_idx - 5)
    downstream_idx = min(solver.ncells, gate_idx + 5)

    h_upstream = np.mean(h_final[upstream_idx:gate_idx])
    h_downstream = np.mean(h_final[gate_idx:downstream_idx])
    delta_h_actual = h_upstream - h_downstream

    Q_gate = np.mean(Q_final[gate_idx-2:gate_idx+2])

    print("闸门处状态:")
    print(f"  上游水深: {h_upstream:.3f}m")
    print(f"  下游水深: {h_downstream:.3f}m")
    print(f"  水头差: {delta_h_actual:.3f}m")
    print(f"  闸门流量: {Q_gate:.3f} m^3/s")
    print(f"  流量误差: {abs(Q_gate - Q0) / Q0 * 100:.4f}%")
    print()

    # 绘图
    fig, axes = plt.subplots(3, 1, figsize=(12, 10))

    # 水深
    ax = axes[0]
    ax.plot(solver.x_cell, h_final, 'b-', linewidth=2, label='Water depth')
    ax.axvline(gate_pos, color='r', linestyle='--', alpha=0.5, label='Gate')
    ax.set_xlabel('x [m]')
    ax.set_ylabel('h [m]')
    ax.set_title('Water Depth Profile')
    ax.legend()
    ax.grid(True, alpha=0.3)

    # 流速
    ax = axes[1]
    ax.plot(solver.x_cell, u_final, 'g-', linewidth=2, label='Velocity')
    ax.axvline(gate_pos, color='r', linestyle='--', alpha=0.5, label='Gate')
    ax.set_xlabel('x [m]')
    ax.set_ylabel('u [m/s]')
    ax.set_title('Velocity Profile')
    ax.legend()
    ax.grid(True, alpha=0.3)

    # 流量
    ax = axes[2]
    ax.plot(solver.x_cell, Q_final, 'purple', linewidth=2, label='Discharge')
    ax.axhline(Q0, color='k', linestyle='--', alpha=0.5, label='Target Q')
    ax.axvline(gate_pos, color='r', linestyle='--', alpha=0.5, label='Gate')
    ax.set_xlabel('x [m]')
    ax.set_ylabel('Q [m^3/s]')
    ax.set_title(f'Discharge Profile (Max error: {Q_max_error:.4f}%)')
    ax.legend()
    ax.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig('fvm_simple_gate_test.png', dpi=150, bbox_inches='tight')
    print(" 保存图像: fvm_simple_gate_test.png")
    print()

    # 评估
    print("=" * 70)
    print("评估结果")
    print("=" * 70)
    print()

    if Q_max_error < 0.5:
        print(f" 优秀！最大流量误差 {Q_max_error:.4f}% < 0.5%")
        result = "excellent"
    elif Q_max_error < 1.0:
        print(f" 很好！最大流量误差 {Q_max_error:.4f}% < 1.0%")
        result = "good"
    elif Q_max_error < 2.0:
        print(f" 可接受！最大流量误差 {Q_max_error:.4f}% < 2.0%")
        result = "acceptable"
    elif Q_max_error < 5.0:
        print(f" 需改进。最大流量误差 {Q_max_error:.4f}% < 5.0%")
        result = "needs_improvement"
    else:
        print(f" 不佳。最大流量误差 {Q_max_error:.4f}% >= 5.0%")
        result = "poor"

    print()

    return result


if __name__ == "__main__":
    result = test_simple_gate()

    print()
    print("=" * 70)
    print(f"测试结果: {result}")
    print("=" * 70)

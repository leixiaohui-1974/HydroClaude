    Q = 20.0
    n_cells = 50

    h_normal = compute_normal_depth(Q, B, S0, n)

    print(f"正常水深 h_n = {h_normal:.4f} m")

    solver = GodunvFVMSolver(
        width=B, length=L, n_cells=n_cells,
        manning_n=n, slope=S0, cfl=0.5, order=2,  # 二阶格式
        riemann_solver='hll', use_numba=True

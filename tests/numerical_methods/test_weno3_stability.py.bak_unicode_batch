                'spatial_order': 3,
                'riemann_solver': 'hll',
                'use_numba': True,
                'cfl': 0.4,  # 较小CFL增强稳定性
                'entropy_fix': True,
                'critical_flow_treatment': True  # 启用临界流处理
            },
            'simulation': {
                'start_time': 0.0,
                'end_time': 50.0,
                'max_steps': 100000
            },
            'output': {
                'directory': '/tmp/test_extreme',

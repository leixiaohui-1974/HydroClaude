from tests.verification.toro_riemann_solver import exact_riemann_solution, riemann_structure


def compute_errors(h_num, u_num, h_exact, u_exact, h_scale):
    """
    计算误差指标

    Args:
        h_num, u_num: 数值解
        h_exact, u_exact: 精确解
        h_scale: 水深特征尺度（用于归一化）

    Returns:
        dict: 包含L1, L2, Linf误差
    """
    # 水深误差
    h_L1 = np.mean(np.abs(h_num - h_exact))
    h_L2 = np.sqrt(np.mean((h_num - h_exact)**2))
    h_Linf = np.max(np.abs(h_num - h_exact))

    # 流速误差（只在湿区计算）
    wet_mask = (h_exact > 1e-6) | (h_num > 1e-6)
    if np.any(wet_mask):
        u_L1 = np.mean(np.abs(u_num[wet_mask] - u_exact[wet_mask]))
        u_L2 = np.sqrt(np.mean((u_num[wet_mask] - u_exact[wet_mask])**2))
        u_Linf = np.max(np.abs(u_num[wet_mask] - u_exact[wet_mask]))
    else:
        u_L1 = u_L2 = u_Linf = 0.0

    return {
        'h_L1': h_L1,
        'h_L2': h_L2,
        'h_Linf': h_Linf,
        'h_L2_rel': h_L2 / h_scale * 100,  # 相对L2误差(%)
        'u_L1': u_L1,
        'u_L2': u_L2,
        'u_Linf': u_Linf,
    }


def run_riemann_test(
    h_L, u_L, h_R, u_R,
    t_end=1.0,
    L=100.0,
    n_cells=500,
    cfl=0.5,
    test_name=""
):
    """
    运行单个Riemann问题测试

    Args:
        h_L, u_L: 左侧初始状态
        h_R, u_R: 右侧初始状态
        t_end: 终止时间
        L: 计算域长度
        n_cells: 网格数
        cfl: CFL数
        test_name: 测试名称

    Returns:
        errors: 误差字典
        solver: 求解器实例（用于可视化）
    """
    print(f"\n{'='*80}")
    print(f"{test_name}")
    print(f"{'='*80}\n")

    # 初始条件
    x_dam = L / 2.0
    print(f"初始条件:")
    print(f"  左侧: h_L = {h_L:.3f} m, u_L = {u_L:.3f} m/s")
    print(f"  右侧: h_R = {h_R:.3f} m, u_R = {u_R:.3f} m/s")
    print(f"  计算域: [0, {L}] m, {n_cells} cells")
    print(f"  时间: t = {t_end} s")

    # 波结构分析
    structure = riemann_structure(h_L, u_L, h_R, u_R)
    print(f"\n精确解波结构:")
    print(f"  中间状态: h* = {structure['h_star']:.4f} m, u* = {structure['u_star']:.4f} m/s")
    print(f"  左波: {structure['wave_type_L']}")
    print(f"  右波: {structure['wave_type_R']}")

    # 创建求解器
    B = 10.0  # 渠道宽度（任意单位宽度）
    solver = GodunvFVMWENO3(
        width=B,
        length=L,
        n_cells=n_cells,
        manning_n=0.0,  # 无摩阻
        slope=0.0,      # 平底
        use_enhanced_bc=True,
        well_balanced=False,  # Riemann问题不需要WB
        cfl=cfl,
        use_numba=True
    )

    # 初始条件
    x = solver.x
    h_init = np.where(x <= x_dam, h_L, h_R)
    Q_init = B * np.where(x <= x_dam, h_L * u_L, h_R * u_R)

    # 边界条件（透射边界）
    bc_left = {'type': 'transmissive'}
    bc_right = {'type': 'transmissive'}

    solver.initialize(h_init, Q_init, bc_left, bc_right)

    print(f"\nGodunov-FVM求解器配置:")
    print(f"  空间格式: WENO3")
    print(f"  时间积分: TVD-RK2")
    print(f"  Riemann求解器: HLL")
    print(f"  CFL: {cfl}")
    print(f"  Numba JIT: 启用")

    # 运行数值模拟
    print(f"\n运行数值模拟...")
    while solver.t < t_end:
        solver.step()

        # 进度输出
        if solver.step_count % 50 == 0:
            print(f"  步数: {solver.step_count}, 时间: {solver.t:.3f}s")

        # 安全检查
        if np.any(np.isnan(solver.h)) or np.any(np.isnan(solver.Q)):
            raise RuntimeError(f"数值爆炸在t={solver.t:.3f}s, 步数={solver.step_count}")

    print(f"\n 模拟完成:")
    print(f"  总步数: {solver.step_count}")
    print(f"  最终时间: {solver.t:.6f} s")

    # 计算精确解
    x_exact = solver.x
    h_exact, u_exact = exact_riemann_solution(
        x_exact, solver.t, h_L, u_L, h_R, u_R, x_dam
    )

    # 数值解
    h_num = solver.h
    u_num = solver.Q / (solver.B * np.maximum(solver.h, solver.eps_dry))

    # 计算误差
    h_scale = max(h_L, h_R) if max(h_L, h_R) > 0 else 1.0
    errors = compute_errors(h_num, u_num, h_exact, u_exact, h_scale)

    # 输出误差
    print(f"\n误差分析:")
    print(f"  水深L1:  {errors['h_L1']:.6f} m")
    print(f"  水深L2:  {errors['h_L2']:.6f} m ({errors['h_L2_rel']:.2f}%)")
    print(f"  水深L∞:  {errors['h_Linf']:.6f} m")
    print(f"  流速L1:  {errors['u_L1']:.6f} m/s")
    print(f"  流速L2:  {errors['u_L2']:.6f} m/s")
    print(f"  流速L∞:  {errors['u_Linf']:.6f} m/s")

    return errors, solver, h_exact, u_exact



class TestPIDController:
    """Test PID controller"""

    def test_initialization(self):
        """Test PID controller creation"""
        pid = PIDController(Kp=1.0, Ki=0.1, Kd=0.01)

        assert pid.Kp == 1.0
        assert pid.Ki == 0.1
        assert pid.Kd == 0.01
        assert pid.integral == 0.0
        print("  PID controller initialized successfully")

    def test_proportional_only(self):
        """Test proportional-only control"""
        pid = PIDController(Kp=2.0, Ki=0.0, Kd=0.0, output_min=-10.0, output_max=10.0)

        # setpoint=0, measurement=-1 → error=0-(-1)=1
        output = pid.compute(setpoint=0.0, measurement=-1.0, current_time=0.0)

        # P-only: output = Kp * error = 2.0 * 1.0 = 2.0
        expected = 2.0
        assert abs(output - expected) < 0.01, f"Expected {expected}, got {output}"

        print(f"  P-only test: output={output:.3f} (expected {expected})")

    def test_integral_action(self):
        """Test integral action accumulation"""
        pid = PIDController(Kp=0.0, Ki=1.0, Kd=0.0, output_min=-10.0, output_max=10.0)

        # Apply constant error for 1 second
        # setpoint=0, measurement=-1 → error=1
        dt = 0.1
        total_time = 0.0

        outputs = []
        for i in range(10):
            total_time = i * dt
            output = pid.compute(0.0, -1.0, total_time)
            outputs.append(output)

        # Integral should accumulate: I = Ki * ∫e*dt ≈ 1.0 * 1.0 * 0.9 ≈ 0.9
        # (slightly less due to discrete integration)
        assert outputs[-1] > 0.7, f"Expected ~0.9, got {outputs[-1]}"
        assert outputs[-1] < 1.1

        print(f"  Integral test: final output={outputs[-1]:.3f} after {total_time:.1f}s")

    def test_derivative_action(self):
        """Test derivative action"""
        pid = PIDController(Kp=0.0, Ki=0.0, Kd=1.0, output_min=-20.0, output_max=20.0)

        # Need to establish time history first
        pid.compute(0.0, 0.0, 0.0)  # First call at t=0, error=0
        pid.compute(0.0, 0.0, 0.05)  # Second call at t=0.05, error=0 (establish dt)

        # Now apply step change
        output = pid.compute(0.0, -1.0, 0.15)  # Error jumps from 0 to 1 in 0.1s

        # D = Kd * de/dt = 1.0 * (1.0-0.0)/0.1 = 10.0
        assert output > 5.0, f"Expected ~10, got {output}"
        assert output < 15.0

        print(f"  Derivative test: output={output:.3f} for step change (expected ~10)")

    def test_output_limits(self):
        """Test output saturation"""
        pid = PIDController(Kp=10.0, Ki=0.0, Kd=0.0,
                           output_min=-1.0, output_max=1.0)

        # Large error should saturate
        output = pid.compute(0.0, -10.0, 0.0)

        assert output <= 1.0
        assert output >= -1.0

        print(f"  Saturation test: large error → output={output:.3f} (clamped to ±1)")


class TestServoSystem:
    """Test hydraulic servo system"""

    def test_initialization(self):
        """Test servo creation"""
        servo = ServoSystem(time_constant=0.2)

        assert servo.T_servo == 0.2
        assert servo.opening == 0.5  # Initial position
        print("  Servo system initialized at 50% opening")

    def test_first_order_response(self):
        """Test first-order lag response"""
        servo = ServoSystem(time_constant=0.2, rate_limit=1.0)  # No rate limit

        # Command step to 0.8
        command = 0.8
        dt = 0.1

        positions = [servo.opening]
        for i in range(10):
            pos = servo.update(command, dt)
            positions.append(pos)

        # Should approach 0.8 exponentially
        final = positions[-1]
        assert abs(final - 0.8) < 0.05  # Close to target

        print(f"  First-order response: 0.5 → {final:.3f} (target 0.8)")

    def test_rate_limit(self):
        """Test rate limiter"""
        servo = ServoSystem(time_constant=0.01,  # Very fast
                           rate_limit=0.1)  # 0.1 p.u./s

        # Command large step
        dt = 1.0
        servo.opening = 0.0
        final = servo.update(1.0, dt)

        # Should be limited by rate: max change = 0.1 * 1.0 = 0.1
        assert final <= 0.15  # Some margin for dynamics

        print(f"  Rate limit test: 0.0 → {final:.3f} in 1s (limit 0.1/s)")

    def test_position_limits(self):
        """Test position limits"""
        servo = ServoSystem(opening_min=0.1, opening_max=0.9)

        # Command below minimum
        servo.update(0.05, 1.0)
        assert servo.opening >= 0.1

        # Command above maximum
        servo.update(0.95, 1.0)
        assert servo.opening <= 0.9

        print(f"  Position limits enforced: {servo.opening_min} ≤ y ≤ {servo.opening_max}")


class TestPIDGovernor:
    """Test PID governor"""

    def test_initialization(self):
        """Test governor creation"""
        gov = PIDGovernor(rated_speed=250.0, Kp=10.0)

        assert gov.rated_speed == 250.0
        assert gov.permanent_droop == 0.1  # 1/10 = 10%
        print(f"  PID governor: {gov}")

    def test_speed_control(self):
        """Test speed control action"""
        gov = PIDGovernor(rated_speed=250.0, Kp=10.0, Ki=0.5, Kd=0.1)

        # Speed is 5 rpm below setpoint
        speed = 245.0
        speed_ref = 250.0
        time = 0.0

        command = gov.compute_control(speed, speed_ref, time)

        # Should command increase in opening
        assert command > 0.5  # Baseline is 0.5

        print(f"  Speed control: {speed}rpm → command={command:.3f} (increase opening)")

    def test_dead_band(self):
        """Test dead band functionality"""
        gov = PIDGovernor(rated_speed=250.0, Kp=10.0, dead_band=1.0)  # 1 rpm dead band

        # Small error within dead band
        command1 = gov.compute_control(249.5, 250.0, 0.0)

        # Reset
        gov.reset()

        # Large error outside dead band
        command2 = gov.compute_control(245.0, 250.0, 0.0)

        # Command2 should be significantly different from baseline
        assert abs(command2 - 0.5) > abs(command1 - 0.5)

        print(f"  Dead band: small error→{command1:.3f}, large error→{command2:.3f}")

    def test_servo_update(self):
        """Test servo system integration"""
        gov = PIDGovernor(rated_speed=250.0)

        # Compute command
        gov.compute_control(245.0, 250.0, 0.0)

        # Update servo
        state = gov.update(dt=0.1)

        assert 'actual_opening' in state
        assert 'opening_command' in state

        print(f"  Servo update: command={state['opening_command']:.3f}, "
              f"actual={state['actual_opening']:.3f}")

    def test_step_response_convergence(self):
        """Test that governor stabilizes after disturbance"""
        gov = PIDGovernor(rated_speed=250.0, Kp=10.0, Ki=1.0, Kd=0.5)

        speed = 245.0  # Initial disturbance
        speed_ref = 250.0
        dt = 0.1

        openings = []

        # Simulate for 5 seconds
        for i in range(50):
            time = i * dt
            command = gov.compute_control(speed, speed_ref, time)
            state = gov.update(dt)
            openings.append(state['actual_opening'])

            # Simple turbine response model (for test purposes)
            # Assume opening increase → speed increase
            speed_change = (state['actual_opening'] - 0.5) * 10 * dt
            speed = min(speed + speed_change, speed_ref)

        # Should converge
        final_opening = openings[-1]
        assert abs(final_opening - 0.5) < 0.2  # Should settle near baseline

        print(f"  Convergence test: final opening={final_opening:.3f} after 5s")


class TestElectroHydraulicGovernor:
    """Test electro-hydraulic governor"""

    def test_initialization(self):
        """Test EH governor creation"""
        gov = ElectroHydraulicGovernor(rated_speed=250.0, Kp=15.0)

        assert gov.rated_speed == 250.0
        assert abs(gov.permanent_droop - 1.0/15.0) < 0.001
        print(f"  EH governor: {gov}")

    def test_cascaded_control(self):
        """Test cascaded control structure"""
        gov = ElectroHydraulicGovernor(rated_speed=250.0, Kp=15.0)

        # Apply speed error
        command = gov.compute_control(245.0, 250.0, 0.0)

        # Should produce position setpoint
        assert command > 0.5

        state = gov.update(0.1)

        assert 'position_setpoint' in state
        assert 'actual_opening' in state

        print(f"  Cascaded control: position_setpoint={state['position_setpoint']:.3f}, "
              f"actual={state['actual_opening']:.3f}")

    def test_faster_response(self):
        """Test that EH governor is faster than mechanical PID"""
        # PID governor
        pid_gov = PIDGovernor(rated_speed=250.0, Kp=10.0, T_servo=0.2)

        # EH governor
        eh_gov = ElectroHydraulicGovernor(rated_speed=250.0, Kp=15.0, T_servo=0.15)

        # Both start at same point
        speed = 245.0
        dt = 0.1

        # Run for 10 steps
        for i in range(10):
            pid_gov.compute_control(speed, 250.0, i*dt)
            eh_gov.compute_control(speed, 250.0, i*dt)

            pid_gov.update(dt)
            eh_gov.update(dt)

        # EH should have faster servo (smaller time constant)
        assert eh_gov.servo.T_servo < pid_gov.servo.T_servo

        print(f"  Response speed: PID T_servo={pid_gov.servo.T_servo}s, "
              f"EH T_servo={eh_gov.servo.T_servo}s")


class TestUtilityFunctions:
    """Test utility functions"""

    def test_droop_calculations(self):
        """Test droop-gain conversions"""
        # Test cases
        test_Kp = [4.0, 10.0, 20.0]
        expected_bp = [0.25, 0.1, 0.05]

        print("  Droop calculations:")
        for Kp, bp_expected in zip(test_Kp, expected_bp):
            bp = calculate_permanent_droop(Kp)
            Kp_back = calculate_proportional_gain(bp)

            assert abs(bp - bp_expected) < 0.001
            assert abs(Kp_back - Kp) < 0.001

            print(f"    Kp={Kp:.1f} → bp={bp:.1%} → Kp={Kp_back:.1f} ")

    def test_typical_droops(self):
        """Test typical droop values"""
        # Isolated system: 2-4%
        Kp_isolated = calculate_proportional_gain(0.04)
        assert 20 <= Kp_isolated <= 30

        # Grid-connected: 4-6%
        Kp_grid = calculate_proportional_gain(0.05)
        assert 15 <= Kp_grid <= 25

        print(f"  Typical droops: isolated Kp={Kp_isolated:.1f}, grid Kp={Kp_grid:.1f}")


class TestIntegration:
    """Integration tests"""

    def test_load_rejection_scenario(self):
        """Test load rejection scenario"""
        gov = PIDGovernor(rated_speed=250.0, Kp=10.0, Ki=1.0, Kd=0.5,
                         T_servo=0.2, rate_limit=0.1)

        # Initial steady state
        speed = 250.0
        speed_ref = 250.0
        load_power = 100.0  # MW
        opening_baseline = 0.6

        # t=0: Sudden load rejection (load drops to 10 MW)
        load_power = 10.0

        # Simple speed dynamics (for testing)
        # dω/dt ∝ (P_turbine - P_load)
        dt = 0.01  # 10 ms
        time = 0.0

        speed_history = [speed]
        opening_history = [opening_baseline]

        # Simulate for 5 seconds
        for i in range(500):
            time = i * dt

            # Governor control
            command = gov.compute_control(speed, speed_ref, time)
            state = gov.update(dt)

            # Simple turbine power (proportional to opening)
            P_turbine = state['actual_opening'] * 150  # MW

            # Speed dynamics (simplified)
            power_imbalance = P_turbine - load_power
            speed_accel = power_imbalance * 0.1  # Simplified inertia

            speed += speed_accel * dt

            speed_history.append(speed)
            opening_history.append(state['actual_opening'])

        # Check that:
        # 1. Opening decreased (to match lower load)
        assert opening_history[-1] < opening_baseline

        # 2. Speed overshoot is limited
        max_speed = max(speed_history)
        overshoot = (max_speed - speed_ref) / speed_ref
        assert overshoot < 0.15  # Less than 15% overshoot

        print(f"  Load rejection simulation:")
        print(f"    Initial opening: {opening_baseline:.3f}")
        print(f"    Final opening:   {opening_history[-1]:.3f}")
        print(f"    Max speed:       {max_speed:.1f} rpm ({overshoot:.1%} overshoot)")
        print(f"    Final speed:     {speed_history[-1]:.1f} rpm")


def run_all_tests():
    """Run all tests"""
    print("=" * 80)
    print("GOVERNOR TEST SUITE")
    print("=" * 80)

    test_classes = [
        TestPIDController,
        TestServoSystem,
        TestPIDGovernor,
        TestElectroHydraulicGovernor,
        TestUtilityFunctions,
        TestIntegration
    ]

    total_tests = 0
    passed_tests = 0

    for test_class in test_classes:
        print(f"\n{test_class.__name__}:")
        print("-" * 60)

        test_instance = test_class()
        test_methods = [method for method in dir(test_instance) if method.startswith('test_')]

        for method_name in test_methods:
            total_tests += 1
            try:
                method = getattr(test_instance, method_name)
                method()
                passed_tests += 1
            except AssertionError as e:
                print(f"  FAILED: {method_name}")
                print(f"    {str(e)}")
            except Exception as e:
                print(f"  ERROR: {method_name}")
                print(f"    {str(e)}")

    print("\n" + "=" * 80)
    print(f"Test Summary: {passed_tests}/{total_tests} tests passed")
    if passed_tests == total_tests:
        print("ALL TESTS PASSED!")
    print("=" * 80)

    return passed_tests == total_tests


if __name__ == "__main__":
    success = run_all_tests()
    sys.exit(0 if success else 1)

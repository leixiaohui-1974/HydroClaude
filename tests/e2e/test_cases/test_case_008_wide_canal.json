{
  "version": "2.0.0",
  "name": "wide_canal_flow",
  "description": "宽渠道流动 - 大宽度低水深",
  "type": "wide_canal",
  "canal": {
    "length": 8000.0,
    "width": 50.0,
    "slope": 0.0008,
    "roughness": 0.025,
    "nx": 400
  },
  "flow": {
    "flow_rate": 100.0,
    "type": "steady"
  },
  "structures": [],
  "solver": {
    "type": "hydrostatic",
    "max_iter": 100,
    "convergence_tol": 0.1
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "formats": ["json", "csv"]
  },
  "expected_results": {
    "flow_rate_error": 0.01,
    "convergence": true,
    "max_iterations": 10
  }
}

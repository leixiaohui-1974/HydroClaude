{
  "version": "2.0.0",
  "name": "steep_slope_flow",
  "description": "陡坡流动 - 大坡度超临界流",
  "type": "steep_slope",
  "canal": {
    "length": 5000.0,
    "width": 8.0,
    "slope": 0.01,
    "roughness": 0.02,
    "nx": 250
  },
  "flow": {
    "flow_rate": 40.0,
    "type": "steady"
  },
  "structures": [],
  "solver": {
    "type": "hydrostatic",
    "max_iter": 100,
    "convergence_tol": 0.1
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "formats": ["json", "csv"]
  },
  "expected_results": {
    "flow_rate_error": 0.01,
    "convergence": true,
    "max_iterations": 10,
    "flow_regime": "supercritical",
    "froude_number_greater_than": 1.0
  }
}

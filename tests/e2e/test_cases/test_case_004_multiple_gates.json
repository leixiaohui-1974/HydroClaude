{
  "version": "2.0.0",
  "name": "multiple_gates",
  "description": "多个闸门 - 串联闸门控制流动",
  "type": "multiple_structures",
  "canal": {
    "length": 15000.0,
    "width": 10.0,
    "slope": 0.001,
    "roughness": 0.025,
    "nx": 750
  },
  "flow": {
    "flow_rate": 50.0,
    "type": "steady"
  },
  "structures": [
    {
      "type": "sluice_gate",
      "position": 5000.0,
      "width": 10.0,
      "opening": 2.0,
      "discharge_coefficient": 0.6
    },
    {
      "type": "sluice_gate",
      "position": 10000.0,
      "width": 10.0,
      "opening": 2.5,
      "discharge_coefficient": 0.6
    }
  ],
  "solver": {
    "type": "hydrostatic",
    "max_iter": 150,
    "convergence_tol": 0.1
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "formats": ["json", "csv"]
  },
  "expected_results": {
    "flow_rate_error": 1.0,
    "convergence": true,
    "max_iterations": 100,
    "has_multiple_backwater": true
  }
}

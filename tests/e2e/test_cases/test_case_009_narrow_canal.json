{
  "version": "2.0.0",
  "name": "narrow_canal_flow",
  "description": "窄渠道流动 - 小宽度高水深",
  "type": "narrow_canal",
  "canal": {
    "length": 6000.0,
    "width": 3.0,
    "slope": 0.002,
    "roughness": 0.025,
    "nx": 300
  },
  "flow": {
    "flow_rate": 20.0,
    "type": "steady"
  },
  "structures": [],
  "solver": {
    "type": "hydrostatic",
    "max_iter": 100,
    "convergence_tol": 0.1
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "formats": ["json", "csv"]
  },
  "expected_results": {
    "flow_rate_error": 0.01,
    "convergence": true,
    "max_iterations": 10
  }
}

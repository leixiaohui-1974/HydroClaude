{
  "version": "2.0.0",
  "name": "broad_crested_weir",
  "description": "宽顶堰 - 堰流控制",
  "type": "weir",
  "canal": {
    "length": 10000.0,
    "width": 10.0,
    "slope": 0.001,
    "roughness": 0.025,
    "nx": 500
  },
  "flow": {
    "flow_rate": 50.0,
    "type": "steady"
  },
  "structures": [
    {
      "type": "broad_crested_weir",
      "position": 5000.0,
      "width": 10.0,
      "crest_height": 0.5,
      "discharge_coefficient": 1.7
    }
  ],
  "solver": {
    "type": "hydrostatic",
    "max_iter": 100,
    "convergence_tol": 0.1
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "formats": ["json", "csv"]
  },
  "expected_results": {
    "flow_rate_error": 1.0,
    "convergence": true,
    "max_iterations": 50
  }
}

        print(f"    出流总计: {Q_out_total:.3f} m³/s")

        junction_error = abs(Q_in_total - Q_out_total) / max(Q_in_total, 1e-6) * 100
        print(f"    误差: {junction_error:.4f}%")

        junction_ok = junction_error < 1.0
        print(f"    {' 通过' if junction_ok else ' 失败'} (标准: < 1%)")

        # 2. 全局质量守恒

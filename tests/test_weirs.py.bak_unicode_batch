"""
堰类组件单元测试

测试所有堰类组件的功能：
- BroadCrestedWeir (宽顶堰)
- SharpCrestedWeir (薄壁堰)
- SideWeir (侧堰)

验证：
1. 流量计算正确性
2. 解析导数精度
3. 边界条件处理
4. 流态判别

作者: Claude
日期: 2025-10-22
"""

import sys
import os
import numpy as np

# 添加项目根目录到路径
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from physics.weirs import BroadCrestedWeir, SharpCrestedWeir, SideWeir


class TestBroadCrestedWeir:
    """宽顶堰测试类"""

    def setup_method(self):
        """测试前准备"""
        self.weir = BroadCrestedWeir(
            position=500.0,
            width=10.0,
            crest_elevation=2.0,
            discharge_coefficient=0.385
        )

    def test_no_flow_condition(self):
        """测试无流量条件（水位低于堰顶）"""
        Q, flow_type = self.weir.calculate_discharge(1.8, 1.5)
        assert Q == 0.0
        assert flow_type == 'no_flow'
        print(" 宽顶堰：无流量条件测试通过")

    def test_free_flow(self):
        """测试自由流"""
        Q, flow_type = self.weir.calculate_discharge(2.5, 1.5)
        assert Q > 0
        assert flow_type == 'free'
        print(f" 宽顶堰：自由流测试通过 (Q={Q:.3f} m³/s)")

    def test_submerged_flow(self):
        """测试淹没流"""
        Q, flow_type = self.weir.calculate_discharge(2.8, 2.7)
        assert Q > 0
        assert flow_type == 'submerged'
        print(f" 宽顶堰：淹没流测试通过 (Q={Q:.3f} m³/s)")

    def test_derivative_accuracy(self):
        """测试导数精度"""
        h_up, h_down = 3.0, 2.0
        Q0, _ = self.weir.calculate_discharge(h_up, h_down)
        dQ_dh_up_analytical, _ = self.weir.calculate_discharge_derivatives(h_up, h_down)

        # 数值导数
        eps = 1e-6
        Q_up, _ = self.weir.calculate_discharge(h_up + eps, h_down)
        dQ_dh_up_numerical = (Q_up - Q0) / eps

        # 相对误差应小于0.01%
        rel_error = abs(dQ_dh_up_analytical - dQ_dh_up_numerical) / abs(dQ_dh_up_numerical)
        assert rel_error < 1e-4
        print(f" 宽顶堰：导数精度测试通过 (相对误差={rel_error*100:.6f}%)")


class TestSharpCrestedWeir:
    """薄壁堰测试类"""

    def setup_method(self):
        """测试前准备"""
        self.weir_rect = SharpCrestedWeir(
            position=500.0,
            width=2.0,
            crest_elevation=1.0,
            weir_type='rectangular',
            discharge_coefficient=0.62
        )

        self.weir_tri = SharpCrestedWeir(
            position=500.0,
            width=0.0,
            crest_elevation=1.0,
            weir_type='triangular',
            notch_angle=90.0,
            discharge_coefficient=0.58
        )

    def test_rectangular_weir(self):
        """测试矩形薄壁堰"""
        Q, flow_type = self.weir_rect.calculate_discharge(1.5, 0.5)
        assert Q > 0
        assert flow_type == 'free'
        print(f" 矩形薄壁堰：流量测试通过 (Q={Q:.4f} m³/s)")

    def test_triangular_weir(self):
        """测试三角堰"""
        Q, flow_type = self.weir_tri.calculate_discharge(1.5, 0.5)
        assert Q > 0
        assert flow_type == 'free'
        print(f" 三角薄壁堰：流量测试通过 (Q={Q:.4f} m³/s)")

    def test_low_flow_sensitivity(self):
        """测试三角堰对小流量的敏感性"""
        # 小水头下，三角堰流量应明显小于矩形堰
        h_up = 1.1
        h_down = 0.5
        Q_rect, _ = self.weir_rect.calculate_discharge(h_up, h_down)
        Q_tri, _ = self.weir_tri.calculate_discharge(h_up, h_down)

        # 三角堰流量应远小于矩形堰
        assert Q_tri < Q_rect * 0.2
        print(f" 薄壁堰：低流量敏感性测试通过 (Q_tri/Q_rect={Q_tri/Q_rect:.3f})")

    def test_derivative_accuracy(self):
        """测试导数精度"""
        h_up, h_down = 1.5, 0.5
        Q0, _ = self.weir_rect.calculate_discharge(h_up, h_down)
        dQ_dh_up_analytical, _ = self.weir_rect.calculate_discharge_derivatives(h_up, h_down)

        eps = 1e-6
        Q_up, _ = self.weir_rect.calculate_discharge(h_up + eps, h_down)
        dQ_dh_up_numerical = (Q_up - Q0) / eps

        rel_error = abs(dQ_dh_up_analytical - dQ_dh_up_numerical) / abs(dQ_dh_up_numerical)
        assert rel_error < 1e-4
        print(f" 薄壁堰：导数精度测试通过 (相对误差={rel_error*100:.6f}%)")


class TestSideWeir:
    """侧堰测试类"""

    def setup_method(self):
        """测试前准备"""
        self.weir = SideWeir(
            position=500.0,
            length=20.0,
            crest_elevation=2.0,
            channel_width=10.0,
            discharge_coefficient=0.4
        )

    def test_no_flow_condition(self):
        """测试无流量条件"""
        Q, flow_type = self.weir.calculate_discharge(2.0, 1.5)
        assert Q == 0.0
        assert flow_type == 'no_flow'
        print(" 侧堰：无流量条件测试通过")

    def test_static_water(self):
        """测试静水溢流（无主渠道流速）"""
        Q, flow_type = self.weir.calculate_discharge(3.0, 1.5, Q_channel=None)
        assert Q > 0
        assert flow_type == 'normal_flow'
        print(f" 侧堰：静水溢流测试通过 (Q={Q:.3f} m³/s)")

    def test_froude_correction(self):
        """测试弗劳德数修正"""
        h = 3.0

        # 低流速（Fr小）
        Q_low, _ = self.weir.calculate_discharge(h, 1.5, Q_channel=20.0)

        # 高流速（Fr大）
        Q_high, _ = self.weir.calculate_discharge(h, 1.5, Q_channel=150.0)

        # 高流速时侧向溢流应明显减小
        assert Q_high < Q_low * 0.8
        print(f" 侧堰：弗劳德数修正测试通过 (高速/低速={Q_high/Q_low:.3f})")

    def test_derivative_accuracy(self):
        """测试导数精度（简化解析导数）"""
        h_up, h_down = 3.0, 1.5
        Q_channel = 50.0

        Q0, _ = self.weir.calculate_discharge(h_up, h_down, Q_channel=Q_channel)
        dQ_dh_up_analytical, _ = self.weir.calculate_discharge_derivatives(h_up, h_down, Q_channel=Q_channel)

        eps = 1e-6
        Q_up, _ = self.weir.calculate_discharge(h_up + eps, h_down, Q_channel=Q_channel)
        dQ_dh_up_numerical = (Q_up - Q0) / eps

        # 由于简化了φ的依赖性，允许较大误差（10%以内）
        rel_error = abs(dQ_dh_up_analytical - dQ_dh_up_numerical) / abs(dQ_dh_up_numerical)
        assert rel_error < 0.1
        print(f" 侧堰：导数精度测试通过 (相对误差={rel_error*100:.2f}%)")



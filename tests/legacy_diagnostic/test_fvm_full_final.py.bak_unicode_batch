def run_fdm_for_initial_guess(verbose=False):
    """
    运行FDM求解，获得初值

    Returns:
        dict: 包含x, h, Q的FDM解
    """
    if verbose:
        print("=" * 70)
        print("步骤1: 使用FDM求解获得初值")
        print("=" * 70)
        print()

    # 系统配置
    canal_length = 10000.0
    canal_width = 10.0
    n_points = 301
    bed_slope = 0.0005
    manning_n = 0.025
    Q_target = 10.0

    # 三个闸门
    gate1 = SluiceGate(position=2500.0, width=canal_width, opening=4.5, Cd=0.6)
    gate2 = SluiceGate(position=5000.0, width=canal_width, opening=4.0, Cd=0.6)
    gate3 = SluiceGate(position=7500.0, width=canal_width, opening=5.0, Cd=0.6)

    # 创建求解器
    solver = SingleCanalSolver(
        total_length=canal_length,
        structures=[gate1, gate2, gate3],
        nx_total=n_points,
        B=canal_width,
        S0=bed_slope,
        n=manning_n,
        method='preissmann',
        smooth_weight=0.55
    )

    # 初始化并求解
    solver.reset_with_steady_state(Q_target)

    result = solver.solve_steady_state(
        Q_target=Q_target,
        max_iterations=10000,
        convergence_tol=0.001,
        check_interval=500,
        verbose=verbose
    )

    # 获取结果
    profile = solver.get_full_profile()

    if verbose:
        Q_error = np.abs(profile['Q'] - Q_target) / Q_target * 100
        print(f"\nFDM初值:")
        print(f"  最大流量误差: {np.max(Q_error):.4f}%")
        print(f"  水深范围: [{profile['h'].min():.3f}, {profile['h'].max():.3f}] m")
        print(f"  流量范围: [{profile['Q'].min():.3f}, {profile['Q'].max():.3f}] m³/s")
        print()

    return {
        'x': profile['x'],
        'h': profile['h'],
        'Q': profile['Q'],
        'max_error': np.max(Q_error),
        'converged': result['converged']
    }


def run_fvm_full_test(fdm_solution, verbose=True):
    """
    运行完整FVM测试（从FDM初值开始）

    Args:
        fdm_solution: FDM解（用作初值）
        verbose: 是否打印详细信息

    Returns:
        dict: 结果字典
    """
    if verbose:
        print("=" * 70)
        print("步骤2: 完整FVM隐式求解（从FDM初值开始）")
        print("=" * 70)
        print()

    # 系统配置
    canal_length = 10000.0
    canal_width = 10.0
    n_points = 301
    bed_slope = 0.0005
    manning_n = 0.025
    Q_target = 10.0

    # 网格
    x_grid = np.linspace(0, canal_length, n_points)

    # 三个闸门
    gates = [
        (2500.0, 4.5, 0.6),
        (5000.0, 4.0, 0.6),
        (7500.0, 5.0, 0.6)
    ]

    # 创建完整FVM求解器
    solver = FVMSteadyFullSolver(
        x_grid=x_grid,
        B=canal_width,
        S0=bed_slope,
        n=manning_n,
        gates=gates
    )

    # 使用FDM解作为初值（关键！）
    h_init = fdm_solution['h']
    Q_init = fdm_solution['Q']

    # 插值到FVM网格（单元中心）
    from scipy.interpolate import interp1d
    h_interp = interp1d(fdm_solution['x'], h_init, kind='linear', fill_value='extrapolate')
    Q_interp = interp1d(fdm_solution['x'], Q_init, kind='linear', fill_value='extrapolate')

    h_fvm_init = h_interp(solver.x_cell)
    Q_fvm_init = Q_interp(solver.x_cell)

    solver.initialize(h_fvm_init, Q_fvm_init)

    if verbose:
        print(f"从FDM解初始化:")
        print(f"  初始水深范围: [{h_fvm_init.min():.3f}, {h_fvm_init.max():.3f}] m")
        print(f"  初始流量范围: [{Q_fvm_init.min():.3f}, {Q_fvm_init.max():.3f}] m³/s")

    # 求解稳态
    start_time = time.time()
    converged = solver.solve_steady_newton(
        Q_target=Q_target,
        max_iter=50,
        tol=1e-6,
        verbose=verbose
    )
    elapsed_time = time.time() - start_time

    # 获取结果
    results = solver.get_results()
    x = results['x']
    h = results['h']
    Q = results['Q']

    # 计算误差
    Q_error = np.abs(Q - Q_target) / Q_target * 100
    Q_max_error = np.max(Q_error)
    Q_mean_error = np.mean(Q_error)

    # 闸门流量
    gate_flows = []
    for gate_info in solver.gate_interfaces:
        idx = gate_info['index']
        if idx < len(Q):
            # 闸门位于界面，取相邻单元平均
            if idx > 0 and idx < len(Q):
                gate_flows.append(0.5 * (Q[idx-1] + Q[idx]))
            else:
                gate_flows.append(Q[idx])

    gate_errors = [abs(gf - Q_target) / Q_target * 100 for gf in gate_flows]

    if verbose:
        print()
        print("完整FVM结果:")
        print(f"  求解时间: {elapsed_time:.2f}s")
        print(f"  收敛状态: {' 收敛' if converged else ' 未收敛'}")
        print(f"  最大流量误差: {Q_max_error:.4f}%")
        print(f"  平均流量误差: {Q_mean_error:.4f}%")
        print(f"  闸门流量: {[f'{gf:.3f}' for gf in gate_flows]}")
        print(f"  闸门误差: {[f'{e:.4f}%' for e in gate_errors]}")
        print()

    return {
        'name': 'FVM Full Jacobian',
        'x': x,
        'h': h,
        'Q': Q,
        'max_error': Q_max_error,
        'mean_error': Q_mean_error,
        'gate_flows': gate_flows,
        'gate_errors': gate_errors,
        'converged': converged,
        'solve_time': elapsed_time
    }


def plot_final_comparison(result_fdm, result_fvm):
    """
    绘制最终对比图
    """
    fig, axes = plt.subplots(3, 1, figsize=(14, 12))

    Q_target = 10.0

    # 水深对比
    ax = axes[0]
    ax.plot(result_fdm['x'], result_fdm['h'], 'b-', linewidth=2, label='FDM (Baseline)', alpha=0.7)
    ax.plot(result_fvm['x'], result_fvm['h'], 'r--', linewidth=2, label='FVM Full Jacobian', alpha=0.7)
    ax.axvline(2500, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(5000, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(7500, color='gray', linestyle=':', alpha=0.5, label='Gates')
    ax.set_xlabel('x [m]', fontsize=12)
    ax.set_ylabel('h [m]', fontsize=12)
    ax.set_title('Water Depth Profile', fontsize=14, fontweight='bold')
    ax.legend(fontsize=11)
    ax.grid(True, alpha=0.3)

    # 流量对比
    ax = axes[1]
    ax.plot(result_fdm['x'], result_fdm['Q'], 'b-', linewidth=2, label='FDM (Baseline)', alpha=0.7)
    ax.plot(result_fvm['x'], result_fvm['Q'], 'r--', linewidth=2, label='FVM Full Jacobian', alpha=0.7)
    ax.axhline(Q_target, color='k', linestyle='--', linewidth=1.5, alpha=0.5, label=f'Target Q={Q_target} m³/s')
    ax.axvline(2500, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(5000, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(7500, color='gray', linestyle=':', alpha=0.5)
    ax.set_xlabel('x [m]', fontsize=12)
    ax.set_ylabel('Q [m³/s]', fontsize=12)
    ax.set_title(f'Discharge Profile (FDM: {result_fdm["max_error"]:.4f}%, FVM: {result_fvm["max_error"]:.4f}%)',
                 fontsize=14, fontweight='bold')
    ax.legend(fontsize=11)
    ax.grid(True, alpha=0.3)

    # 流量误差对比
    ax = axes[2]
    Q_error_fdm = np.abs(result_fdm['Q'] - Q_target) / Q_target * 100
    Q_error_fvm = np.abs(result_fvm['Q'] - Q_target) / Q_target * 100
    ax.plot(result_fdm['x'], Q_error_fdm, 'b-', linewidth=2, label='FDM (Baseline)', alpha=0.7)
    ax.plot(result_fvm['x'], Q_error_fvm, 'r--', linewidth=2, label='FVM Full Jacobian', alpha=0.7)
    ax.axhline(0.5, color='g', linestyle='--', linewidth=2, alpha=0.7, label='Target (0.5%)')
    ax.axhline(2.32, color='orange', linestyle=':', linewidth=1.5, alpha=0.7, label='FDM Baseline (2.32%)')
    ax.axvline(2500, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(5000, color='gray', linestyle=':', alpha=0.5)
    ax.axvline(7500, color='gray', linestyle=':', alpha=0.5)
    ax.set_xlabel('x [m]', fontsize=12)
    ax.set_ylabel('Discharge Error [%]', fontsize=12)
    ax.set_title('Discharge Error Comparison', fontsize=14, fontweight='bold')
    ax.legend(fontsize=11)
    ax.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig('fvm_full_final_comparison.png', dpi=150, bbox_inches='tight')
    print(" Saved: fvm_full_final_comparison.png")
    print()


def main():
    """
    主测试函数
    """
    print("\n")
    print("*" * 70)
    print("*" + "  FINAL FVM Full Jacobian Test - Ultimate Precision Attempt  ".center(68) + "*")
    print("*" * 70)
    print("\n")

    # 步骤1: FDM求解获得初值
    fdm_solution = run_fdm_for_initial_guess(verbose=True)

    # 步骤2: 完整FVM求解
    fvm_solution = run_fvm_full_test(fdm_solution, verbose=True)

    # 绘制对比
    plot_final_comparison(fdm_solution, fvm_solution)

    # 生成最终报告
    print("=" * 70)
    print("FINAL RESULTS SUMMARY")
    print("=" * 70)
    print()

    print(f"{'Method':<30} {'Max Error':<15} {'Converged':<12} {'Time':<10}")
    print("-" * 70)
    print(f"{'FDM Baseline':<30} {fdm_solution['max_error']:.4f}%{'':<8} "
          f"{'' if fdm_solution['converged'] else '':<12} {'-':<10}")
    print(f"{'FVM Full Jacobian':<30} {fvm_solution['max_error']:.4f}%{'':<8} "
          f"{'' if fvm_solution['converged'] else '':<12} {fvm_solution['solve_time']:.2f}s")
    print()

    # 评估结果
    target = 0.5
    fdm_baseline = 2.32

    print("Performance Analysis:")
    print(f"  FDM Baseline: {fdm_baseline:.2f}%")
    print(f"  FVM Full Jacobian: {fvm_solution['max_error']:.4f}%")
    print(f"  Target Precision: {target:.2f}%")
    print()

    if fvm_solution['converged']:
        if fvm_solution['max_error'] < target:
            improvement = fdm_baseline / fvm_solution['max_error']
            print(f" SUCCESS! Target precision achieved!")
            print(f"   FVM error ({fvm_solution['max_error']:.4f}%) < Target ({target}%)")
            print(f"   Improvement over FDM: {improvement:.2f}x")
            print(f"   Absolute improvement: {fdm_baseline - fvm_solution['max_error']:.4f}%")
        elif fvm_solution['max_error'] < fdm_baseline:
            improvement = fdm_baseline / fvm_solution['max_error']
            gap = fvm_solution['max_error'] - target
            print(f" EXCELLENT! FVM improved precision significantly!")
            print(f"   Improvement over FDM: {improvement:.2f}x")
            print(f"   Absolute improvement: {fdm_baseline - fvm_solution['max_error']:.4f}%")
            print(f"  Gap to target: {gap:.4f}%")
            if fvm_solution['max_error'] < 1.0:
                print(f"  Very close to target!")
        else:
            print(f" FVM converged, but precision similar to FDM")
            print(f"  FVM: {fvm_solution['max_error']:.4f}% vs FDM: {fdm_baseline}%")
    else:
        print(f" FVM did not converge")
        print(f"  Final error: {fvm_solution['max_error']:.4f}%")

    print()
    print("=" * 70)


if __name__ == "__main__":
    main()

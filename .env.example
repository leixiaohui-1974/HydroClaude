# HydroClaude 环境配置
# 复制此文件为 .env 并修改配置

# 调试模式 (true/false)
DEBUG=true

# 数据库连接
# 开发环境 (SQLite):
DATABASE_URL=sqlite:///./hydroclaude.db
# 生产环境 (PostgreSQL):
# DATABASE_URL=postgresql://hydroclaude:password@localhost:5432/hydroclaude

# JWT密钥 (生产环境务必修改！)
SECRET_KEY=change-this-to-a-random-secret-key

# 服务器端口
PORT=8000

# 文件上传目录
UPLOAD_DIR=./uploads

# 仿真结果存储目录
RESULTS_DIR=./results

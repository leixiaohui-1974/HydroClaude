{
  "name": "洪水演进模板",
  "description": "适用于长河道洪水演进模拟",
  "template_version": "1.0",
  "created_at": "2025-11-11",
  "author": "HydroClaude Team",
  "tags": ["flood", "routing", "long-channel"],
  "validated": true,
  "test_results": {
    "mass_conservation_error": 0.0002,
    "simulation_time": 1.5,
    "stability": "good"
  },
  "config": {
    "width": 50.0,
    "length": 10000.0,
    "n_cells": 500,
    "t_end": 3600.0,
    "cfl": 0.4,
    "slope": 0.0005,
    "manning_n": 0.03,
    "order": 2,
    "use_numba": true,
    "well_balanced": false,
    "initial_conditions": {
      "type": "uniform",
      "h": 3.0,
      "Q": 150.0
    },
    "boundary_conditions": {
      "left": {
        "type": "Q",
        "value": 150.0,
        "time_series": {
          "enabled": false,
          "note": "可启用时间序列实现洪峰过程"
        }
      },
      "right": {
        "type": "h",
        "value": 3.0
      }
    }
  },
  "notes": {
    "use_case": "河道洪水演进、洪峰传播、长距离模拟",
    "stability": "较大网格数和长时间，使用2阶提高精度",
    "performance": "500个网格，1小时物理时间，约1-2秒计算",
    "physics": "考虑摩擦阻力(n=0.03)和缓坡(0.0005)",
    "modifications": "可调整: width(河宽), manning_n(粗糙度), Q(流量)"
  },
  "warnings": [
    "大流量(>300 m³/s)需降低CFL或使用1阶",
    "长时间模拟注意数值耗散",
    "可考虑启用时间序列边界条件"
  ]
}

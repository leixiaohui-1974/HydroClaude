{
  "name": "基础稳态流模板",
  "description": "适用于稳定流量的标准配置，数值稳定性好",
  "template_version": "1.0",
  "created_at": "2025-11-11",
  "author": "HydroClaude Team",
  "tags": ["steady", "stable", "beginner-friendly"],
  "validated": true,
  "test_results": {
    "mass_conservation_error": 0.0,
    "simulation_time": 0.173,
    "max_froude": 0.0971,
    "stability": "excellent"
  },
  "config": {
    "width": 10.0,
    "length": 1000.0,
    "n_cells": 100,
    "t_end": 60.0,
    "cfl": 0.3,
    "slope": 0.001,
    "manning_n": 0.025,
    "order": 1,
    "use_numba": true,
    "well_balanced": false,
    "initial_conditions": {
      "type": "uniform",
      "h": 5.0,
      "Q": 20.0
    },
    "boundary_conditions": {
      "left": {
        "type": "Q",
        "value": 20.0
      },
      "right": {
        "type": "h",
        "value": 5.0
      }
    }
  },
  "notes": {
    "use_case": "适用于明渠稳定流、长时间模拟",
    "stability": "保守的CFL数(0.3)和1阶格式确保稳定",
    "performance": "100个网格，60秒物理时间，约0.2秒计算",
    "modifications": "可安全调整: width, length, manning_n"
  },
  "warnings": [
    "增大流量前请降低CFL数",
    "如需2阶精度，先测试小规模"
  ]
}

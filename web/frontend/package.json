    "@reduxjs/toolkit": "^2.10.1",
    "antd": "^5.11.5",
    "axios": "^1.6.2",
    "plotly.js": "^2.27.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.0",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.2.0",
    "reactflow": "^11.11.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"

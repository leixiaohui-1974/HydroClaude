{
  "name": "hydroclaude-web",
  "version": "1.0.0",
  "description": "HydroClaude Web - Water Hydraulics Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",

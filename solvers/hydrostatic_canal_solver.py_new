    def solve_steady_state(
        self,
        Q_target: float,
        h_downstream: float,
        max_iterations: int = 5000,
        convergence_tol: float = 0.001,
        dt: float = 0.5,
        verbose: bool = True,
        h_upstream_guess: Optional[float] = None
    ) -> dict:
        """
        求解稳态水面线 (对标 HEC-RAS 精度)
        """
        # 初始化流量
        self.hu = np.ones(self.nx) * Q_target / self.B

        # 初始水位猜测
        if h_upstream_guess is None:
            has_structures = len(self.structure_indices) > 0 if self.structure_indices else False
            if has_structures:
                h_upstream_guess = h_downstream * 1.2
            else:
                from utils.canal_utils import compute_steady_uniform_flow
                try:
                    h_uniform = compute_steady_uniform_flow(Q_target, self.B, self.S0_scalar, self.n, self.g)
                    h_upstream_guess = h_uniform
                except:
                    h_upstream_guess = h_downstream

        self.h = np.linspace(h_upstream_guess, h_downstream, self.nx)
        self.h[-1] = h_downstream
        
        state_tol = convergence_tol
        min_iterations = 20
        best_h = self.h.copy()
        
        if verbose:
            print(f"开始稳态计算 (Q={Q_target}, h_down={h_downstream})")

        # 核心重构：引入标准步长法 (Standard Step Method) 结合伪瞬态演化
        for iteration in range(max_iterations):
            h_old = self.h.copy()

            # 1. 伪瞬态演化步 (基于 Preissmann 格式)
            h_new, hu_new = self.step_preissmann(
                dt,
                enforce_bc=True,
                Q_in=Q_target,
                h_out=h_downstream,
                use_pump_mask=has_structures,
            )

            # 2. 能量方程校正步 (Energy Equation Correction - 对标 HEC-RAS)
            # 仅在无结构物区域或迭代后期进行，以确保水位剖面严格遵循能量守恒
            if not has_structures or iteration > 500:
                # 从下游向上游逐段推算能量平衡
                for i in range(self.nx - 2, -1, -1):
                    dx = self.dx_local[i]
                    h_next = h_new[i+1]
                    z_next = self.z[i+1]
                    z_curr = self.z[i]
                    
                    # 下游断面能量 H_next
                    v_next = Q_target / (self.B * h_next)
                    E_next = z_next + h_next + v_next**2 / (2 * self.g)
                    # 严格矩形断面水力半径
                    R_next = (self.B * h_next) / (self.B + 2.0 * h_next)
                    Sf_next = (self.n * Q_target / (self.B * h_next * R_next**(2/3)))**2 / self.g
                    
                    # 迭代求解当前断面水深 h_curr 满足能量方程: H_curr = H_next + Sf_avg * dx
                    h_guess = h_new[i]
                    for _ in range(5):
                        v_guess = Q_target / (self.B * h_guess)
                        R_guess = (self.B * h_guess) / (self.B + 2.0 * h_guess)
                        Sf_guess = (self.n * Q_target / (self.B * h_guess * R_guess**(2/3)))**2 / self.g
                        Sf_avg = 0.5 * (Sf_next + Sf_guess)
                        
                        f = z_curr + h_guess + v_guess**2 / (2 * self.g) - (E_next + Sf_avg * dx)
                        Fr2 = (v_guess**2) / (self.g * h_guess)
                        df = 1.0 - Fr2 + 1.5 * Sf_avg * dx / h_guess
                        
                        h_guess = h_guess - f / df
                        if abs(f) < 1e-8: break
                    
                    # 混合更新：结合能量方程解和数值演化解，增加稳定性
                    alpha = 0.2 if has_structures else 0.9
                    h_new[i] = alpha * h_guess + (1 - alpha) * h_new[i]

            # 3. 状态更新
            self.h = h_new
            self.hu = hu_new
            self.hu[0] = Q_target / self.B # 锁定上游流量

            if self.structure_indices:
                self._apply_internal_bc(t=self.current_time, Q_target=Q_target)

            # 4. 收敛判定
            dh_max = np.max(np.abs(self.h - h_old))
            if iteration > min_iterations and dh_max < state_tol:
                if verbose: print(f"   {iteration}: dh={dh_max:.4e} (Converged to HEC-RAS accuracy)")
                break

            if iteration % 500 == 0 and verbose:
                print(f"   {iteration}: dh={dh_max:.4e}, h_up={self.h[0]:.4f}m")

            if np.isnan(dh_max) or dh_max > 100.0:
                self.h = best_h
                break
            best_h = self.h.copy()

        Q_final = self.get_Q()
        return {
            'converged': dh_max < state_tol,
            'iterations': iteration,
            'h': self.h.copy(),
            'Q': Q_final.copy(),
            'Q_mean': np.mean(Q_final),
            'Q_error_percent': abs(np.mean(Q_final) - Q_target) / Q_target * 100,
            'dh_max': dh_max
        }

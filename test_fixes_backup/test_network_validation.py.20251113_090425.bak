@pytest.mark.p2
def test_visualizer_creation():
    """测试可视化工具创建"""
    network = RiverNetwork("Test")
    visualizer = NetworkVisualizer(network)

    assert visualizer.network is network

    print(" 可视化工具创建测试通过")


@pytest.mark.p3
def test_plot_elevation_profile():
    """测试高程剖面图"""
    network = RiverNetwork("Elevation Test")

    # 创建网络
    network.add_node(Node("N1", "boundary", elevation=100.0))
    network.add_node(Node("N2", "junction", elevation=95.0))
    network.add_node(Node("N3", "boundary", elevation=90.0))

    s1, s2 = create_test_solver(), create_test_solver()

    network.add_reach(Reach("R1", "N1", "N2", s1))
    network.add_reach(Reach("R2", "N2", "N3", s2))

    visualizer = NetworkVisualizer(network)

    try:
        fig = visualizer.plot_elevation_profile()
        assert fig is not None
        print(" 高程剖面图测试通过")
    except Exception as e:
        print(f"️  高程剖面图测试跳过（可能缺少matplotlib）: {e}")


@pytest.mark.p3
def test_plot_flow_distribution():
    """测试流量分布图"""
    network = RiverNetwork("Flow Test")

    # 创建网络
    network.add_node(Node("N1", "boundary", elevation=100.0))
    network.add_node(Node("N2", "boundary", elevation=95.0))

    solver = create_test_solver(Q_init=30.0)
    network.add_reach(Reach("R1", "N1", "N2", solver))

    visualizer = NetworkVisualizer(network)

    try:
        fig = visualizer.plot_flow_distribution()
        assert fig is not None
        print(" 流量分布图测试通过")
    except Exception as e:
        print(f"️  流量分布图测试跳过（可能缺少matplotlib）: {e}")


# ============================================================================
# Convenience Functions Tests
# ============================================================================

@pytest.mark.p2
def test_validate_network_function():
    """测试便捷验证函数"""
    network = RiverNetwork("Convenience Test")

    # 创建简单网络
    network.add_node(Node("N1", "boundary", elevation=100.0))
    network.add_node(Node("N2", "boundary", elevation=95.0))

    solver = create_test_solver()
    network.add_reach(Reach("R1", "N1", "N2", solver))

    # 使用便捷函数
    is_valid, score = validate_network(network, verbose=False)

    assert isinstance(is_valid, bool)
    assert isinstance(score, float)
    assert 0 <= score <= 100

    print(" 便捷验证函数测试通过")



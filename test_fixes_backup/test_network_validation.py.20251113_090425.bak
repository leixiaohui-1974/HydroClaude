"""
网络验证工具测试

测试network.validation模块的功能：
1. NetworkValidator - 拓扑验证
2. NetworkVisualizer - 可视化
3. 便捷函数

Stage 3 - Task 3.1.3 测试

作者: HydroClaude Team
日期: 2025-10-29
"""

import pytest
import numpy as np
import sys
import os

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))

from network.topology import Node, Reach, RiverNetwork
from network.nodes import create_inflow_boundary, create_outflow_boundary
from network.validation import NetworkValidator, NetworkVisualizer, validate_network
from solvers.godunov_fvm_solver import GodunvFVMSolver


# Helper function to create test solver
def create_test_solver(length=100.0, width=10.0, h_init=2.0, Q_init=20.0):
    """创建测试求解器"""
    n_cells = int(length / 10)
    solver = GodunvFVMSolver(
        width=width,
        length=length,
        n_cells=n_cells,
        manning_n=0.025,
        slope=0.001
    )

    h = np.ones(n_cells) * h_init
    Q = np.ones(n_cells) * Q_init

    solver.initialize(
        h, Q,
        {'type': 'Q', 'value': Q_init},
        {'type': 'h', 'value': h_init}
    )

    return solver


# ============================================================================
# NetworkValidator Tests
# ============================================================================

@pytest.mark.p1
def test_validator_creation():
    """测试验证器创建"""
    network = RiverNetwork("Test")
    validator = NetworkValidator(network)

    assert validator.network is network
    assert len(validator.errors) == 0
    assert len(validator.warnings) == 0
    assert len(validator.info) == 0

    print(" 验证器创建测试通过")


@pytest.mark.p1
def test_validate_empty_network():
    """测试空网络验证"""
    network = RiverNetwork("Empty")
    validator = NetworkValidator(network)

    is_valid, score = validator.validate_all(verbose=False)

    assert not is_valid  # 空网络应该不通过
    assert len(validator.errors) > 0
    assert score < 100

    print(" 空网络验证测试通过")


@pytest.mark.p2
def test_validate_simple_network():
    """测试简单网络验证"""
    network = RiverNetwork("Simple")

    # 添加节点
    n1 = create_inflow_boundary("IN", Q=50.0, elevation=100.0)
    n2 = Node("MID", "junction", elevation=95.0)
    n3 = create_outflow_boundary("OUT", h=2.0, elevation=90.0)

    network.add_node(n1)
    network.add_node(n2)
    network.add_node(n3)

    # 添加河段
    solver1 = create_test_solver(length=500.0)
    solver2 = create_test_solver(length=500.0)

    network.add_reach(Reach("R1", "IN", "MID", solver1))
    network.add_reach(Reach("R2", "MID", "OUT", solver2))

    # 验证
    validator = NetworkValidator(network)
    is_valid, score = validator.validate_all(verbose=False)

    assert is_valid  # 应该通过验证
    assert score >= 80  # 健康评分应该不错
    assert len(validator.errors) == 0

    print(" 简单网络验证测试通过")


@pytest.mark.p2
def test_detect_elevation_inconsistency():
    """测试检测高程不一致"""
    network = RiverNetwork("Elevation Problem")

    # 创建高程不一致的网络（上游低于下游）
    n1 = Node("N1", "boundary", elevation=90.0)  # 上游 90m
    n2 = Node("N2", "boundary", elevation=100.0)  # 下游 100m（错误！）

    network.add_node(n1)
    network.add_node(n2)

    solver = create_test_solver()
    network.add_reach(Reach("R1", "N1", "N2", solver))

    # 验证
    validator = NetworkValidator(network)
    is_valid, score = validator.validate_all(verbose=False)

    assert not is_valid  # 不应通过
    assert len(validator.errors) > 0
    assert any("elevation" in str(e).lower() for e in validator.errors)

    print(" 高程不一致检测测试通过")


@pytest.mark.p2
def test_detect_isolated_node():
    """测试检测孤立节点"""
    network = RiverNetwork("Isolated")

    # 添加孤立节点
    network.add_node(Node("Isolated", "junction", elevation=100.0))
    network.add_node(Node("N1", "boundary", elevation=100.0))
    network.add_node(Node("N2", "boundary", elevation=95.0))

    # 只连接N1和N2，Isolated节点孤立
    solver = create_test_solver()
    network.add_reach(Reach("R1", "N1", "N2", solver))

    validator = NetworkValidator(network)
    is_valid, score = validator.validate_all(verbose=False)

    assert not is_valid
    assert any("isolated" in str(e).lower() for e in validator.errors)

    print(" 孤立节点检测测试通过")


@pytest.mark.p2
def test_detect_cycle():
    """测试检测环路"""
    network = RiverNetwork("Cycle")

    # 创建环路
    network.add_node(Node("N1", "junction"))
    network.add_node(Node("N2", "junction"))
    network.add_node(Node("N3", "junction"))

    s1, s2, s3 = (create_test_solver() for _ in range(3))

    network.add_reach(Reach("R1", "N1", "N2", s1))
    network.add_reach(Reach("R2", "N2", "N3", s2))
    network.add_reach(Reach("R3", "N3", "N1", s3))  # 形成环路

    validator = NetworkValidator(network)
    is_valid, score = validator.validate_all(verbose=False)

    assert not is_valid
    assert any("cycle" in str(e).lower() for e in validator.errors)

    print(" 环路检测测试通过")


@pytest.mark.p3
def test_health_score_calculation():
    """测试健康评分计算"""
    network = RiverNetwork("Score Test")

    # 创建有警告的网络
    n1 = Node("N1", "boundary", elevation=100.0)
    n2 = Node("N2", "boundary", elevation=100.0)  # 零坡度（警告）

    network.add_node(n1)
    network.add_node(n2)

    solver = create_test_solver()
    network.add_reach(Reach("R1", "N1", "N2", solver))

    validator = NetworkValidator(network)
    is_valid, score = validator.validate_all(verbose=False)

    # 有警告，分数应该降低
    assert score < 100
    assert score > 0
    assert len(validator.warnings) > 0

    print(" 健康评分计算测试通过")


@pytest.mark.p3
def test_validation_summary():
    """测试验证摘要"""
    network = RiverNetwork("Summary Test")

    validator = NetworkValidator(network)
    validator.validate_all(verbose=False)

    summary = validator.get_validation_summary()

    assert 'errors' in summary
    assert 'warnings' in summary
    assert 'info' in summary
    assert 'health_score' in summary
    assert 'is_valid' in summary

    assert isinstance(summary['errors'], list)
    assert isinstance(summary['health_score'], float)
    assert isinstance(summary['is_valid'], bool)

    print(" 验证摘要测试通过")



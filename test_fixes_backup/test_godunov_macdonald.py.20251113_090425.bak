#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
Godunov-FVM - MacDonald Test Case 1验证

MacDonald Test Case 1:
- 标准激波管问题
- 上游: h=10m, u=0m/s
- 下游: h=5m, u=0m/s  
- 测试激波和稀疏波捕捉能力

参考: MacDonald et al. (1997) "A new approach to Godunov's method"
"""

import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import sys
sys.path.insert(0, '/workspace')

from solvers.godunov_fvm_solver import GodunvFVMSolver


def exact_solution_macdonald(x, t, h_L, u_L, h_R, u_R, x0=500.0, g=9.81):
    """
    MacDonald Test Case 1的近似解析解
    
    由于Saint-Venant方程的复杂性，这里使用简化的特征线解
    """
    # 左右状态
    c_L = np.sqrt(g * h_L)
    c_R = np.sqrt(g * h_R)
    
    # 波速估计
    S_shock = (u_R - u_L) / (h_R - h_L) * (h_L + h_R) / 2.0 + (u_L + u_R) / 2.0
    
    h = np.zeros_like(x)
    u = np.zeros_like(x)
    
    # 激波位置
    x_shock = x0 + S_shock * t
    
    for i, xi in enumerate(x):
        if xi < x_shock:
            h[i] = h_L
            u[i] = u_L
        else:
            h[i] = h_R
            u[i] = u_R
    
    return h, u


print("="*80)
print("Godunov-FVM - MacDonald Test Case 1验证")
print("="*80)

# 配置
width = 10.0
length = 1000.0
n_cells = 200
manning_n = 0.0  # 无摩阻（标准测试）
slope = 0.0      # 水平
x0 = length / 2.0
h_L, h_R = 10.0, 5.0
u_L, u_R = 0.0, 0.0

print(f"\n配置:")
print(f"  长度: {length}m, 单元: {n_cells}, dx={length/n_cells:.2f}m")
print(f"  初始间断位置: x={x0}m")
print(f"  左状态: h={h_L}m, u={u_L}m/s")
print(f"  右状态: h={h_R}m, u={u_R}m/s")
print(f"  无摩阻、水平渠道")

# 测试两种精度
for order in [1, 2]:
    print(f"\n{'='*80}")
    print(f"空间精度: {order}阶")
    print("="*80)
    
    solver = GodunvFVMSolver(
        width=width,
        length=length,
        n_cells=n_cells,
        manning_n=manning_n,
        slope=slope,
        g=9.81,
        cfl=0.5,
        order=order
    )
    
    # 初始条件
    x_centers = solver.x
    h_init = np.where(x_centers < x0, h_L, h_R)
    Q_init = np.where(x_centers < x0, u_L * h_L * width, u_R * h_R * width)
    
    # 边界条件（透射/外推）
    bc_left = {'type': 'h', 'value': h_L}
    bc_right = {'type': 'h', 'value': h_R}
    
    solver.initialize(h_init, Q_init, bc_left, bc_right)
    
    # 时间推进
    t_target = 5.0  # 5秒
    max_steps = 10000
    
    print(f"\n时间推进至 t={t_target}s:")
    
    while solver.t < t_target and solver.step_count < max_steps:
        h, Q = solver.step()
        
        # NaN检测
        if np.any(np.isnan(h)) or np.any(np.isnan(Q)):
            print(f"   步{solver.step_count}出现NaN!")
            break
        
        if solver.step_count % 100 == 0:
            state = solver.get_state()
            print(f"  t={state['t']:5.2f}s, 步{state['step']:4d}, "
                  f"质量误差={state['mass_error']:7.4f}%")
    
    # 结果
    state = solver.get_state()
    t_final = state['t']
    h_num = state['h']
    Q_num = state['Q']
    u_num = Q_num / (h_num * width + 1e-10)
    
    # 近似解析解
    h_exact, u_exact = exact_solution_macdonald(
        x_centers, t_final, h_L, u_L, h_R, u_R, x0
    )
    
    # 激波位置分析
    # 数值解激波位置（h梯度最大处）
    dh_dx = np.gradient(h_num, x_centers)
    idx_shock_num = np.argmax(np.abs(dh_dx))
    x_shock_num = x_centers[idx_shock_num]
    
    # 理论激波位置
    S_shock = 0.0  # 初始静止，激波速度≈0
    x_shock_exact = x0 + S_shock * t_final
    
    shock_error_m = abs(x_shock_num - x_shock_exact)
    shock_error_pct = shock_error_m / length * 100.0
    
    # RMSE
    rmse_h = np.sqrt(np.mean((h_num - h_exact)**2))
    rmse_h_pct = rmse_h / h_L * 100.0
    
    # 总变差（TV）- 衡量振荡
    TV = np.sum(np.abs(np.diff(h_num)))
    
    print(f"\n数值结果 (t={t_final:.3f}s, {state['step']}步):")
    print(f"  质量误差: {state['mass_error']:.6f}%")
    print(f"  激波位置误差: {shock_error_m:.2f}m ({shock_error_pct:.2f}%)")
    print(f"  RMSE(h): {rmse_h:.4f}m ({rmse_h_pct:.2f}%)")
    print(f"  总变差(TV): {TV:.2f} (越小越好，无振荡)")
    
    # 成功标准
    checks = [
        ("质量守恒<1%", abs(state['mass_error']) < 1.0),
        ("激波位置<5%", shock_error_pct < 5.0),
        ("RMSE<10%", rmse_h_pct < 10.0),
        ("数值稳定", not np.any(np.isnan(h_num)))
    ]
    
    print(f"\n评估:")
    for name, passed in checks:
        print(f"  {name}: {'' if passed else ''}")
    
    all_pass = all(c[1] for c in checks)
    
    # 可视化
    fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(14, 10))
    
    # 水深对比
    ax1.plot(x_centers, h_exact, 'k-', lw=2, label='Exact (Piecewise)')
    ax1.plot(x_centers, h_num, 'r--', lw=1.5, label=f'Godunov Order {order}')
    ax1.axvline(x0, color='gray', ls=':', alpha=0.5, label='Initial Discontinuity')
    ax1.set_xlabel('x (m)', fontsize=11)
    ax1.set_ylabel('h (m)', fontsize=11)
    ax1.set_title(f'Water Depth (t={t_final:.2f}s)', fontsize=12)
    ax1.legend(fontsize=10)
    ax1.grid(True, alpha=0.3)
    
    # 流速对比
    ax2.plot(x_centers, u_exact, 'k-', lw=2, label='Exact')
    ax2.plot(x_centers, u_num, 'b--', lw=1.5, label=f'Godunov Order {order}')
    ax2.axvline(x0, color='gray', ls=':', alpha=0.5)
    ax2.set_xlabel('x (m)', fontsize=11)
    ax2.set_ylabel('u (m/s)', fontsize=11)
    ax2.set_title('Velocity', fontsize=12)
    ax2.legend(fontsize=10)
    ax2.grid(True, alpha=0.3)
    
    # 水深误差分布
    error_h = np.abs(h_num - h_exact)
    ax3.plot(x_centers, error_h, 'r-', lw=1.5)
    ax3.axvline(x0, color='gray', ls=':', alpha=0.5)
    ax3.set_xlabel('x (m)', fontsize=11)
    ax3.set_ylabel('|Error| (m)', fontsize=11)
    ax3.set_title(f'Depth Error (RMSE={rmse_h:.4f}m)', fontsize=12)
    ax3.grid(True, alpha=0.3)
    
    # Froude数分布
    Fr = u_num / np.sqrt(9.81 * h_num + 1e-10)
    ax4.plot(x_centers, Fr, 'g-', lw=1.5)
    ax4.axhline(1.0, color='r', ls='--', alpha=0.7, label='Critical (Fr=1)')
    ax4.axvline(x0, color='gray', ls=':', alpha=0.5)
    ax4.set_xlabel('x (m)', fontsize=11)
    ax4.set_ylabel('Froude Number', fontsize=11)
    ax4.set_title('Froude Number Distribution', fontsize=12)
    ax4.legend(fontsize=10)
    ax4.grid(True, alpha=0.3)
    
    plt.tight_layout()
    filename = f'/workspace/godunov_macdonald_order{order}.png'
    plt.savefig(filename, dpi=150)
    print(f"\n  图像: {filename}")
    
    print(f"\n{'='*80}")
    if all_pass:
        print(f" MacDonald Test Case 1 (Order {order}) **通过** ")
    else:
        print(f"️ MacDonald Test Case 1 (Order {order}) 部分通过")
    print("="*80)

print("\n\n" + "="*80)
print(" MacDonald Test Case 1验证完成！")
print("="*80)

#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
自动测试所有示例（Examples 1-16）

逐个运行示例，记录结果，生成测试报告
"""

import subprocess
import sys
import time
from pathlib import Path
from dataclasses import dataclass
from typing import List, Optional
import json

@dataclass
class ExampleTestResult:
    """示例测试结果"""
    example_id: str
    name: str
    file_path: str
    success: bool
    execution_time: float
    error_message: Optional[str] = None
    output_files: List[str] = None

    def __post_init__(self):
        if self.output_files is None:
            self.output_files = []

def find_example_files() -> dict:
    """查找Examples 1-16的主要执行文件"""

    examples = {
        # Example 1: Canal flow - 多个子示例
        "example_01": [
            "examples/example_01_canal_flow/code/01_basic.py",
            "examples/example_01_canal_flow/code/02_methods_comparison.py",
            "examples/example_01_canal_flow/code/05_step_response.py",
        ],

        # Example 2: Pump system
        "example_02_pump": [
            "examples/example_02_pump_system/example_02_pump_system_enhanced.py",
        ],

        # Example 2: Spillway cascade
        "example_02_spillway": [
            "examples/example_02_spillway_cascade/example_02_spillway_system.py",
        ],

        # Example 3: Turbine
        "example_03_turbine": [
            "examples/example_03_turbine_demo/example_03_turbine_comparison.py",
        ],

        # Example 3: Complex network
        "example_03_network": [
            "examples/example_03_complex_network/code/example_03_complex_network.py",
        ],

        # Example 4: Hydropower system
        "example_04_hydropower": [
            "examples/example_04_hydropower_system/example_04_hydropower_plant.py",
        ],

        # Example 5: Transient analysis
        "example_05_transient": [
            "examples/example_05_transient_analysis/example_05_load_rejection.py",
        ],

        # Example 6: Complete system
        "example_06_complete": [
            "examples/example_06_complete_hydropower_system/example_06_complete_system.py",
        ],

        # Example 7: Multi-unit AGC
        "example_07_agc": [
            "examples/example_07_multi_unit_agc/example_07_multi_unit_agc.py",
        ],

        # Example 8: Load acceptance
        "example_08_load": [
            "examples/example_08_load_acceptance/example_08_load_acceptance.py",
        ],

        # Example 8: Preissmann vs FVM
        "example_08_preissmann": [
            "examples/example_08_preissmann_vs_fvm/example_08_preissmann_vs_fvm_enhanced.py",
        ],

        # Example 9: Pipe RK4
        "example_09_pipe": [
            "examples/example_09_pipe_rk4/example_09_pipe_rk4_enhanced.py",
        ],

        # Example 10: Series network
        "example_10_series": [
            "examples/example_10_series_network/code/example_10_series_network.py",
        ],

        # Example 11: Tree network
        "example_11_tree": [
            "examples/example_11_tree_network/code/example_11_tree_network.py",
        ],

        # Example 12: Loop network
        "example_12_loop": [
            "examples/example_12_loop_network/code/example_12_loop_network.py",
        ],

        # Example 13: Adaptive timescale
        "example_13_adaptive": [
            "examples/example_13_adaptive_timescale/example_13_adaptive_timescale_enhanced.py",
        ],

        # Example 14: Adaptive MPC
        "example_14_mpc": [
            "examples/example_14_adaptive_mpc/example_14_adaptive_mpc_enhanced.py",
        ],

        # Example 15: RLS identification
        "example_15_rls": [
